---
// /FOTOGRAFIA = PORTFÓLIO DE FOTOS (nov/2026). Chega-se aqui pela câmera do rodapé da home
// ("Quer tirar uma fotografia?"): a página abre saindo do branco do flash (lib/flash.ts).
// Planta: design/wireframe-fotografia.svg. Mesmas camadas da home.
//
// Ordem da página:
//  01 Entrada: o mural inteiro em gravura, tela cheia       foto/Mural
//  02 Rolando 1: o mural encolhe e as fotos ganham cor      (dentro do Mural, tela travada)
//  03 Rolando 2: as fotos se juntam e formam o hexágono     (dentro do Mural, tela travada)
//  04 Ensaios                                               comum/FaixaCurva (formato retrato)
//  05 O olhar                                               comum/Mergulho
//  06 Contato                                               comum/RodapeAzul
import Portfolio from '../layouts/Portfolio.astro';
import Mural from '../components/foto/Mural.astro';
import FaixaCurva from '../components/comum/FaixaCurva.astro';
import Mergulho from '../components/comum/Mergulho.astro';
import RodapeAzul from '../components/comum/RodapeAzul.astro';
import { url } from '../lib/url';
import { site, categorias, projetos } from '../data/site';
import { fotos, fotosDa, selecionadas } from '../lib/fotos';

const fotoDe = (chave: string) => fotos.find((f) => `${f.categoria}/${f.nome}` === chave);
const ensaios = categorias.map((c) => ({ ...c, fotos: fotosDa(c.slug) }));
const totalFotos = ensaios.reduce((s, e) => s + e.fotos.length, 0);

const cartoesEnsaios = ensaios.map((e) => ({
  titulo: e.titulo,
  subtitulo: `${e.fotos.length} photos · ${e.descricao}`,
  href: url(`/${e.slug}`),
  imagem: e.fotos[0]?.src,
}));

const licoes = [
  { titulo: 'Framing', texto: 'Where the eye goes first: what gets big, what breathes, what gets cut at the edge.' },
  { titulo: 'Light', texto: 'Light picks what matters: the face that glows and the background that fades.' },
  { titulo: 'Rhythm', texto: 'In a series, it is the time between one click and the next: nothing arrives all at once.' },
];

const linkEnsaio = `https://wa.me/${site.contato.whatsapp}?text=${encodeURIComponent('Hi! I saw your portfolio and I want to book a photo shoot.')}`;
---

<Portfolio titulo={`${site.nome} · photography`} descricao={`Photography by ${site.nome} in ${site.cidade.split(',')[0]}: ${categorias.map((c) => c.titulo).join(', ')}.`}>
  <!-- 01–03 · ENTRADA: o mural em gravura; rolando, ele encolhe, ganha cor e as fotos formam o hexágono -->
  <Mural fotos={selecionadas(fotos.length)} totalFotos={totalFotos} />

  <!-- 04 · ENSAIOS -->
  <FaixaCurva id="ensaios" rotulo={`Series · ${ensaios.length} places, ${totalFotos} photos`} itens={cartoesEnsaios} formato="retrato" tema="azul" lente="foto" />

  <!-- 05 · O OLHAR -->
  <Mergulho id="olhar" titulo={['The', 'eye']} rotulo="The three questions of a photo" fundo={fotoDe('pedras/09-silhueta-e-nuvem')} foto={fotoDe('jaragua/05-escadaria-a-noite')} lente="foto">
    <div slot="topo" class="painel-linha">
      <h3 class="painel-frase">Every photo goes through the same three questions</h3>
      <span class="rotulo">{ensaios.length} series · {totalFotos} photos</span>
    </div>
    <div class="painel-linha painel-fim">
      <ol class="painel-licoes">
        {licoes.map((l, i) => <li><span class="rotulo">0{i + 1} · {l.titulo}</span><p>{l.texto}</p></li>)}
      </ol>
      <div class="painel-acoes">
        <a href={linkEnsaio} target="_blank" rel="noopener">Book a photo shoot</a>
        <a href={url('/')} data-flash>See the websites</a>
      </div>
    </div>
  </Mergulho>

  <!-- 06 · CONTATO -->
  <RodapeAzul
    slot="rodape"
    foto={fotoDe('pedras/02-barcos-na-hora-dourada')}
    rotulo="Contact"
    titulo="Shall we shoot?"
    texto="Your lifestyle, your nights out, the people you love."
    botoes={[
      { texto: 'Book a photo shoot ↗', href: linkEnsaio, principal: true, fora: true, lente: 'foto' },
      { texto: 'See the websites', href: url('/'), lente: 'codigo' },
    ]}
  />
</Portfolio>
