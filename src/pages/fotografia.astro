---
// /FOTOGRAFIA = PORTFÓLIO DE FOTOS (nov/2026). Chega-se aqui pela câmera do rodapé da home
// ("Quer tirar uma fotografia?"): a página abre saindo do branco do flash (lib/flash.ts).
// Planta: design/wireframe-fotografia.svg. Mesmas camadas da home.
//
// Ordem da página:
//  01 Entrada: o mural inteiro em gravura, tela cheia       foto/Mural
//  02 Rolando 1: o mural encolhe e as fotos ganham cor      (dentro do Mural, tela travada)
//  03 Rolando 2: as fotos se juntam numa BOLA e ela explode (dentro do Mural, tela travada)
//  04 Os lugares: um ensaio por painel, passando de lado    foto/Lugares   (a 1ª versão)
//  05 The eye: as três perguntas, cada uma com uma foto     foto/Licoes    (a 1ª versão)
//  06 Contato                                               comum/RodapeAzul
import Portfolio from '../layouts/Portfolio.astro';
import Mural from '../components/foto/Mural.astro';
import Lugares from '../components/foto/Lugares.astro';
import Licoes from '../components/foto/Licoes.astro';
import RodapeAzul from '../components/comum/RodapeAzul.astro';
import { url } from '../lib/url';
import { site, categorias, projetos } from '../data/site';
import { fotos, fotosDa, selecionadas } from '../lib/fotos';

const fotoDe = (chave: string) => fotos.find((f) => `${f.categoria}/${f.nome}` === chave);
const ensaios = categorias.map((c) => ({ ...c, fotos: fotosDa(c.slug) }));
const totalFotos = ensaios.reduce((s, e) => s + e.fotos.length, 0);

const licoes = [
  { titulo: 'Framing', texto: 'Where the eye goes first: what gets big, what breathes, what gets cut at the edge.', foto: fotoDe('pedras/10-capa-mortal-no-barco') },
  { titulo: 'Light', texto: 'Light picks what matters: the face that glows and the background that fades.', foto: fotoDe('estudio/01-luz-do-estudio') },
  { titulo: 'Rhythm', texto: 'In a series, it is the time between one click and the next: nothing arrives all at once.', foto: fotoDe('pedras/12-wonder-why') },
];

const linkEnsaio = `https://wa.me/${site.contato.whatsapp}?text=${encodeURIComponent('Hi! I saw your portfolio and I want to book a photo shoot.')}`;
---

<Portfolio titulo={`${site.nome} · photography`} descricao={`Photography by ${site.nome} in ${site.cidade.split(',')[0]}: ${categorias.map((c) => c.titulo).join(', ')}.`}>
  <!-- 01–03 · ENTRADA: o mural em gravura; rolando, ele encolhe, ganha cor, as fotos viram uma bola e ela explode -->
  <Mural fotos={selecionadas(fotos.length)} totalFotos={totalFotos} />

  <!-- 04 · OS LUGARES (a bola de fotos acabou de explodir) -->
  <Lugares ensaios={ensaios} totalFotos={totalFotos} />

  <!-- 05 · THE EYE -->
  <Licoes licoes={licoes} />

  <!-- 06 · CONTATO -->
  <RodapeAzul
    slot="rodape"
    foto={fotoDe('pedras/02-barcos-na-hora-dourada')}
    rotulo="Contact"
    titulo="Shall we shoot?"
    texto="Your lifestyle, your nights out, the people you love."
    botoes={[
      { texto: 'Book a photo shoot ↗', href: linkEnsaio, principal: true, fora: true, lente: 'foto' },
      { texto: 'See the websites', href: url('/'), lente: 'codigo' },
    ]}
  />
</Portfolio>
