---
// Uma página para cada categoria de src/data/site.ts (/pedras, /jaragua, /ato...)
import Base from '../layouts/Base.astro';
import Galeria from '../components/Galeria.astro';
import { categorias } from '../data/site';
import { fotosDa } from '../lib/fotos';

export function getStaticPaths() {
  return categorias.map((categoria) => ({
    params: { categoria: categoria.slug },
    props: { categoria },
  }));
}

const { categoria } = Astro.props;
const fotos = fotosDa(categoria.slug);
---

<Base titulo={categoria.titulo} descricao={categoria.descricao}>
  <section class="container titulo-pagina">
    <p class="rotulo">Ensaio · {fotos.length > 0 ? `${fotos.length} fotos` : 'em breve'}</p>
    <h1>{categoria.titulo}</h1>
    <p>{categoria.descricao}</p>
  </section>

  <section class="container">
    <Galeria fotos={fotos} />
  </section>
</Base>
