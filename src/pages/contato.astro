---
import Base from '../layouts/Base.astro';
import { site, criacaoDeSites } from '../data/site';

const { instagram, whatsapp } = site.contato;
const whats = (texto: string) => `https://wa.me/${whatsapp}?text=${encodeURIComponent(texto)}`;

const canais = [
  { nome: 'Ensaio', valor: 'Agendar pelo WhatsApp', href: whats('Olá! Vi seu portfólio e queria conversar sobre um ensaio.') },
  { nome: 'Site', valor: 'Quero um portfólio', href: whats(criacaoDeSites.mensagemWhatsApp) },
  { nome: 'Instagram', valor: `@${instagram}`, href: `https://instagram.com/${instagram}` },];
---

<Base titulo="Contato" descricao={`Fale com ${site.nome} sobre ensaios e trabalhos.`}>
  <section class="container titulo-pagina">
    <p class="rotulo">Contato</p>
    <h1>Vamos criar algo juntos.</h1>
    <p>
      Ensaios de retrato, trabalhos autorais e parcerias. Também crio sites de portfólio. Respondo mais rápido pelo
      WhatsApp.
    </p>
  </section>

  <section class="container">
    <ul class="canais">
      {
        canais.map((canal) => (
          <li class="revelar">
            <a href={canal.href} target="_blank" rel="noopener">
              <span class="rotulo">{canal.nome}</span>
              <span class="valor">{canal.valor}</span>
              <span class="seta" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .canais {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--linha);
  }

  .canais a {
    display: grid;
    grid-template-columns: 9rem 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1.8rem 0;
    border-bottom: 1px solid var(--linha);
    transition: padding 0.4s, color 0.3s;
  }

  .valor {
    font-family: var(--fonte-titulo);
    font-style: italic;
    font-size: clamp(1.5rem, 4vw, 2.6rem);
    overflow-wrap: anywhere;
  }

  .seta {
    font-size: 1.5rem;
    color: var(--texto-suave);
    transition: transform 0.4s, color 0.3s;
  }

  .canais a {
    background: linear-gradient(90deg, rgb(124 58 237 / 0.12), transparent 60%) no-repeat;
    background-size: 0% 100%;
    transition: padding 0.4s, background-size 0.5s;
  }

  .canais a:hover {
    padding-left: 1rem;
    background-size: 100% 100%;
    box-shadow: inset 2px 0 0 var(--destaque);
  }

  .canais a:hover .valor {
    color: var(--destaque);
  }

  .canais a:hover .seta {
    color: var(--destaque);
    transform: translateX(6px);
  }

  @media (max-width: 600px) {
    .canais a {
      grid-template-columns: 1fr auto;
    }

    .canais .rotulo {
      grid-column: 1 / -1;
    }
  }
</style>
