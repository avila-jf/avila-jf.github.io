---
// Página inicial (o site novo, lançado em 30/10/2026; o antigo fica no histórico do git). Feito por camadas:
//  CAMADA 1 — wireframe: as caixas marcam onde cada coisa vai entrar
//  CAMADA 2 — fundo e barra: branco com luzes suaves que mudam de lente (foto/código), fontes e barra
//  CAMADA 3 — fotos e prints: fotos com as cores delas, prints dos sites, gravura só como cenário
//  CAMADA 4 — 3D: intro com a câmera que fotografa e revela o mural de fotos, notebook que abre nos sites
// O foco é vender sites: eles vêm logo depois da abertura e ganham mais espaço; as fotos
// aparecem como o "olhar" por trás dos sites.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Fundo from '../components/novo/Fundo.astro';
import Barra from '../components/novo/Barra.astro';
import Gravura from '../components/novo/Gravura.astro';
import Cenario from '../components/novo/Cenario.astro';
import Intro from '../components/novo/Intro.astro';
import Mural from '../components/novo/Mural.astro';
import Cortina from '../components/novo/Cortina.astro';
import Sobre from '../components/novo/Sobre.astro';
import { url } from '../lib/url';
import Aparelho from '../components/novo/Aparelho.astro';
import { site, categorias, projetos, destaques, criacaoDeSites, github } from '../data/site';
import { fotos, fotosDa, fotosEmDestaque, selecionadas } from '../lib/fotos';
import '../styles/novo.css';

const ensaios = categorias.map((c) => ({ ...c, foto: fotosDa(c.slug)[0], total: fotosDa(c.slug).length }));
const totalFotos = ensaios.reduce((s, e) => s + e.total, 0);
const sites = projetos.filter((p) => p.destaque);
const outros = projetos.filter((p) => !p.destaque);

// Prints dos sites (src/assets/projetos/<imagem>.jpg)
const prints = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projetos/*.{jpg,png,webp}', { eager: true });
const printDe = (nome?: string) =>
  nome ? Object.entries(prints).find(([caminho]) => caminho.includes(`/${nome}.`))?.[1].default : undefined;

const sitesComPrint = sites.map((p) => ({ ...p, print: printDe(p.imagem) }));

// Foto do display da câmera da intro: a 2ª dos destaques
const fotosDestaque = fotosEmDestaque(destaques);
const fotoCamera = fotosDestaque[1] ?? fotosDestaque[0];

// 02 · as três perguntas de uma foto, e como cada uma vira código. Troque a foto pela chave
// 'categoria/nome-do-arquivo'.
const fotoDe = (chave: string) => fotos.find((f) => `${f.categoria}/${f.nome}` === chave) ?? fotosDestaque[0];
const licoes = [
  {
    titulo: 'Enquadramento',
    texto: 'Na foto, é onde o olho entra primeiro. No site, é o grid: o que fica grande, o que respira, o que corta a borda.',
    foto: fotoDe('pedras/10-capa-mortal-no-barco'),
    codigo: '.capa {\n  display: grid;\n  grid-template-columns: 1fr 1.618fr;\n  aspect-ratio: 4 / 5;\n}',
  },
  {
    titulo: 'Luz',
    texto: 'Na foto, a luz escolhe o que importa. No site, é o contraste: o botão que acende e o fundo que se apaga.',
    foto: fotoDe('estudio/01-luz-do-estudio'),
    codigo: '.botao {\n  background: var(--azul);\n  box-shadow: 0 20px 50px -30px\n    var(--azul);\n}',
  },
  {
    titulo: 'Ritmo',
    texto: 'Numa série, é o tempo entre um clique e outro. No site, é espaço e movimento: nada chega tudo de uma vez.',
    foto: fotoDe('pedras/12-wonder-why'),
    codigo: '.secao > * {\n  transition: transform .8s\n    cubic-bezier(.2, .7, .2, 1);\n  transition-delay: calc(var(--i) * 80ms);\n}',
  },
];

// Paisagem do cenário em gravura (no contato). Troque o nome para usar outra foto.
const fotoCenario = fotos.find((f) => f.alt === 'barcos na hora dourada') ?? fotos[0];

const linkSite = `https://wa.me/${site.contato.whatsapp}?text=${encodeURIComponent(criacaoDeSites.mensagemWhatsApp)}`;
const linkEnsaio = `https://wa.me/${site.contato.whatsapp}?text=${encodeURIComponent('Olá! Vi seu portfólio e quero marcar um ensaio.')}`;
const dominio = (link?: string) => link?.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`Francis Avila: eu crio sites com olhar de fotógrafo. Sites para clientes e fotografia em `+site.cidade.split(',')[0]+`.`} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta name="theme-color" content="#f7f5f0" />
    <title>{site.nome} · sites com olhar de fotógrafo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <script is:inline>
      // Liga a intro (câmera que fotografa e revela o mural) antes da primeira pintura. Não toca com
      // "reduzir movimento" nem quando a página abre direto num #link.
      if (!location.hash && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        history.scrollRestoration = 'manual';
        document.documentElement.classList.add('intro-on');
      }
    </script>
  </head>
  <body id="topo">
    <Fundo />
    <Cortina />
    <Sobre />
    <Barra />
    <Gravura />
    <Intro
      nome={site.nome}
      foto={fotoCamera}
      info={{
        nome: site.nome,
        cidade: site.cidade.split(',')[0],
        ensaios: ensaios.map((e) => ({ titulo: e.titulo, total: e.total })),
        totalFotos,
        sitesNoAr: sites.length,
      }}
    />

    <main>
      <!-- 00 · ABERTURA: a câmera da intro dispara e revela o mural de fotos -->
      <Mural fotos={selecionadas(fotos.length)} totalFotos={totalFotos} sitesNoAr={sites.length} projetos={projetos.length} />

      <!-- 01 · SITES (o foco) -->
      <section class="ato" id="sites" data-lente="codigo" data-tema="claro">
        <p class="ato-id rotulo">01 · Sites no ar</p>
        <Aparelho sites={sitesComPrint} />
      </section>

      <!-- 02 · O OLHAR POR TRÁS DO CÓDIGO: a tela trava e as três lições passam de lado -->
      <section class="ato horizontal" data-lente="ambos" data-tema="tinta">
        <div class="h-palco">
          <p class="ato-id rotulo">02 · O olhar por trás do código</p>
          <div class="h-trilho">
            <article class="olhar-abre">
              <h2 class="titulo-cartaz">O olhar<br />por trás<br />do código</h2>
              <p class="voz-foto">Todo site que eu faço passa pelas mesmas três perguntas de uma foto.</p>
              <span class="rotulo">role para o lado →</span>
            </article>
            {
              licoes.map((l, i) => (
                <article class="olhar-licao" data-lente-hover="foto">
                  {l.foto && (
                    <figure class="foto olhar-foto">
                      <Image src={l.foto.src} alt={l.foto.alt} widths={[480, 800, 1200]} sizes="(max-width: 760px) 80vw, 32vw" format="webp" />
                      <figcaption class="legenda">{l.foto.alt}</figcaption>
                    </figure>
                  )}
                  <div class="olhar-texto">
                    <span class="rotulo">0{i + 1} / 0{licoes.length}</span>
                    <b class="titulo-cartaz">{l.titulo}</b>
                    <p>{l.texto}</p>
                    <pre class="olhar-codigo voz-codigo"><code>{l.codigo}</code></pre>
                  </div>
                </article>
              ))
            }
          </div>
          <div class="h-progresso" aria-hidden="true"><i></i></div>
        </div>
      </section>

      <!-- 03 · ENSAIOS: um ensaio por tela, passando de lado com a rolagem -->
      <section class="ato horizontal" id="ensaios" data-lente="foto" data-tema="azul">
        <div class="h-palco">
          <p class="ato-id rotulo">03 · Ensaios · {ensaios.length} lugares, {totalFotos} fotos</p>
          <div class="h-trilho">
            {
              ensaios.map((e, i) => (
                <a class="painel foto" href={url(`/${e.slug}`)}>
                  {e.foto && (
                    <Image src={e.foto.src} alt={e.foto.alt} widths={[800, 1400, 2000]} sizes="(max-width: 760px) 90vw, 70vw" format="webp" />
                  )}
                  <span class="painel-texto">
                    <span class="rotulo">0{i + 1} · {e.total > 0 ? `${e.total} fotos` : 'em breve'}</span>
                    <strong class="titulo-cartaz">{e.titulo}</strong>
                    <span class="painel-descricao">{e.descricao}</span>
                  </span>
                </a>
              ))
            }
          </div>
          <div class="h-progresso" aria-hidden="true"><i></i></div>
        </div>
      </section>

      <!-- 04 · OUTROS PROJETOS (só código, lista enxuta) -->
      <section class="ato" data-lente="codigo" data-tema="claro">
        <p class="ato-id rotulo">04 · Outros projetos</p>
        <ul class="outros">
          {
            outros.map((p) => (
              <li>
                <a href={p.site ?? p.codigo} target="_blank" rel="noopener">
                  <b class="titulo-cartaz">{p.nome}</b>
                  <span class="outros-descricao">{p.descricao}</span>
                  <span class="voz-codigo">{p.tecnologias.join(' · ')}</span>
                  <span class="outros-seta" aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- 05 · STACK -->
      <section class="ato" data-lente="codigo" data-tema="tinta">
        <p class="ato-id rotulo">05 · O que eu sei usar</p>
        <div class="caixa stack">
          <b class="voz-codigo">Astro · Three.js · GSAP · Supabase · Vite · Python · Java · MySQL</b>
          <span class="voz-foto">e uma Nikon D3200</span>
        </div>
      </section>
    </main>

    <!-- 06 · CONTATO + RODAPÉ: bloco azul com a paisagem em gravura (pegada "sequel") -->
    <footer data-lente="ambos" data-tema="azul">
      <Cenario foto={fotoCenario} class="contato">
        <div class="contato-topo">
          <p class="rotulo contato-rotulo">06 · Contato</p>
          <h2 class="titulo-cartaz">Bora criar?</h2>
          <p class="contato-texto voz-foto">Um site que parece foto: bem enquadrado, com luz e com ritmo.</p>
          <div class="botoes">
            <a class="botao-principal" href={linkSite} target="_blank" rel="noopener" data-lente-hover="codigo">Quero meu site ↗</a>
            <a class="botao-secundario" href={linkEnsaio} target="_blank" rel="noopener" data-lente-hover="foto">Quero um ensaio</a>
          </div>
        </div>
        <nav class="contato-links rotulo" aria-label="Redes">
          <a href={`https://instagram.com/${site.contato.instagram}`} target="_blank" rel="noopener">Instagram</a>
          <a href={`https://wa.me/${site.contato.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>
          <a href={github} target="_blank" rel="noopener">GitHub</a>
          <span>© {new Date().getFullYear()} {site.nome} · {dominio(Astro.site?.toString())}</span>
        </nav>
      </Cenario>
    </footer>

    <script>
      // 02 e 03: a seção trava na tela e o trilho anda para o lado junto com a rolagem
      // (como os flashes do manoel.ink). A barrinha embaixo mostra quanto falta.
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const celular = matchMedia('(max-width: 760px)').matches;
        document.querySelectorAll<HTMLElement>('.horizontal').forEach((secao, n) => {
          if (celular && secao.id === 'ensaios') return; // no celular os ensaios são uma lista
          const trilho = secao.querySelector<HTMLElement>('.h-trilho')!;
          const barra = secao.querySelector<HTMLElement>('.h-progresso i');
          trilho.style.overflow = 'visible';
          const distancia = () => Math.max(0, trilho.scrollWidth - trilho.clientWidth);
          gsap.to(trilho, {
            x: () => -distancia(),
            ease: 'none',
            scrollTrigger: {
              trigger: secao,
              start: 'top top',
              end: () => `+=${distancia()}`,
              pin: secao.querySelector('.h-palco'),
              scrub: 0.6,
              invalidateOnRefresh: true,
              refreshPriority: -1 - n, // as seções de cima calculam primeiro
              onUpdate: (s) => barra && (barra.style.transform = `scaleX(${s.progress})`),
            },
          });
        });
        ScrollTrigger.sort();
        addEventListener('load', () => ScrollTrigger.refresh());
      }
    </script>
  </body>
</html>

<style is:global>
  main {
    padding: 110px var(--margem) 40px;
  }
  /* Caixas do wireframe (o que ainda vai virar 3D): vidro claro sobre o fundo vivo */
  .caixa {
    display: flex;
    flex-direction: column;
    gap: 6px;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 16px;
    border: 1px solid var(--linha);
    border-radius: 18px;
    background: var(--vidro);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    color: var(--texto-suave);
    font-size: 14px;
    margin: 0;
  }
  .caixa b {
    color: var(--texto);
  }
  .tres-d {
    border-style: dashed;
    border-color: rgb(35 70 168 / 0.35);
    background: rgb(255 255 255 / 0.25);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  .ato {
    margin-bottom: 120px;
  }
  .ato-id {
    margin: 0 0 16px;
    color: var(--texto);
  }
  .ato-id small {
    display: block;
    margin-top: 4px;
    font-size: 11px;
    color: var(--texto-suave);
    text-transform: none;
    letter-spacing: 0;
  }

  /* Fotos: com as cores delas, cantos arredondados e um zoom lento no hover */
  .foto {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: 18px;
    background: var(--fundo-2);
  }
  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .foto:hover img {
    transform: scale(1.04);
  }

  /* Sites: aparelho grande + lista (o maior bloco da página) */
  .sites {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 14px;
  }
  .grande {
    min-height: 70vh;
  }
  .lista {
    display: grid;
    gap: 14px;
  }
  .site {
    align-items: flex-start;
    justify-content: flex-end;
    text-align: left;
    padding: 14px 14px 20px;
    text-decoration: none;
    transition:
      border-color 0.4s,
      box-shadow 0.4s;
  }
  .site:hover {
    border-color: var(--cor);
    box-shadow: 0 20px 50px -30px var(--cor);
  }
  .site b {
    font-size: clamp(30px, 3.4vw, 52px);
  }
  .site b span {
    font-size: 0.5em;
    vertical-align: top;
  }
  .site-print {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 8;
    margin-bottom: 8px;
    overflow: hidden;
    border-radius: 10px;
    box-shadow: 0 0 0 1px var(--linha);
  }
  .site-print img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .site:hover .site-print img {
    transform: scale(1.04);
  }

  /* ---------- 02 e 03: a tela trava e o trilho passa de lado com a rolagem ---------- */
  .horizontal {
    margin-left: calc(var(--margem) * -1);
    margin-right: calc(var(--margem) * -1);
  }
  .h-palco {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
    min-height: 100svh;
    padding: 96px 0 34px;
    overflow: hidden;
  }
  .h-palco > .ato-id {
    margin: 0;
    padding: 0 var(--margem);
  }
  .h-trilho {
    display: flex;
    gap: clamp(14px, 2vw, 28px);
    padding: 0 var(--margem);
    overflow-x: auto; /* sem JS (ou com "reduzir movimento"): arrasta com o dedo */
    scrollbar-width: none;
    will-change: transform;
  }
  .h-trilho::-webkit-scrollbar {
    display: none;
  }
  .h-trilho > * {
    flex: none;
  }
  .h-progresso {
    height: 2px;
    margin: 0 var(--margem);
    background: var(--linha);
  }
  .h-progresso i {
    display: block;
    height: 100%;
    background: var(--texto);
    transform: scaleX(0);
    transform-origin: left;
  }

  /* 02 · abertura e as três lições (foto + texto + o código que ela vira) */
  .olhar-abre {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 22px;
    width: min(78vw, 640px);
  }
  .olhar-abre h2 {
    margin: 0;
    font-size: clamp(56px, min(9vw, 15svh), 150px);
  }
  .olhar-abre p {
    max-width: 30ch;
    margin: 0;
    font-size: clamp(20px, 2vw, 28px);
    line-height: 1.25;
    color: var(--texto-suave);
  }
  .olhar-licao {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(18px, 3vw, 44px);
    width: min(84vw, 1060px);
  }
  .olhar-foto {
    height: min(64svh, 600px);
  }
  .olhar-texto {
    display: grid;
    gap: 14px;
    align-content: center;
  }
  .olhar-texto b {
    font-size: clamp(38px, 4.6vw, 84px); /* "ENQUADRAMENTO" tem que caber na coluna */
  }
  .olhar-texto p {
    max-width: 38ch;
    margin: 0;
    font-size: clamp(16px, 1.3vw, 19px);
    color: var(--texto-suave);
  }
  .olhar-codigo {
    margin: 6px 0 0;
    padding: 16px 18px;
    border: 1px solid var(--linha);
    border-radius: 14px;
    background: var(--vidro);
    color: var(--azul);
    font-size: clamp(11px, 0.95vw, 14px);
    line-height: 1.7;
    white-space: pre;
    overflow-x: auto;
  }
  .legenda {
    position: absolute;
    inset: auto 0 0;
    padding: 40px 16px 12px;
    background: linear-gradient(transparent, rgb(12 21 48 / 0.6));
    color: #fff;
    font-family: var(--fonte-codigo);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* 03 · ensaios: um por tela, título gigante por cima (pegada storm lab) */
  .painel {
    display: block;
    width: min(72vw, 1100px);
    height: min(70svh, 700px);
    color: #fff;
    text-decoration: none;
  }
  .painel img {
    position: absolute;
    inset: 0;
  }
  .painel-texto {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 10px;
    padding: clamp(18px, 3vw, 40px);
    background: linear-gradient(180deg, transparent 40%, rgb(12 21 48 / 0.75));
    pointer-events: none;
  }
  .painel-texto .rotulo {
    color: #fff;
  }
  .painel-texto strong {
    font-size: clamp(44px, 8vw, 140px);
  }
  .painel-descricao {
    max-width: 46ch;
    opacity: 0.85;
  }
  /* Outros projetos: lista de linhas, sem imagem */
  .outros {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--linha);
  }
  .outros a {
    display: grid;
    grid-template-columns: minmax(180px, 1fr) 2fr auto auto;
    align-items: baseline;
    gap: 24px;
    padding: 22px 4px;
    border-bottom: 1px solid var(--linha);
    color: var(--texto-suave);
    text-decoration: none;
    transition:
      padding 0.4s,
      color 0.4s;
  }
  .outros a:hover {
    padding-left: 16px;
    color: var(--texto);
  }
  .outros b {
    font-size: clamp(26px, 3vw, 40px);
    color: var(--texto);
  }
  .outros-seta {
    color: var(--azul);
  }

  .stack {
    min-height: 30vh;
    font-size: clamp(16px, 2vw, 24px);
  }

  /* Contato: bloco azul royal com a paisagem em gravura embaixo */
  .contato {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100vh;
    padding: calc(clamp(60px, 10vw, 140px) + 120px) var(--margem) 28px;
    /* o topo do bloco azul some em degradê na cor de cima: sem linha seca entre as seções */
    -webkit-mask-image: linear-gradient(transparent, #000 220px);
    mask-image: linear-gradient(transparent, #000 220px);
  }
  .contato .cenario-conteudo {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1;
    gap: 48px;
  }
  .contato-rotulo {
    color: var(--creme);
    opacity: 0.8;
  }
  .contato h2 {
    margin: 12px 0 16px;
    font-size: clamp(64px, 14vw, 240px);
  }
  .contato-texto {
    max-width: 30ch;
    margin: 0 0 28px;
    font-size: clamp(22px, 2.4vw, 32px);
    line-height: 1.2;
  }
  .botoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .botao-principal,
  .botao-secundario {
    padding: 14px 26px;
    border-radius: 999px;
