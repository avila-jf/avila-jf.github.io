---
// HOME = PORTFÓLIO DE SITES (nov/2026, na estrutura do portfólio do @echo_builds).
// Planta: design/wireframe-home-sites.svg. Feito por camadas, com aprovação em cada uma:
//  CAMADA 1 — estrutura: as peças na ordem; as caixas tracejadas marcam o que ainda vai entrar
//  CAMADA 2 — fundo e cores · CAMADA 3 — componentes e fontes · CAMADA 4 — assets · CAMADA 5 — revisão
//
// Ordem da página:
//  01 Loader "FRANCIS."            sites/Loader
//  02 Hero "Explore meu portfólio"  sites/Hero (foto recortada na frente do título)
//  03 Sobre mim                     comum/Mergulho (o cartão cresce até virar painel)
//  04 Onde eu já estive             sites/Trajetoria (FaixaLateral + letreiro vazado)
//  05 Sites no ar                   sites/Aparelho (notebook 3D)
//  06 Protótipos e landing pages    comum/FaixaCurva
//  07 Projetos                      sites/HexPilha (o hexágono gira, fecha e vira a pilha)
//  08 Rodapé + câmera               comum/RodapeAzul + sites/CameraFoto → /fotografia
import type { ImageMetadata } from 'astro';
import Portfolio from '../layouts/Portfolio.astro';
import Loader from '../components/sites/Loader.astro';
import Hero from '../components/sites/Hero.astro';
import Mergulho from '../components/comum/Mergulho.astro';
import Trajetoria from '../components/sites/Trajetoria.astro';
import Aparelho from '../components/sites/Aparelho.astro';
import FaixaCurva from '../components/comum/FaixaCurva.astro';
import HexPilha from '../components/sites/HexPilha.astro';
import RodapeAzul from '../components/comum/RodapeAzul.astro';
import CameraFoto from '../components/sites/CameraFoto.astro';
import { url } from '../lib/url';
import { site, categorias, projetos, destaques, criacaoDeSites } from '../data/site';
import { fotos, fotosDa, fotosEmDestaque } from '../lib/fotos';

// Prints dos sites (src/assets/projetos/<imagem>.jpg)
const prints = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projetos/*.{jpg,png,webp}', { eager: true });
const printDe = (nome?: string) =>
  nome ? Object.entries(prints).find(([caminho]) => caminho.includes(`/${nome}.`))?.[1].default : undefined;

const sitesNoAr = projetos.filter((p) => p.destaque).map((p) => ({ ...p, print: printDe(p.imagem) }));
const prototipos = projetos
  .filter((p) => p.grupo === 'prototipo')
  .map((p) => ({ titulo: p.nome, subtitulo: p.tipo, href: p.site ?? p.codigo, fora: true, imagem: printDe(p.imagem) }));
const todos = projetos.map((p) => ({ ...p, link: p.site ?? p.codigo, print: printDe(p.imagem) }));

const fotoDe = (chave: string) => fotos.find((f) => `${f.categoria}/${f.nome}` === chave);
const ensaios = categorias.map((c) => ({ titulo: c.titulo, total: fotosDa(c.slug).length }));
const totalFotos = ensaios.reduce((s, e) => s + e.total, 0);
const fotosDestaque = fotosEmDestaque(destaques);

const linkSite = `https://wa.me/${site.contato.whatsapp}?text=${encodeURIComponent(criacaoDeSites.mensagemWhatsApp)}`;
const linkEnsaio = `https://wa.me/${site.contato.whatsapp}?text=${encodeURIComponent('Olá! Vi seu portfólio e quero marcar um ensaio.')}`;
---

<Portfolio titulo={`${site.nome} · sites com olhar de fotógrafo`} descricao={`${site.nome}: eu crio sites com olhar de fotógrafo, em ${site.cidade.split(',')[0]}.`} loader>
  <Loader slot="antes" />

  <!-- 02 · HERO -->
  <Hero />

  <!-- 03 · SOBRE MIM: a gravura é o "quadro pintado"; no painel, eu de costas olhando as luzes da cidade -->
  <Mergulho id="sobre" titulo={['Sobre', 'mim']} fundo={fotoDe('pedras/09-silhueta-e-nuvem')} foto={fotoDe('pedras/12-wonder-why')} lente="ambos">
    <div class="painel-sobre">
      <p class="rotulo">01 · Sobre mim</p>
      <h2 class="titulo-cartaz">{site.nome}</h2>
      <p class="voz-foto">{site.bio[1]}</p>
      <div class="acoes">
        <a href="#sites">Ver os sites</a>
        <button type="button" data-abrir-sobre>Ler mais</button>
      </div>
    </div>
  </Mergulho>

  <!-- 04 · ONDE EU JÁ ESTIVE -->
  <Trajetoria />

  <!-- 05 · SITES NO AR -->
  <section class="ato" id="sites" data-trava data-lente="codigo" data-tema="claro">
    <p class="ato-id rotulo">03 · Sites no ar</p>
    <Aparelho sites={sitesNoAr} />
  </section>

  <!-- 06 · PROTÓTIPOS E LANDING PAGES -->
  <FaixaCurva id="prototipos" rotulo="04 · Protótipos e landing pages" itens={prototipos} tema="claro" lente="codigo" />

  <!-- 07 · PROJETOS -->
  <section class="ato" id="projetos" data-trava data-lente="codigo" data-tema="claro">
    <p class="ato-id rotulo">05 · Todos os projetos</p>
    <HexPilha itens={todos} />
    <ul class="outros">
      {
        todos.map((p) => (
          <li>
            <a href={p.link} target="_blank" rel="noopener">
              <b class="titulo-cartaz">{p.nome}</b>
              <span class="outros-descricao">{p.descricao}</span>
              <span class="voz-codigo">{p.tecnologias.join(' · ')}</span>
              <span class="outros-seta" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- 08 · RODAPÉ + CÂMERA -->
  <RodapeAzul
    slot="rodape"
    foto={fotoDe('pedras/02-barcos-na-hora-dourada')}
    rotulo="06 · Contato"
    titulo="Bora criar?"
    texto="Um site que parece foto: bem enquadrado, com luz e com ritmo."
    botoes={[
      { texto: 'Quero meu site ↗', href: linkSite, principal: true, fora: true, lente: 'codigo' },
      { texto: 'Quero um ensaio', href: linkEnsaio, fora: true, lente: 'foto' },
    ]}
  >
    <CameraFoto
      slot="lado"
      foto={fotosDestaque[1] ?? fotosDestaque[0]}
      info={{ nome: site.nome, cidade: site.cidade.split(',')[0], ensaios, totalFotos, sitesNoAr: sitesNoAr.length }}
    />
  </RodapeAzul>
</Portfolio>
