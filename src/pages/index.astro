---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Destaques from '../components/Destaques.astro';
import Projetos from '../components/Projetos.astro';
import CameraCena from '../components/CameraCena.astro';
import TerminalCamera from '../components/TerminalCamera.astro';
import { site, categorias, criacaoDeSites, destaques, projetos } from '../data/site';
import { capa, fotosDa, fotosEmDestaque } from '../lib/fotos';
import { url } from '../lib/url';

// Fotos da capa: alternam sozinhas (em gravura). Troque os nomes aqui para usar outras fotos;
// se nenhuma for encontrada, a capa usa a foto principal de site.ts.
const fotosDeCapa = ['barcos na hora dourada']; // a mesma do rodapé (com uma só, a capa fica parada)
const fotoCapa = capa();
const fotosCapa = (() => {
  const todas = categorias.flatMap((c) => fotosDa(c.slug));
  const achadas = fotosDeCapa.flatMap((nome) => todas.filter((f) => f.alt === nome).slice(0, 1));
  return achadas.length > 0 ? achadas : fotoCapa ? [fotoCapa] : [];
})();
const fotosDestaque = fotosEmDestaque(destaques);
const ensaios = categorias.map((c) => ({ ...c, foto: fotosDa(c.slug)[0], total: fotosDa(c.slug).length }));
const totalFotos = ensaios.reduce((soma, e) => soma + e.total, 0);
const linkSite =`https://wa.me/${site.contato.whatsapp}?text=${encodeURIComponent(criacaoDeSites.mensagemWhatsApp)}`;
---

<Base>
  <!-- Capa estilo editorial (inspirada na Superhuman): foto em tela cheia e título fino, com parallax. -->
  <!-- Capa em "gravura": as fotos viram ilustração gravada em azul-marinho e creme (como o rodapé)
       e alternam sozinhas. Para voltar às fotos coloridas, é só tirar a classe "hero-gravura" daqui. -->
  <section class="hero hero-gravura" data-parallax>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <filter id="gravura-capa" color-interpolation-filters="sRGB">
        <feColorMatrix in="SourceGraphic" type="saturate" values="0" result="cinza" />
        <!-- um granulado fino misturado antes de reduzir os tons: as passagens entre um tom e outro
             viram pontinhos, como o pontilhado de uma gravura, em vez de manchas -->
        <feTurbulence type="fractalNoise" baseFrequency="1.3" numOctaves="1" seed="3" />
        <feColorMatrix type="saturate" values="0" result="granulado" />
        <feComposite in="cinza" in2="granulado" operator="arithmetic" k1="0" k2="1" k3="0.22" k4="-0.11" />
        <feComponentTransfer>
          <feFuncR type="discrete" tableValues="0 0.14 0.28 0.44 0.6 0.76 0.9 1" />
          <feFuncG type="discrete" tableValues="0 0.14 0.28 0.44 0.6 0.76 0.9 1" />
          <feFuncB type="discrete" tableValues="0 0.14 0.28 0.44 0.6 0.76 0.9 1" />
        </feComponentTransfer>
        <!-- escuro → azul-marinho do site (#0b1f4f), claro → creme (#efe7d3) -->
        <feColorMatrix
          type="matrix"
          values="0.894 0 0 0 0.043
                  0.784 0 0 0 0.122
                  0.518 0 0 0 0.31
                  0     0 0 1 0"
        />
      </filter>
    </svg>
    <div class="hero-moldura">
      {
        fotosCapa.length > 0 ? (
          fotosCapa.map((foto, i) => (
            <Image
              class:list={['hero-foto', 'hero-slide', { ativa: i === 0 }]}
              src={foto.src}
              alt={foto.alt}
              widths={[800, 1400, 2000, 2400]}
              sizes="100vw"
              format="webp"
              quality={80}
              loading="eager"
              fetchpriority={i === 0 ? 'high' : 'low'}
            />
          ))
        ) : (
          <div class="hero-foto hero-vazio">
            <span>sua foto de capa</span>
          </div>
        )
      }
    </div>

    <div class="hero-texto container">
      <p class="hero-selo entrar"><i aria-hidden="true"></i> Agenda aberta · Fotografia & sites · {site.cidade.split(',')[0]}</p>
      <h1 class="entrar">
        {site.frase.inicio} <em class="marca-texto">{site.frase.destaque}</em>
        <!-- Cópia dourada do título por cima, revelada por uma faixa que passa: a luz do pôr do sol
             correndo pelas letras ("Gradient Sweep", visto no Details Vault) -->
        <span class="titulo-brilho" aria-hidden="true">
          {site.frase.inicio} <em class="marca-texto">{site.frase.destaque}</em>
        </span>
      </h1>
      <p class="hero-assinatura entrar">
        {site.nome} — {categorias.map((c) => c.titulo).join(' · ')} · Sites
      </p>
      <div class="hero-acoes entrar">
        <a class="botao" href="#ensaios">Ver ensaios</a>
        <a class="botao-claro" href={linkSite} target="_blank" rel="noopener">
          Quero meu site
          <span class="botao-claro-icone" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

  </section>

  <!-- Câmera 3D que mira em você, dá zoom, foca e dispara (flash → slider); o terminal narra em código -->
  <CameraCena
    foto={fotosDestaque[0]}
    info={{
      nome: site.nome,
      cidade: site.cidade.split(',')[0],
      ensaios: ensaios.map((e) => ({ titulo: e.titulo, total: e.total })),
      totalFotos: ensaios.reduce((soma, e) => soma + e.total, 0),
      sitesNoAr: projetos.filter((p) => p.destaque).length,
    }}
  >
    <TerminalCamera
      slot="lado"
      nome={site.nome}
      cidade={site.cidade.split(',')[0]}
      ensaios={ensaios}
      sitesNoAr={projetos.filter((p) => p.destaque).length}
    />
    <Destaques fotos={fotosDestaque} />
  </CameraCena>

  <!-- Faixa de texto que corre para o lado com a rolagem (ScrollTrigger) -->
  <div class="faixa-area">
    <div class="faixa" aria-hidden="true">
      <p class="faixa-texto">
        {Array.from({ length: 4 }, () => categorias.map((c) => <span>{c.titulo} <i>✦</i> </span>))}
      </p>
    </div>
  </div>

  <section id="ensaios" class="container secao">
    <p class="rotulo">Ensaios</p>
    <div class="ensaios">
      {
        ensaios.map((ensaio, i) => (
          <a class="ensaio revelar" href={url(`/${ensaio.slug}`)}>
            <div class="ensaio-imagem" data-tilt>
              {ensaio.foto ? (
                <Image src={ensaio.foto.src} alt={ensaio.foto.alt} widths={[480, 800]} sizes="(max-width: 760px) 100vw, 33vw" format="webp" />
              ) : (
                <div class="ensaio-vazio" />
              )}
            </div>
            <span class="ensaio-numero">0{i + 1}</span>
            <h2>
              {ensaio.titulo} <span class="ensaio-seta" aria-hidden="true">→</span>
            </h2>
            <p>{ensaio.total > 0 ? `${ensaio.total} fotos` : 'em breve'}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="container chamada revelar">
    <h2>Vamos <em class="marca-texto">fotografar?</em></h2>
    <p>Ensaios de retrato, trabalhos autorais e parcerias.</p>
    <a class="botao" href={url('/contato')}>Entrar em contato</a>
  </section>

  <!-- Projetos de programação (dados em site.ts → projetos) -->
  <section id="sites" class="container secao-codigo">
    <!-- Abertura que vende (ideias da agência do Gustavo Campelo): selo, frase forte, um botão
         claro de orçamento e três diferenciais. Premium = espaço e hierarquia, não excesso. -->
    <div class="codigo-topo">
      <p class="hero-selo selo-sites"><i aria-hidden="true"></i> Também crio sites</p>
      <h2>Sites que fazem sua marca parecer o que ela <em class="marca-texto">vale.</em></h2>
      <p class="codigo-descricao">{criacaoDeSites.texto}</p>
      <div class="codigo-links">
        <a class="botao-claro" href={linkSite} target="_blank" rel="noopener">
          Solicitar orçamento
          <span class="botao-claro-icone" aria-hidden="true">↗</span>
        </a>
        <a class="link-seta" href={url('/projetos')}>Todos os projetos <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <ul class="diferenciais">
      <li class="revelar">
        <span class="diferencial-num">01</span>
        <h3>Feito do zero</h3>
        <p>Nada de modelo pronto: o visual nasce da sua marca, das suas cores e do seu público.</p>
      </li>
      <li class="revelar">
        <span class="diferencial-num">02</span>
        <h3>Animação na medida</h3>
        <p>Movimento que guia o olhar e valoriza o produto, sem pesar nem distrair.</p>
      </li>
      <li class="revelar">
        <span class="diferencial-num">03</span>
        <h3>Rápido no celular</h3>
        <p>Pensado primeiro para o telefone, carrega rápido e está pronto para o link da bio.</p>
      </li>
    </ul>

    <Projetos />
  </section>

</Base>

<script>
  // Capa: alterna as fotos a cada 7 s (só enquanto a capa está na tela e a aba está aberta)
  const slides = [...document.querySelectorAll<HTMLElement>('.hero-slide')];
  if (slides.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let atual = 0;
    let capaVisivel = true;
    new IntersectionObserver(([e]) => (capaVisivel = e.isIntersecting)).observe(document.querySelector('.hero')!);
    setInterval(() => {
      if (!capaVisivel || document.hidden) return;
      slides[atual].classList.remove('ativa');
      atual = (atual + 1) % slides.length;
      slides[atual].classList.add('ativa');
    }, 7000);
  }

</script>

<style>
  /* ---------- CAPA ---------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    padding-block: 120px clamp(48px, 9vh, 96px);
  }




  /* Foto em tela cheia, como capa de cinema. Um véu da cor do fundo sobe de baixo e vem da
     esquerda para o texto ficar legível, sem mudar a foto. */
  .hero-moldura {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }


  .hero-moldura::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to top, var(--fundo) 0%, rgb(0 0 0 / 0.35) 38%, transparent 70%),
      linear-gradient(to right, rgb(0 0 0 / 0.55) 0%, transparent 55%);
  }

  /* ---------- Fotos da capa alternando: troca em fade, com um zoom bem lento na que está à vista ---------- */
  .hero-slide {
    opacity: 0;
    scale: 1.06;
    transition:
      opacity 1.8s ease,
      scale 9s linear;
  }

  .hero-slide.ativa {
    opacity: 1;
    scale: 1;
  }

  /* ---------- TESTE: capa em gravura azul e creme ---------- */
  .hero-gravura .hero-foto {
    filter: contrast(1.2) url(#gravura-capa);
    object-position: center 68%; /* mostra a cidade e os barcos, como no rodapé, em vez de só céu */
  }

  /* hachuras finas por cima, como os riscos de uma gravura em metal */
  .hero-gravura .hero-moldura::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      repeating-linear-gradient(118deg, rgb(11 31 79 / 0.2) 0 1px, transparent 1px 3.5px),
      repeating-linear-gradient(28deg, rgb(11 31 79 / 0.08) 0 1px, transparent 1px 5px);
    mix-blend-mode: multiply;
  }

  /* véu azul-marinho (em vez de preto) para o texto continuar legível sobre o creme */
  .hero-gravura .hero-moldura::after {
    z-index: 1;
    background:
      linear-gradient(to top, var(--fundo) 0%, rgb(8 20 52 / 0.55) 35%, transparent 70%),
      linear-gradient(to right, rgb(8 20 52 / 0.75) 0%, rgb(8 20 52 / 0.25) 45%, transparent 70%);
  }


  .hero-foto {
    position: absolute;
    inset: -30px; /* sobra nas bordas para a foto poder se mexer */
    width: calc(100% + 60px);
    height: calc(100% + 60px);
    max-width: none; /* a regra geral img{max-width:100%} cortava a sobra da direita */
    object-fit: cover;
    animation: zoom 18s ease-out both;
    translate: calc(var(--px, 0) * -30px) calc(var(--py, 0) * -30px);
    transition: translate 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* ---------- Brilho de pôr do sol passando pelo título ---------- */
  .hero h1 {
    position: relative;
  }

  .titulo-brilho {
    position: absolute;
    inset: 0;
    color: #fff3dc; /* creme da gravura */
    text-shadow:
      0 0 18px rgb(255 236 200 / 0.6),
      0 2px 24px rgb(0 0 0 / 0.35);
    pointer-events: none;
    /* só a faixa diagonal aparece; ela entra pela esquerda e atravessa o título até sair à direita */
    -webkit-mask: linear-gradient(105deg, transparent 40%, #000 48%, #000 52%, transparent 60%) 100% 0 / 300% 100% no-repeat;
    mask: linear-gradient(105deg, transparent 40%, #000 48%, #000 52%, transparent 60%) 100% 0 / 300% 100% no-repeat;
    animation: varrer 2.4s 1.5s cubic-bezier(0.45, 0, 0.2, 1) both;
  }

  /* na cópia, sem marca-texto azul e sem a animação dela */
  .titulo-brilho .marca-texto {
    background: none;
    animation: none;
  }

  .hero h1:hover .titulo-brilho {
    animation: varrer-de-novo 1.6s cubic-bezier(0.45, 0, 0.2, 1) both;
  }

  @keyframes varrer {
    from {
      -webkit-mask-position: 100% 0;
      mask-position: 100% 0;
    }
    to {
      -webkit-mask-position: 0% 0;
      mask-position: 0% 0;
    }
  }

  /* mesma coisa com outro nome, para o hover reiniciar a animação */
  @keyframes varrer-de-novo {
    from {
      -webkit-mask-position: 100% 0;
      mask-position: 100% 0;
    }
    to {
      -webkit-mask-position: 0% 0;
      mask-position: 0% 0;
    }
  }

  /* Selo em pílula no topo do texto (ideia da capa da agência WebHub) */
  .hero-selo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 8px 16px;
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: 99px;
    background: rgb(255 255 255 / 0.07);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(236 233 242 / 0.88);
  }

  .hero-selo i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 0 0 rgb(74 222 128 / 0.7);
    animation: pulso-selo 2s ease-out infinite;
  }

  @keyframes pulso-selo {
    to {
      box-shadow: 0 0 0 9px transparent;
    }
  }

  /* Botão claro com o ícone num círculo (como o "Solicitar orçamento" da WebHub) */
  .botao-claro {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 6px 6px 6px 22px;
    border-radius: 99px;
    background: var(--texto);
    color: var(--fundo);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition:
      background 0.3s,
      translate 0.3s;
  }

  .botao-claro-icone {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--botao);
    color: var(--texto);
    font-size: 1rem;
    letter-spacing: 0;
    transition: rotate 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .botao-claro:hover {
    background: #fff;
  }

  .botao-claro:hover .botao-claro-icone {
    rotate: 45deg;
  }

  .hero-vazio {
    display: grid;
    place-items: center;
    background:
      radial-gradient(ellipse at 60% 35%, #0d1f3b 0%, transparent 60%),
      linear-gradient(160deg, #081021, #03050b);
  }

  .hero-vazio span {
    font-family: var(--fonte-titulo);
    font-style: italic;
    font-size: 1.3rem;
    color: var(--texto-suave);
  }

  .hero-texto {
    position: relative;
    z-index: 2;
    translate: calc(var(--px, 0) * 16px) calc(var(--py, 0) * 12px);
    transition: translate 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* Frase grande e pesada, estilo revista */
  /* Título editorial: fino, grande e em caixa normal ("sussurra em vez de gritar") */
  /* Título em Instrument Serif: a serifa editorial dos portfólios premium da Refero (mesmo desenho
     da PP Editorial New, mas gratuita). "O mundo" em pé numa linha, "pelas minhas lentes." em itálico
     na outra. O resto do site segue na Inter, como nos portfólios de fotografia de referência. */
  .hero h1 {
    margin: 1.1rem 0 1.5rem;
    font-family: 'Instrument Serif', Georgia, serif;
    font-size: clamp(2.8rem, 8.6vw, 9rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.35);
  }

  .hero h1 .marca-texto {
    font-family: inherit;
    font-weight: 400;
    letter-spacing: -0.02em;
    text-transform: none;
    font-size: 1em;
    display: block; /* sempre na linha de baixo... */
    width: fit-content; /* ...e o marca-texto só do tamanho da frase */
    white-space: nowrap;
  }

  /* Marca-texto azul embaixo da frase (ideia do portfólio da Melyssa Griffin) */
  .marca-texto {
    font-style: italic;
    background: linear-gradient(transparent 62%, rgb(var(--brilho) / 0.85) 62%, rgb(var(--brilho) / 0.85) 90%, transparent 90%)
      no-repeat;
    background-size: 100% 100%; /* fora da capa, o Rolagem.astro anima isso ao rolar */
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    padding-inline: 0.05em;
  }

  .hero .marca-texto {
    background-size: 0% 100%;
    animation: marcar 1s 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }

  /* ---------- FAIXA DE TEXTO ---------- */
  .faixa {
    overflow: hidden;
    padding-block: clamp(56px, 10vh, 110px) 0;
  }

  .faixa-texto {
    margin: 0;
    white-space: nowrap;
    font-family: var(--fonte-texto);
    font-weight: 800;
    font-size: clamp(3.5rem, 11vw, 10rem);
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: transparent;
    -webkit-text-stroke: 1px rgb(236 233 242 / 0.25);
  }

  .faixa-texto i {
    font-style: normal;
    font-size: 0.4em;
    vertical-align: middle;
    color: var(--destaque);
    -webkit-text-stroke: 0;
  }

  .hero-assinatura {
    margin: 0 0 2rem;
    font-size: 0.8rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgb(236 233 242 / 0.8);
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.6);
  }

  .hero-acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2rem;
  }

  .link-seta {
    font-size: 0.78rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    transition: color 0.3s;
  }

  .link-seta span {
    display: inline-block;
    transition: translate 0.3s;
  }

  .link-seta:hover {
    color: var(--destaque);
  }

  .link-seta:hover span {
    translate: 6px 0;
  }

  /* Texto da capa entra deslizando, um depois do outro */
  .entrar {
    animation: entrar 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  h1.entrar {
    animation-delay: 0.1s;
  }

  .hero-assinatura.entrar {
    animation-delay: 0.25s;
  }

  .hero-acoes.entrar {
    animation-delay: 0.4s;
  }

  /* ---------- ENSAIOS ---------- */
  .secao {
    padding-top: clamp(88px, 16vh, 180px);
  }

  .secao > .rotulo {
    margin: 0 0 2rem;
  }

  .ensaios {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 2vw, 32px);
  }

  .ensaio-imagem {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--fundo-2);
    margin-bottom: 1.2rem;
  }

  .ensaio-imagem img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.4) brightness(0.85);
    transition: transform 1s cubic-bezier(0.2, 0.6, 0.2, 1), filter 0.8s;
  }

  .ensaio:hover .ensaio-imagem img {
    transform: scale(1.05);
    filter: none;
  }

  .ensaio-vazio {
    height: 100%;
    background: linear-gradient(160deg, #081021, #03050b);
    border: 1px solid var(--linha);
  }

  .ensaio-numero {
    font-size: 0.75rem;
    color: var(--destaque);
    letter-spacing: 0.2em;
  }

  .ensaio h2 {
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-style: italic;
    margin: 0.2rem 0;
    transition: color 0.3s;
  }

  .ensaio:hover h2 {
    color: var(--destaque);
  }

  .ensaio-seta {
    display: inline-block;
    font-family: var(--fonte-texto);
    font-size: 0.5em;
    font-style: normal;
    vertical-align: middle;
    opacity: 0;
    translate: -10px 0;
    transition: opacity 0.3s, translate 0.3s;
  }

  .ensaio:hover .ensaio-seta {
    opacity: 1;
    translate: 0 0;
  }

  .ensaio p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--texto-suave);
  }

  /* ---------- CHAMADA ---------- */
  .chamada {
    padding-top: clamp(96px, 16vh, 180px);
    text-align: center;
  }

  .chamada h2 {
