---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Destaques from '../components/Destaques.astro';
import Projetos from '../components/Projetos.astro';
import CameraCena from '../components/CameraCena.astro';
import { site, categorias, criacaoDeSites, destaques, projetos } from '../data/site';
import { capa, fotosDa, fotosEmDestaque } from '../lib/fotos';
import { url } from '../lib/url';

const fotoCapa = capa();
const fotosDestaque = fotosEmDestaque(destaques);
const ensaios = categorias.map((c) => ({ ...c, foto: fotosDa(c.slug)[0], total: fotosDa(c.slug).length }));
const totalFotos = ensaios.reduce((soma, e) => soma + e.total, 0);
const linkSite = `https://wa.me/${site.contato.whatsapp}?text=${encodeURIComponent(criacaoDeSites.mensagemWhatsApp)}`;
---

<Base>
  <!-- Capa estilo editorial (inspirada na Superhuman): foto em tela cheia, título fino e
       cartões de vidro flutuando por cima. Tudo com parallax. -->
  <section class="hero" data-parallax>
    <div class="hero-moldura">
      {
        fotoCapa ? (
          <Image
            class="hero-foto"
            src={fotoCapa.src}
            alt={fotoCapa.alt}
            widths={[800, 1400, 2000, 2400]}
            sizes="100vw"
            format="webp"
            quality={80}
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <div class="hero-foto hero-vazio">
            <span>sua foto de capa</span>
          </div>
        )
      }
    </div>

    <div class="hero-texto container">
      <p class="rotulo entrar">Fotografia · {site.cidade}</p>
      <h1 class="entrar">
        {site.frase.inicio} <em class="marca-texto">{site.frase.destaque}</em>
      </h1>
      <p class="hero-assinatura entrar">
        {site.nome} — {categorias.map((c) => c.titulo).join(' · ')}
      </p>
      <div class="hero-acoes entrar">
        <a class="botao" href="#ensaios">Ver ensaios</a>
        <a class="link-seta" href={url('/contato')}>Fale comigo <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <!-- Cartões de vidro flutuando sobre a foto -->
    <div class="vidros" aria-hidden="true">
      <div class="vidro vidro-ensaios">
        <p class="vidro-rotulo">Ensaios</p>
        <ul>
          {
            ensaios.map((e) => (
              <li>
                <span>{e.titulo}</span>
                <b>{e.total}</b>
              </li>
            ))
          }
        </ul>
        <p class="vidro-rodape">{totalFotos} fotos · Nikon D3200</p>
      </div>
      <div class="vidro vidro-agenda"><i></i> Agenda aberta · {site.cidade.split(',')[0]}</div>
      <div class="vidro vidro-codigo">
        <span class="vidro-rotulo">Também programo</span>
        <b>{projetos.filter((p) => p.destaque).length} sites no ar</b>
      </div>
    </div>
  </section>

  <!-- Câmera 3D que vira de costas com a rolagem e dá zoom no display até virar o slider (anime.js) -->
  <CameraCena foto={fotosDestaque[0]}>
    <Destaques fotos={fotosDestaque} />
  </CameraCena>

  <!-- Faixa de texto que corre para o lado com a rolagem (ScrollTrigger) -->
  <div class="faixa" aria-hidden="true">
    <p class="faixa-texto">
      {Array.from({ length: 4 }, () => categorias.map((c) => <span>{c.titulo} <i>✦</i> </span>))}
    </p>
  </div>

  <section id="ensaios" class="container secao">
    <p class="rotulo">Ensaios</p>
    <div class="ensaios">
      {
        ensaios.map((ensaio, i) => (
          <a class="ensaio revelar" href={url(`/${ensaio.slug}`)}>
            <div class="ensaio-imagem" data-tilt>
              {ensaio.foto ? (
                <Image src={ensaio.foto.src} alt={ensaio.foto.alt} widths={[480, 800]} sizes="(max-width: 760px) 100vw, 33vw" format="webp" />
              ) : (
                <div class="ensaio-vazio" />
              )}
            </div>
            <span class="ensaio-numero">0{i + 1}</span>
            <h2>
              {ensaio.titulo} <span class="ensaio-seta" aria-hidden="true">→</span>
            </h2>
            <p>{ensaio.total > 0 ? `${ensaio.total} fotos` : 'em breve'}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="container chamada revelar">
    <h2>Vamos <em class="marca-texto">fotografar?</em></h2>
    <p>Ensaios de retrato, trabalhos autorais e parcerias.</p>
    <a class="botao" href={url('/contato')}>Entrar em contato</a>
  </section>

  <!-- Projetos de programação (dados em site.ts → projetos) -->
  <section id="sites" class="container secao-codigo">
    <div class="codigo-topo">
      <div>
        <p class="rotulo">Projetos</p>
        <h2>{criacaoDeSites.titulo}</h2>
        <p class="codigo-descricao">{criacaoDeSites.texto}</p>
      </div>
      <div class="codigo-links">
        <a class="botao" href={linkSite} target="_blank" rel="noopener">Quero meu site</a>
        <a class="link-seta" href={url('/projetos')}>Todos os projetos <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <Projetos />
  </section>

</Base>

<style>
  /* ---------- CAPA ---------- */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    padding-block: 120px clamp(48px, 9vh, 96px);
  }




  /* Foto em tela cheia, como capa de cinema. Um véu da cor do fundo sobe de baixo e vem da
     esquerda para o texto ficar legível, sem mudar a foto. */
  .hero-moldura {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }


  .hero-moldura::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to top, var(--fundo) 0%, rgb(0 0 0 / 0.35) 38%, transparent 70%),
      linear-gradient(to right, rgb(0 0 0 / 0.55) 0%, transparent 55%);
  }


  .hero-foto {
    position: absolute;
    inset: -30px; /* sobra nas bordas para a foto poder se mexer */
    width: calc(100% + 60px);
    height: calc(100% + 60px);
    max-width: none; /* a regra geral img{max-width:100%} cortava a sobra da direita */
    object-fit: cover;
    animation: zoom 18s ease-out both;
    translate: calc(var(--px, 0) * -30px) calc(var(--py, 0) * -30px);
    transition: translate 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .hero-vazio {
    display: grid;
    place-items: center;
    background:
      radial-gradient(ellipse at 60% 35%, #0d1f3b 0%, transparent 60%),
      linear-gradient(160deg, #081021, #03050b);
  }

  .hero-vazio span {
    font-family: var(--fonte-titulo);
    font-style: italic;
    font-size: 1.3rem;
    color: var(--texto-suave);
  }

  .hero-texto {
    position: relative;
    z-index: 2;
    translate: calc(var(--px, 0) * 16px) calc(var(--py, 0) * 12px);
    transition: translate 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* Frase grande e pesada, estilo revista */
  /* Título editorial: fino, grande e em caixa normal ("sussurra em vez de gritar") */
  .hero h1 {
    max-width: 14ch;
    margin: 1rem 0 1.5rem;
    font-family: var(--fonte-texto);
    font-size: clamp(2.8rem, 6.6vw, 6.4rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.045em;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.35);
  }


  .hero h1 .marca-texto {
    font-family: var(--fonte-titulo);
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
    font-size: 1.12em;
    display: inline-block; /* a parte em itálico nunca quebra no meio */
  }

  /* Marca-texto azul embaixo da frase (ideia do portfólio da Melyssa Griffin) */
  .marca-texto {
    font-style: italic;
    background: linear-gradient(transparent 62%, rgb(var(--brilho) / 0.85) 62%, rgb(var(--brilho) / 0.85) 90%, transparent 90%)
      no-repeat;
    background-size: 100% 100%; /* fora da capa, o Rolagem.astro anima isso ao rolar */
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    padding-inline: 0.05em;
  }

  .hero .marca-texto {
    background-size: 0% 100%;
    animation: marcar 1s 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }

  /* ---------- CARTÕES DE VIDRO (inspirado na Superhuman) ----------
     Vidro translúcido com desfoque, borda finíssima e sem sombra pesada. Só usa branco
     transparente por cima da foto, então não mexe nas cores do tema. */
  .vidros {
    position: absolute;
    z-index: 2;
    right: var(--margem);
    bottom: clamp(48px, 9vh, 96px);
    display: grid;
    justify-items: end;
    gap: 14px;
    translate: calc(var(--px, 0) * -22px) calc(var(--py, 0) * -16px);
    transition: translate 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .vidro {
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 16px;
    background: rgb(255 255 255 / 0.07);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    backdrop-filter: blur(18px) saturate(140%);
    color: var(--texto);
    animation: flutuar-vidro 7s ease-in-out infinite alternate;
  }

  .vidro-ensaios {
    width: 260px;
    padding: 18px 20px;
  }

  .vidro-rotulo {
    margin: 0 0 10px;
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.6);
  }

  .vidro ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .vidro li {
    display: flex;
    justify-content: space-between;
    padding: 9px 0;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    font-size: 0.9rem;
  }

  .vidro li b {
    font-weight: 400;
    color: var(--destaque);
  }

  .vidro-rodape {
    margin: 10px 0 0;
    font-size: 0.72rem;
    color: rgb(255 255 255 / 0.55);
  }

  .vidro-agenda {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    border-radius: 99px;
    font-size: 0.78rem;
    animation-delay: -2s;
  }

  .vidro-agenda i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--destaque);
    box-shadow: 0 0 0 0 var(--destaque);
    animation: pulso 2s ease-out infinite;
  }

  .vidro-codigo {
    display: grid;
    gap: 2px;
    padding: 12px 18px;
    animation-delay: -4s;
  }

  .vidro-codigo .vidro-rotulo {
    margin: 0;
  }

  .vidro-codigo b {
    font-family: var(--fonte-titulo);
    font-style: italic;
    font-weight: 400;
    font-size: 1.3rem;
  }

  @keyframes flutuar-vidro {
    to {
      transform: translateY(-8px);
    }
  }

  @keyframes pulso {
    to {
      box-shadow: 0 0 0 10px transparent;
    }
  }

  /* ---------- FAIXA DE TEXTO ---------- */
  .faixa {
    overflow: hidden;
    padding-block: clamp(56px, 10vh, 110px) 0;
  }

  .faixa-texto {
    margin: 0;
    white-space: nowrap;
    font-family: var(--fonte-texto);
    font-weight: 800;
    font-size: clamp(3.5rem, 11vw, 10rem);
    line-height: 1;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    color: transparent;
    -webkit-text-stroke: 1px rgb(236 233 242 / 0.25);
  }

  .faixa-texto i {
    font-style: normal;
    font-size: 0.4em;
    vertical-align: middle;
    color: var(--destaque);
    -webkit-text-stroke: 0;
  }

  .hero-assinatura {
    margin: 0 0 2rem;
    font-size: 0.8rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgb(236 233 242 / 0.8);
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.6);
  }

  .hero-acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2rem;
  }

  .link-seta {
    font-size: 0.78rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    transition: color 0.3s;
  }

  .link-seta span {
    display: inline-block;
    transition: translate 0.3s;
  }

  .link-seta:hover {
    color: var(--destaque);
  }

  .link-seta:hover span {
    translate: 6px 0;
  }

  /* Texto da capa entra deslizando, um depois do outro */
  .entrar {
    animation: entrar 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  h1.entrar {
    animation-delay: 0.1s;
  }

  .hero-assinatura.entrar {
    animation-delay: 0.25s;
  }

  .hero-acoes.entrar {
    animation-delay: 0.4s;
  }

  /* ---------- ENSAIOS ---------- */
  .secao {
    padding-top: clamp(88px, 16vh, 180px);
  }

  .secao > .rotulo {
    margin: 0 0 2rem;
  }

  .ensaios {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(16px, 2vw, 32px);
  }

  .ensaio-imagem {
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--fundo-2);
    margin-bottom: 1.2rem;
  }

  .ensaio-imagem img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.4) brightness(0.85);
    transition: transform 1s cubic-bezier(0.2, 0.6, 0.2, 1), filter 0.8s;
  }

  .ensaio:hover .ensaio-imagem img {
    transform: scale(1.05);
    filter: none;
  }

  .ensaio-vazio {
    height: 100%;
    background: linear-gradient(160deg, #081021, #03050b);
    border: 1px solid var(--linha);
  }

  .ensaio-numero {
    font-size: 0.75rem;
    color: var(--destaque);
    letter-spacing: 0.2em;
  }

  .ensaio h2 {
    font-size: clamp(2rem, 3.5vw, 2.8rem);
    font-style: italic;
    margin: 0.2rem 0;
    transition: color 0.3s;
  }

  .ensaio:hover h2 {
    color: var(--destaque);
  }

  .ensaio-seta {
    display: inline-block;
    font-family: var(--fonte-texto);
    font-size: 0.5em;
    font-style: normal;
    vertical-align: middle;
    opacity: 0;
    translate: -10px 0;
    transition: opacity 0.3s, translate 0.3s;
  }

  .ensaio:hover .ensaio-seta {
    opacity: 1;
    translate: 0 0;
  }

  .ensaio p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--texto-suave);
  }

  /* ---------- CHAMADA ---------- */
  .chamada {
    padding-top: clamp(96px, 16vh, 180px);
    text-align: center;
  }

  .chamada h2 {
    font-size: clamp(2.6rem, 7vw, 5rem);
  }

  .chamada p {
    color: var(--texto-suave);
    margin: 1rem 0 2.5rem;
  }

  /* ---------- PROJETOS DE CÓDIGO ---------- */
  .secao-codigo {
    margin-top: clamp(96px, 16vh, 180px);
    padding-top: clamp(64px, 10vh, 110px);
    border-top: 1px solid var(--linha);
  }

  .codigo-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem 2rem;
  }

  .codigo-descricao {
    max-width: 52ch;
    margin: 1.2rem 0 0;
    color: var(--texto-suave);
  }

  .codigo-topo {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(48px, 8vh, 90px);
  }

  .codigo-topo h2 {
    font-size: clamp(2.6rem, 7vw, 5rem);
    margin-top: 0.75rem;
  }

  /* ---------- CRIAÇÃO DE SITES ---------- */
  .sites {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    align-items: center;
    gap: clamp(32px, 6vw, 96px);
    margin-top: clamp(96px, 16vh, 180px);
    padding-top: clamp(64px, 10vh, 110px);
    border-top: 1px solid var(--linha);
  }

  .sites h2 {
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    font-style: italic;
    margin: 0.75rem 0 1.2rem;
  }

  .sites-texto > p:not(.rotulo) {
    color: var(--texto-suave);
    max-width: 46ch;
  }

  .sites ul {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 2.2rem;
  }

  .sites li {
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--linha);
    font-size: 0.95rem;
  }

  .sites li::before {
    content: '✦';
    color: var(--destaque);
    margin-right: 0.8rem;
  }

  .navegador {
    border: 1px solid var(--linha);
    background: var(--fundo-2);
    border-radius: 10px;
    overflow: hidden;
  }

  .navegador-barra {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--linha);
  }

  .navegador-barra i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--linha);
  }

  .navegador-barra span {
    margin-left: 12px;
    padding: 2px 12px;
    border-radius: 99px;
    background: var(--fundo);
    font-size: 0.7rem;
    color: var(--texto-suave);
  }

  .navegador-tela {
    position: relative;
    aspect-ratio: 16 / 10;
    padding: 12% 8%;
    background: var(--fundo);
  }

  .navegador-tela > div {
    position: relative;
  }

  .mini-bloco {
    position: absolute !important;
    left: 10%;
    bottom: 26%;
    width: 30%;
    height: 32%;
    background: linear-gradient(135deg, var(--destaque-forte), #07183a);
  }

  .mini-foto {
    position: absolute !important;
    right: 0;
    top: 10%;
    width: 55%;
    height: 62%;
    background: radial-gradient(ellipse at 60% 40%, #0d1f3b, #080c17);
  }

  .mini-linha {
    height: 8px;
    width: 40%;
    margin-bottom: 8px;
    background: var(--texto-suave);
    opacity: 0.5;
  }

  .mini-linha.grande {
    height: 16px;
    width: 55%;
    background: var(--texto);
    opacity: 0.9;
  }

  .mini-linha.curta {
    width: 38%;
  }

  .mini-grade {
    position: absolute !important;
    left: 8%;
    right: 8%;
    bottom: 6%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }

  .mini-grade b {
    height: 22px;
    background: #0b1426;
  }

  /* ---------- CELULAR ---------- */
  @media (max-width: 860px) {
    .hero {
      padding-top: 96px;
    }

    .vidros {
      display: none;
    }

    .sites {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .ensaios {
      grid-template-columns: 1fr;
    }

    .ensaio-imagem {
      aspect-ratio: 4 / 3;
    }
  }

  /* ---------- ANIMAÇÕES ---------- */
  @keyframes zoom {
    from {
      transform: scale(1.08);
    }
  }

  @keyframes entrar {
    from {
      opacity: 0;
      translate: 0 30px;
    }
  }

  @keyframes marcar {
    to {
      background-size: 100% 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-foto,
    .entrar,
    .vidro,
    .vidro-agenda i {
      animation: none;
    }

    .hero .marca-texto {
      animation: none;
      background-size: 100% 100%;
    }
  }
</style>
