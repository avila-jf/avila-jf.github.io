---
import Base from '../layouts/Base.astro';
import Projetos from '../components/Projetos.astro';
import { github } from '../data/site';
---

<Base titulo="Projects" descricao="Websites and systems I built: client, personal and college projects.">
  <section class="container titulo-pagina">
    <p class="rotulo">Code</p>
    <h1>Projects</h1>
    <p>
      Besides taking photos, I code. Here are the websites and systems I built: for clients, on my own and
      in college.
    </p>
  </section>

  <section class="container">
    <Projetos todos />

    <div class="mais">
      <a class="botao" href={github} target="_blank" rel="noopener">See everything on GitHub</a>
    </div>
  </section>
</Base>

<style>
  .mais {
    margin-top: clamp(56px, 10vh, 100px);
    text-align: center;
  }
</style>
