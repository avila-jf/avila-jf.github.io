---
import { Image, getImage } from 'astro:assets';
import type { Foto } from '../lib/fotos';

interface Props {
  fotos: Foto[];
  vazios?: number; // quantos quadros "sua foto aqui" mostrar enquanto não houver fotos
}

const { fotos, vazios = 9 } = Astro.props;

// Versão grande (para abrir em tela cheia no lightbox)
const itens = await Promise.all(
  fotos.map(async (foto) => ({
    ...foto,
    grande: await getImage({
      src: foto.src,
      width: Math.min(2400, foto.src.width),
      format: 'webp',
      quality: 82,
    }),
  })),
);

const proporcoes = ['4/5', '3/2', '2/3', '16/9', '1/1', '4/5', '3/2', '2/3', '3/2'];
---

<div class="galeria">
  {
    itens.length > 0
      ? itens.map((foto, i) => (
          <a class="item revelar" href={foto.grande.src} data-lightbox data-legenda={foto.alt} data-tilt>
            <Image
              src={foto.src}
              alt={foto.alt}
              widths={[480, 800, 1200]}
              sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 33vw"
              format="webp"
              quality={78}
              loading={i < 3 ? 'eager' : 'lazy'}
            />
          </a>
        ))
      : Array.from({ length: vazios }, (_, i) => (
          <div class="item vazio revelar" style={`aspect-ratio: ${proporcoes[i % proporcoes.length]}`} data-tilt>
            <span>sua foto aqui</span>
          </div>
        ))
  }
</div>

<style>
  /* Grade estilo "masonry": colunas que respeitam a proporção de cada foto */
  .galeria {
    columns: 3 320px;
    column-gap: clamp(8px, 1.2vw, 18px);
  }

  .item {
    display: block;
    margin-bottom: clamp(8px, 1.2vw, 18px);
    break-inside: avoid;
    overflow: hidden;
    background: var(--fundo-2);
  }

  .item img {
    width: 100%;
    transition: transform 0.8s cubic-bezier(0.2, 0.6, 0.2, 1), filter 0.8s;
    filter: saturate(0.92);
  }

  .item:hover img {
    transform: scale(1.03);
    filter: saturate(1.05);
  }

  .vazio {
    display: grid;
    place-items: center;
    background:
      radial-gradient(ellipse at 30% 20%, #0d182c, transparent 60%),
      linear-gradient(160deg, #080c17, #03050b);
    border: 1px solid var(--linha);
  }

  .vazio span {
    font-family: var(--fonte-titulo);
    font-style: italic;
    font-size: 1.1rem;
    color: var(--texto-suave);
    opacity: 0.6;
  }
</style>
