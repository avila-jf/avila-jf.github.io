---
// Seção de sites com o Clique, o robô-console do Francis (desenho original, só HTML/CSS, sem 3D).
// A seção fica presa na tela enquanto você rola:
//   1º trecho  → o robô acorda (abre os olhos, a tela acende)
//   depois     → um trecho por site: o print rola dentro da tela, a luz de trás pega a cor do site,
//                e o painel ao lado troca nome, descrição e tecnologias. No fim de cada trecho a tela
//                se mistura com o próximo site.
// Na tela fica o rosto do robô; passando o mouse (ou tocando, no celular) o rosto some e aparece o print.
// Com "reduzir movimento": nada fica preso e os sites aparecem como cartões normais.
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';

interface Site {
  nome: string;
  tipo: string;
  descricao: string;
  tecnologias: string[];
  site?: string;
  codigo?: string;
  cor?: string;
  print?: ImageMetadata;
}

interface Props {
  sites: Site[];
}

const { sites } = Astro.props;
const comPrint = sites.filter((s) => s.print);
const urls = await Promise.all(comPrint.map(async (s) => (await getImage({ src: s.print!, width: 1400, format: 'webp', quality: 80 })).src));
// no celular a tela do notebook é pequena: 800px bastam e a textura pesa 3x menos na GPU
const urlsCelular = await Promise.all(comPrint.map(async (s) => (await getImage({ src: s.print!, width: 800, format: 'webp', quality: 78 })).src));
const cores = comPrint.map((s) => s.cor ?? '#2346a8');
---

<div class="aparelho" data-urls={JSON.stringify(urls)} data-urls-celular={JSON.stringify(urlsCelular)} data-cores={JSON.stringify(cores)} style={`--cor: ${cores[0] ?? '#2346a8'}`}>
  <div class="aparelho-palco">
    <div class="aparelho-luz" aria-hidden="true"></div>
    <div class="robo-cena">
      <div class="robo" role="img" aria-label="Clique, a little console robot: its front door opens to show the website and the gear inside" tabindex="0">
        <div class="robo-cima">
          <span class="robo-visor"><i></i></span>
          <span class="robo-braco robo-braco-esq"></span>
          <span class="robo-braco robo-braco-dir"></span>
          <div class="robo-corpo">
            <span class="robo-lado">FA</span>
            <!-- o que tem dentro: o monitor com o site e as coisas do fotógrafo -->
            <div class="robo-dentro">
              <div class="robo-monitor">
                <div class="robo-prints">
                  {
                    urls.map((u, i) => (
                      <img
                        src={urlsCelular[i]}
                        srcset={`${urlsCelular[i]} 800w, ${u} 1400w`}
                        sizes="(max-width: 760px) 50vw, 26vw"
                        alt=""
                        loading="lazy"
                        decoding="async"
                        style={i === 0 ? '' : 'opacity:0'}
                      />
                    ))
                  }
                </div>
              </div>
              <span class="robo-placa"><i></i><i></i><i></i></span>
              <span class="robo-filme"><i></i></span>
              <span class="robo-objetiva"></span>
              <span class="robo-cartao"></span>
              <span class="robo-coracao"></span>
              <span class="robo-fio"></span>
            </div>
            <!-- a porta da frente: o rosto, os controles; abre na dobradiça da esquerda -->
            <div class="robo-porta">
              <div class="robo-frente">
                <div class="robo-tela">
                  <div class="robo-rosto">
                    <span class="robo-olhos"><i></i><i></i></span>
                    <span class="robo-bochecha robo-bochecha-esq"></span>
                    <span class="robo-bochecha robo-bochecha-dir"></span>
                    <span class="robo-boca"></span>
                  </div>
                  <span class="robo-vidro"></span>
                </div>
                <div class="robo-painel">
                  <span class="robo-alavanca"><i></i></span>
                  <span class="robo-pilulas"><i></i><i></i></span>
                  <span class="robo-dial"></span>
                </div>
                <span class="robo-grade"><i></i><i></i><i></i><i></i></span>
              </div>
              <span class="robo-verso"></span>
            </div>
          </div>
        </div>
        <span class="robo-perna robo-perna-esq"></span>
        <span class="robo-perna robo-perna-dir"></span>
        <span class="robo-chao"></span>
      </div>
      <p class="robo-dica voz-codigo" aria-hidden="true"><span class="so-mouse">hover to open me</span><span class="so-dedo">tap to open me</span></p>
    </div>

    <div class="aparelho-infos">
      {
        comPrint.map((s, i) => (
          <article class:list={['aparelho-info', { ativa: i === 0 }]} data-i={i}>
            <span class="aparelho-print">
              <Image src={s.print!} alt={`Screenshot of ${s.nome}`} widths={[480, 800]} sizes="(max-width: 760px) 90vw, 40vw" format="webp" />
            </span>
            <p class="rotulo">
              0{i + 1} / 0{comPrint.length} · {s.tipo}
            </p>
            <h3 class="titulo-cartaz">{s.nome}</h3>
            <p class="aparelho-descricao">{s.descricao}</p>
            <p class="voz-codigo aparelho-tec">{s.tecnologias.join(' · ')}</p>
            <div class="aparelho-links">
              {s.site && (
                <a class="aparelho-botao" href={s.site} target="_blank" rel="noopener">
                  Visit site ↗
                </a>
              )}
              {s.codigo && (
                <a class="aparelho-codigo voz-codigo" href={s.codigo} target="_blank" rel="noopener">
                  code
                </a>
              )}
            </div>
          </article>
        ))
      }
      <ol class="aparelho-pontos" aria-hidden="true">
        {comPrint.map((_, i) => <li class:list={{ ativa: i === 0 }} />)}
      </ol>
    </div>
  </div>
</div>

<style>
  /* ---------- sem 3D: cartões normais ---------- */
  .robo-cena,
  .aparelho-luz,
  .aparelho-pontos {
    display: none;
  }
  .aparelho-infos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 14px;
  }
  .aparelho-info {
    padding: 14px 14px 22px;
    border: 1px solid var(--linha);
    border-radius: 18px;
    background: var(--vidro);
  }
  .aparelho-print {
    display: block;
    aspect-ratio: 16 / 9;
    margin-bottom: 12px;
    overflow: hidden;
    border-radius: 10px;
  }
  .aparelho-print img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .aparelho-info .rotulo {
    margin: 0;
  }
  .aparelho-info h3 {
    margin: 8px 0 12px;
    font-size: clamp(40px, 5vw, 84px);
    color: var(--texto);
  }
  .aparelho-descricao {
    max-width: 44ch;
    margin: 0 0 12px;
    color: var(--texto-suave);
  }
  .aparelho-tec {
    margin: 0 0 22px;
    color: var(--azul);
  }
  .aparelho-links {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .aparelho-botao {
    padding: 12px 22px;
    border-radius: 999px;
    background: var(--texto);
    color: var(--fundo);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.3s;
  }
  .aparelho-botao:hover {
    background: var(--cor);
  }
  .aparelho-codigo {
    color: var(--texto-suave);
  }

  /* ---------- com 3D: palco preso na tela ---------- */
  .aparelho.ativo .aparelho-palco {
    position: relative;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    align-items: center;
    height: 100svh;
    padding: 90px 0 30px;
  }
  /* ---------- o robô ---------- */
  /* tudo dentro dele é medido em em: 1em = 1% da largura do corpo, então ele escala inteiro */
  .aparelho.ativo .robo-cena {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    align-content: center;
    gap: 2.2em;
    height: 100%;
    min-height: 0;
    --l: min(340px, 26vw, 46svh);
    font-size: calc(var(--l) / 100);
  }
  .robo {
    --corpo: #2346a8;
    --corpo-sombra: #172f78;
    --creme: #fff1d6;
    --tinta: #0e1a45;
    --laranja: #ef6a3a;
    --acordar: 0;
    position: relative;
    width: 100em;
    height: 150em;
    outline: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .robo span,
  .robo i {
    display: block;
    position: absolute;
  }
  /* a parte de cima balança devagar, as pernas ficam no chão */
  .robo-cima {
    position: absolute;
    inset: 0 0 auto;
    z-index: 1;
    height: 130em;
    animation: robo-respira 3.2s ease-in-out infinite alternate;
  }
  @keyframes robo-respira {
    to {
      transform: translateY(-1.6em);
    }
  }
  /* o visor de câmera em cima da caixa, com a lente: a marca do fotógrafo */
  .robo-visor {
    left: 14em;
    top: -4em;
    width: 30em;
    height: 12em;
    border-radius: 4em 4em 0 0;
    background: var(--corpo-sombra);
  }
  .robo-visor i {
    left: 8em;
    top: -5em;
    width: 14em;
    height: 14em;
    border-radius: 50%;
    background: radial-gradient(circle at 36% 34%, #fff 0 8%, #7f95e0 9% 22%, #1b2a6b 23% 52%, #05081a 53% 66%, #2b2b2b 67%);
    box-shadow: 0 0 0 1.4em var(--creme);
  }
  /* braços: um tubo da cor do corpo que sai da lateral e desce em curva, ponta reta */
  .robo-braco {
    z-index: -1;
    top: 50em;
    width: 18em;
    height: 34em;
    border: 6em solid var(--corpo);
    border-bottom: 0;
    animation: robo-aceno 3.2s ease-in-out infinite alternate;
  }
  .robo-braco-esq {
    left: -13em;
    border-right: 0;
    border-top-left-radius: 16em;
    transform-origin: 100% 0;
  }
  .robo-braco-dir {
    right: -13em;
    border-left: 0;
    border-top-right-radius: 16em;
    border-color: var(--corpo-sombra);
    transform-origin: 0 0;
    animation-direction: alternate-reverse;
  }
  @keyframes robo-aceno {
    from {
      rotate: -5deg;
    }
    to {
      rotate: 5deg;
    }
  }
  /* o bloco: topo reto; a faixa mais escura à direita é a espessura da caixa */
  .robo-corpo {
    position: absolute;
    left: 0;
    top: 6em;
    width: 100em;
    height: 120em;
    border-radius: 3em;
    background: linear-gradient(90deg, var(--corpo) 0 87%, var(--corpo-sombra) 87%);
    box-shadow:
      inset 0 0.9em 0 rgb(255 255 255 / 0.16),
      0 3em 5em rgb(0 0 0 / 0.28);
    perspective: 260em;
  }
  /* as iniciais na lateral, em pé */
  /* a fonte é 9em: as medidas aqui vão divididas por 9 */
  .robo-lado {
    left: calc(87em / 9);
    width: calc(13em / 9);
    top: calc(30em / 9);
    writing-mode: vertical-rl;
    text-align: center;
    font: 900 9em/1 'Archivo', sans-serif;
    letter-spacing: 0.1em;
    color: var(--creme);
    opacity: 0.85;
  }
  /* ---- dentro da caixa ---- */
  .robo-dentro {
    position: absolute;
    left: 3em;
    top: 3em;
    width: 81em;
    height: 114em;
    overflow: hidden;
    border-radius: 2em;
    background: var(--tinta);
    box-shadow:
      inset 1.5em 1.5em 3em rgb(0 0 0 / 0.55),
      inset -0.6em -0.6em 0 rgb(255 255 255 / 0.05);
  }
  .robo-monitor {
    position: absolute;
    left: 7em;
    right: 7em;
    top: 7em;
    height: 46em;
    border-radius: 3em;
    background: var(--creme);
    box-shadow: 0 1em 0 rgb(0 0 0 / 0.35);
  }
  .robo-prints {
    position: absolute;
    inset: 2.2em;
    border-radius: 1.6em;
    overflow: hidden;
    background: #fff;
  }
  .robo-prints img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% calc(var(--rolar, 0) * 100%);
  }
  /* placa de circuito com chips */
  .robo-placa {
    left: 5em;
    top: 60em;
    width: 36em;
    height: 22em;
    border-radius: 1.2em;
    background:
      radial-gradient(circle, #c9d98a 0 0.6em, transparent 0.7em) 0 0 / 4em 4em,
      #2f7d4f;
  }
  .robo-placa i {
    width: 9em;
    height: 6em;
    border-radius: 0.6em;
    background: #1b1f2a;
    box-shadow: 0 0 0 0.6em #3a4152;
  }
  .robo-placa i:nth-child(1) {
    left: 4em;
    top: 4em;
  }
  .robo-placa i:nth-child(2) {
    left: 18em;
    top: 4em;
    width: 12em;
  }
  .robo-placa i:nth-child(3) {
    left: 9em;
    top: 13em;
    width: 16em;
    height: 4em;
  }
  /* rolo de filme laranja, em pé */
  .robo-filme {
    left: 46em;
    top: 57em;
    width: 13em;
    height: 24em;
    border-radius: 1.4em;
    background: repeating-linear-gradient(0deg, var(--laranja) 0 3em, #ffc93c 3em 4.2em);
  }
  .robo-filme::before,
  .robo-filme::after {
    content: '';
    position: absolute;
    left: 3.5em;
    width: 6em;
    height: 3em;
    background: #2b2b2b;
    border-radius: 0.6em;
  }
  .robo-filme::before {
    top: -2.4em;
  }
  .robo-filme::after {
    bottom: -2.4em;
  }
  .robo-filme i {
    left: 12em;
    top: 6em;
    width: 9em;
    height: 7em;
    background: repeating-linear-gradient(90deg, #3a2a1c 0 1.2em, #1d140d 1.2em 2.4em);
  }
  /* uma objetiva de câmera, vista de frente */
  .robo-objetiva {
    left: 61em;
    top: 62em;
    width: 16em;
    height: 16em;
    border-radius: 50%;
    background: radial-gradient(circle at 38% 34%, #fff 0 7%, #7f95e0 8% 22%, #1b2a6b 23% 50%, #05081a 51% 64%, #3b3f4c 65% 80%, #22252f 81%);
  }
  /* cartão de memória */
  .robo-cartao {
    left: 8em;
    top: 88em;
    width: 15em;
    height: 19em;
    background:
      linear-gradient(#ffc93c 0 0) 3em 2em / 1.4em 4em no-repeat,
      linear-gradient(#ffc93c 0 0) 5.5em 2em / 1.4em 4em no-repeat,
      linear-gradient(#ffc93c 0 0) 8em 2em / 1.4em 4em no-repeat,
      linear-gradient(#fff 0 0) 2em 10em / 11em 6em no-repeat,
      #24272f;
    clip-path: polygon(0 0, 72% 0, 100% 20%, 100% 100%, 0 100%);
    border-radius: 0.6em;
  }
  /* um coração (o amor pelo que faz) */
  .robo-coracao {
    left: 34em;
    top: 92em;
    width: 13em;
    height: 13em;
    rotate: 45deg;
    background: #ffc93c;
    border-radius: 0 0 1.4em 0;
  }
  .robo-coracao::before,
  .robo-coracao::after {
    content: '';
    position: absolute;
    width: 13em;
    height: 13em;
    border-radius: 50%;
    background: inherit;
  }
  .robo-coracao::before {
    left: -6.5em;
    top: 0;
  }
  .robo-coracao::after {
    left: 0;
    top: -6.5em;
  }
  /* um fio que sai da placa e se enrola */
  .robo-fio {
    left: 52em;
    top: 84em;
    width: 24em;
    height: 22em;
    border: 1.6em solid var(--laranja);
    border-left-color: transparent;
    border-radius: 50%;
    rotate: 20deg;
  }
  /* ---- a porta da frente ---- */
  .robo-porta {
    position: absolute;
    left: 0;
    top: 0;
    width: 87em;
    height: 120em;
    transform-origin: 0 50%;
    transform-style: preserve-3d;
    transition: transform 0.9s cubic-bezier(0.3, 1.4, 0.4, 1);
  }
  .robo-frente,
  .robo-verso {
    position: absolute;
    inset: 0;
    border-radius: 3em 0 0 3em;
    backface-visibility: hidden;
  }
  .robo-frente {
    background: var(--corpo);
    box-shadow:
      inset 0 0.9em 0 rgb(255 255 255 / 0.16),
      inset -0.5em 0 0 rgb(0 0 0 / 0.18);
  }
  /* o lado de dentro da porta, mais escuro */
  .robo-verso {
    transform: rotateY(180deg);
    background: var(--corpo-sombra);
    box-shadow: inset 0 0 0 2em rgb(0 0 0 / 0.15);
  }
  .robo:hover .robo-porta,
  .robo:focus-visible .robo-porta,
  .robo.mostra .robo-porta {
    transform: rotateY(-112deg);
  }
  /* a tela do rosto ocupa a metade de cima */
  .robo-tela {
    position: absolute;
    left: 8em;
    right: 8em;
    top: 8em;
    height: 52em;
    overflow: hidden;
    border-radius: 3em;
    background: var(--creme);
    box-shadow:
      inset 0 0 0 0.9em var(--tinta),
      inset 0 2.2em 0 0.9em rgb(0 0 0 / 0.18);
    filter: brightness(calc(0.55 + var(--acordar) * 0.45));
  }
  .robo-rosto {
    position: absolute;
    inset: 0;
  }
  .robo-olhos {
    left: 0;
    right: 0;
    top: 15em;
    height: 12em;
    transform: scaleY(calc(0.12 + var(--acordar) * 0.88));
  }
  .robo-olhos i {
    top: 0;
    width: 7em;
    height: 12em;
    border-radius: 4em;
    background: var(--tinta);
    animation: robo-pisca 4.6s infinite;
  }
  .robo-olhos i:first-child {
    left: 18em;
  }
  .robo-olhos i:last-child {
    right: 18em;
  }
  @keyframes robo-pisca {
    0%,
    94%,
    100% {
      transform: none;
    }
    97% {
      transform: scaleY(0.1);
    }
  }
  .robo-bochecha {
    top: 30em;
    width: 8em;
    height: 4em;
    border-radius: 50%;
    background: #ff9db0;
    opacity: 0.7;
  }
  .robo-bochecha-esq {
    left: 10em;
  }
  .robo-bochecha-dir {
    right: 10em;
  }
  /* boca aberta em D, com a língua */
  .robo-boca {
    left: 50%;
    top: 31em;
    width: 13em;
    height: 7em;
    translate: -50% 0;
    overflow: hidden;
    border-radius: 0.8em 0.8em 7em 7em;
    background: var(--tinta);
  }
  .robo-boca::after {
    content: '';
    position: absolute;
    left: 3em;
    bottom: -2em;
    width: 7em;
    height: 5em;
    border-radius: 50%;
    background: #ff7a8a;
  }
  .robo-vidro {
    inset: 0.9em;
    border-radius: 2.2em;
    pointer-events: none;
    background:
      linear-gradient(130deg, rgb(255 255 255 / 0.4) 0 18%, transparent 19%),
      repeating-linear-gradient(0deg, rgb(0 0 0 / 0.04) 0 0.5em, transparent 0.5em 1.2em);
  }
  /* painel de controles */
  .robo-painel {
    position: absolute;
    left: 8em;
    right: 8em;
    top: 68em;
    height: 26em;
  }
  .robo-alavanca {
    left: 0;
    top: 2em;
    width: 19em;
    height: 19em;
    border-radius: 50%;
    background: var(--corpo-sombra);
    box-shadow: inset 0 0.9em 0 rgb(0 0 0 / 0.25);
  }
  .robo-alavanca i {
    left: 4.5em;
    top: 3em;
    width: 10em;
    height: 10em;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #ff9a6e, var(--laranja) 60%);
    box-shadow: 0 1.4em 0 #a8401c;
  }
  .robo-pilulas {
    left: 24em;
    top: 11em;
    width: 20em;
    height: 6em;
    rotate: -22deg;
  }
  .robo-pilulas i {
    top: 0;
    width: 8.6em;
    height: 4.4em;
    border-radius: 3em;
    background: var(--creme);
    box-shadow: 0 0.8em 0 rgb(0 0 0 / 0.3);
  }
  .robo-pilulas i:last-child {
    right: 0;
  }
  /* o "dial" de câmera, serrilhado */
  .robo-dial {
    right: 0;
    top: 2em;
    width: 15em;
    height: 15em;
    border-radius: 50%;
    background:
      radial-gradient(circle, #ffc93c 0 46%, transparent 47%),
      repeating-conic-gradient(var(--tinta) 0 10deg, #2c3d82 10deg 20deg);
    box-shadow: 0 1.2em 0 rgb(0 0 0 / 0.35);
  }
  .robo-grade {
    left: 50%;
    bottom: 8em;
    width: 30em;
    height: 6em;
    translate: -50% 0;
  }
  .robo-grade i {
    left: 0;
    right: 0;
    height: 0.9em;
    border-radius: 1em;
    background: rgb(0 0 0 / 0.3);
  }
  .robo-grade i:nth-child(2) {
    top: 1.7em;
  }
  .robo-grade i:nth-child(3) {
    top: 3.4em;
  }
  .robo-grade i:nth-child(4) {
    top: 5.1em;
  }
  /* pernas: tubos finos e escuros que saem da base, com um pezinho */
  .robo-perna {
    z-index: 0;
    bottom: 5em;
    width: 6em;
    height: 26em;
    border-radius: 0 0 3em 3em;
    background: var(--tinta);
  }
  .robo-perna::after {
    content: '';
    position: absolute;
    left: -3em;
    bottom: -2.4em;
    width: 12em;
    height: 4.4em;
    border-radius: 3em 3em 1.4em 1.4em;
    background: var(--tinta);
  }
  .robo-perna-esq {
    left: 24em;
  }
  .robo-perna-dir {
    left: 60em;
  }
  .robo-chao {
    left: -12em;
    right: -12em;
    bottom: -2em;
    height: 12em;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.35), transparent);
  }
  .robo-dica {
    margin: 0;
    color: var(--texto-suave);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .so-dedo {
    display: none;
  }
  @media (hover: none) {
    .so-mouse {
      display: none;
    }
    .so-dedo {
      display: inline;
    }
    /* sem mouse: os braços e a respiração param (menos trabalho pro celular) */
    .robo-braco,
    .robo-cima {
      animation: none;
    }
  }
  /* brilho na cor do site atrás do notebook */
  .aparelho.ativo .aparelho-luz {
    display: block;
    position: absolute;
    left: 5%;
    top: 20%;
    width: 50%;
    height: 60%;
    border-radius: 50%;
    background: var(--cor);
    opacity: 0.22;
    filter: blur(80px);
    transition: background-color 0.8s;
  }
  .aparelho.ativo .aparelho-infos {
    position: relative;
    display: block;
    height: 100%;
  }
  .aparelho.ativo .aparelho-info {
    position: absolute;
    inset: 50% 0 auto;
    padding: 0;
    border: 0;
    background: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-40%);
    transition:
      opacity 0.6s,
      transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
      visibility 0.6s;
  }
  .aparelho.ativo .aparelho-info.ativa {
    opacity: 1;
    visibility: visible;
    transform: translateY(-50%);
  }
  .aparelho.ativo .aparelho-print {
    display: none; /* o print está na tela do notebook */
  }
  .aparelho.ativo .aparelho-pontos {
    position: absolute;
    left: 0;
    bottom: 8%;
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .aparelho-pontos li {
    width: 28px;
    height: 3px;
    border-radius: 3px;
    background: var(--linha);
    transition: background-color 0.4s;
  }
  .aparelho-pontos li.ativa {
    background: var(--cor);
  }

  @media (max-width: 760px) {
    .aparelho.ativo .aparelho-palco {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr auto;
      padding-top: 70px;
    }
    .aparelho.ativo .aparelho-infos {
      height: 36svh;
    }
    .aparelho.ativo .robo-cena {
      --l: min(52vw, 27svh);
    }
    .aparelho.ativo .aparelho-info {
      inset: 0 0 auto;
      transform: translateY(12px);
    }
    .aparelho.ativo .aparelho-info.ativa {
      transform: none;
    }
    .aparelho.ativo .aparelho-pontos {
      bottom: 0;
    }
    /* no celular o brilho é um degradê: blur(80px) numa área grande é caro de compor */
    .aparelho.ativo .aparelho-luz {
      filter: none;
      background: radial-gradient(closest-side, var(--cor), transparent);
      opacity: 0.3;
    }
  }
</style>

<script>
  import { ScrollTrigger, prioridade, remedir } from '../../lib/movimento';

  const raiz = document.querySelector<HTMLElement>('.aparelho');
  const semMovimento = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (raiz && !semMovimento) {
    const robo = raiz.querySelector<HTMLElement>('.robo')!;
    const prints = [...raiz.querySelectorAll<HTMLImageElement>('.robo-prints img')];
    const cores: string[] = JSON.parse(raiz.dataset.cores!);
    const infos = [...raiz.querySelectorAll<HTMLElement>('.aparelho-info')];
    const pontos = [...raiz.querySelectorAll<HTMLElement>('.aparelho-pontos li')];
    const n = prints.length;
    raiz.classList.add('ativo');

    // no celular não tem hover: um toque na tela mostra o print, outro volta o rosto
    robo.addEventListener('click', () => robo.classList.toggle('mostra'));

    const faixa = (p: number, de: number, ate: number) => Math.min(1, Math.max(0, (p - de) / (ate - de)));
    let atual = -1;
    ScrollTrigger.create({
      trigger: raiz,
      start: 'top top',
      end: `+=${(n + 1) * 90}%`,
      pin: raiz.querySelector('.aparelho-palco'),
      refreshPriority: prioridade(raiz),
      scrub: true,
      onUpdate: ({ progress: p }) => {
        robo.style.setProperty('--acordar', faixa(p, 0, 0.12).toFixed(3));
        const q = faixa(p, 0.18, 1) * n;
        const i = Math.min(n - 1, Math.floor(q));
        const local = q - i;
        const ultimo = i === n - 1;
        const mistura = ultimo ? 0 : faixa(local, 0.82, 1);
        prints.forEach((img, k) => {
          img.style.opacity = String(k === i ? 1 - mistura : k === i + 1 ? mistura : 0);
          if (k === i) img.style.setProperty('--rolar', faixa(local, 0.08, ultimo ? 0.95 : 0.8).toFixed(3));
        });
        if (i !== atual) {
          atual = i;
          infos.forEach((el, k) => el.classList.toggle('ativa', k === i));
          pontos.forEach((el, k) => el.classList.toggle('ativa', k === i));
          raiz.style.setProperty('--cor', cores[i]);
        }
      },
    });
    remedir(); // as seções de cima podem ter medido antes: volta para a ordem da página
  }
</script>
