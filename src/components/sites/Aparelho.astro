---
// Seção de sites com o notebook 3D (o three.js mora em src/lib/aparelho3d.ts).
// A seção fica presa na tela enquanto você rola:
//   1º trecho  → o notebook abre
//   depois     → um trecho por site: o print rola dentro da tela, a luz de trás pega a cor do site,
//                e o painel ao lado troca nome, descrição e tecnologias. No fim de cada trecho a tela
//                se mistura com o próximo site.
// Sem WebGL ou com "reduzir movimento": nada fica preso e os sites aparecem como cartões normais.
import type { ImageMetadata } from 'astro';
import { getImage, Image } from 'astro:assets';

interface Site {
  nome: string;
  tipo: string;
  descricao: string;
  tecnologias: string[];
  site?: string;
  codigo?: string;
  cor?: string;
  print?: ImageMetadata;
}

interface Props {
  sites: Site[];
}

const { sites } = Astro.props;
const comPrint = sites.filter((s) => s.print);
const urls = await Promise.all(comPrint.map(async (s) => (await getImage({ src: s.print!, width: 1400, format: 'webp', quality: 80 })).src));
// no celular a tela do notebook é pequena: 800px bastam e a textura pesa 3x menos na GPU
const urlsCelular = await Promise.all(comPrint.map(async (s) => (await getImage({ src: s.print!, width: 800, format: 'webp', quality: 78 })).src));
const cores = comPrint.map((s) => s.cor ?? '#2346a8');
---

<div class="aparelho" data-urls={JSON.stringify(urls)} data-urls-celular={JSON.stringify(urlsCelular)} data-cores={JSON.stringify(cores)} style={`--cor: ${cores[0] ?? '#2346a8'}`}>
  <div class="aparelho-palco">
    <div class="aparelho-luz" aria-hidden="true"></div>
    <canvas class="aparelho-3d" aria-hidden="true"></canvas>

    <div class="aparelho-infos">
      {
        comPrint.map((s, i) => (
          <article class:list={['aparelho-info', { ativa: i === 0 }]} data-i={i}>
            <span class="aparelho-print">
              <Image src={s.print!} alt={`Screenshot of ${s.nome}`} widths={[480, 800]} sizes="(max-width: 760px) 90vw, 40vw" format="webp" />
            </span>
            <p class="rotulo">
              0{i + 1} / 0{comPrint.length} · {s.tipo}
            </p>
            <h3 class="titulo-cartaz">{s.nome}</h3>
            <p class="aparelho-descricao">{s.descricao}</p>
            <p class="voz-codigo aparelho-tec">{s.tecnologias.join(' · ')}</p>
            <div class="aparelho-links">
              {s.site && (
                <a class="aparelho-botao" href={s.site} target="_blank" rel="noopener">
                  Visit site ↗
                </a>
              )}
              {s.codigo && (
                <a class="aparelho-codigo voz-codigo" href={s.codigo} target="_blank" rel="noopener">
                  code
                </a>
              )}
            </div>
          </article>
        ))
      }
      <ol class="aparelho-pontos" aria-hidden="true">
        {comPrint.map((_, i) => <li class:list={{ ativa: i === 0 }} />)}
      </ol>
    </div>
  </div>
</div>

<style>
  /* ---------- sem 3D: cartões normais ---------- */
  .aparelho-3d,
  .aparelho-luz,
  .aparelho-pontos {
    display: none;
  }
  .aparelho-infos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 14px;
  }
  .aparelho-info {
    padding: 14px 14px 22px;
    border: 1px solid var(--linha);
    border-radius: 18px;
    background: var(--vidro);
  }
  .aparelho-print {
    display: block;
    aspect-ratio: 16 / 9;
    margin-bottom: 12px;
    overflow: hidden;
    border-radius: 10px;
  }
  .aparelho-print img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .aparelho-info .rotulo {
    margin: 0;
  }
  .aparelho-info h3 {
    margin: 8px 0 12px;
    font-size: clamp(40px, 5vw, 84px);
    color: var(--texto);
  }
  .aparelho-descricao {
    max-width: 44ch;
    margin: 0 0 12px;
    color: var(--texto-suave);
  }
  .aparelho-tec {
    margin: 0 0 22px;
    color: var(--azul);
  }
  .aparelho-links {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .aparelho-botao {
    padding: 12px 22px;
    border-radius: 999px;
    background: var(--texto);
    color: var(--fundo);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.3s;
  }
  .aparelho-botao:hover {
    background: var(--cor);
  }
  .aparelho-codigo {
    color: var(--texto-suave);
  }

  /* ---------- com 3D: palco preso na tela ---------- */
  .aparelho.ativo .aparelho-palco {
    position: relative;
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    align-items: center;
    height: 100svh;
    padding: 90px 0 30px;
  }
  .aparelho.ativo .aparelho-3d {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 0;
  }
  /* brilho na cor do site atrás do notebook */
  .aparelho.ativo .aparelho-luz {
    display: block;
    position: absolute;
    left: 5%;
    top: 20%;
    width: 50%;
    height: 60%;
    border-radius: 50%;
    background: var(--cor);
    opacity: 0.22;
    filter: blur(80px);
    transition: background-color 0.8s;
  }
  .aparelho.ativo .aparelho-infos {
    position: relative;
    display: block;
    height: 100%;
  }
  .aparelho.ativo .aparelho-info {
    position: absolute;
    inset: 50% 0 auto;
    padding: 0;
    border: 0;
    background: none;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-40%);
    transition:
      opacity 0.6s,
      transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
      visibility 0.6s;
  }
  .aparelho.ativo .aparelho-info.ativa {
    opacity: 1;
    visibility: visible;
    transform: translateY(-50%);
  }
  .aparelho.ativo .aparelho-print {
    display: none; /* o print está na tela do notebook */
  }
  .aparelho.ativo .aparelho-pontos {
    position: absolute;
    left: 0;
    bottom: 8%;
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .aparelho-pontos li {
    width: 28px;
    height: 3px;
    border-radius: 3px;
    background: var(--linha);
    transition: background-color 0.4s;
  }
  .aparelho-pontos li.ativa {
    background: var(--cor);
  }

  @media (max-width: 760px) {
    .aparelho.ativo .aparelho-palco {
      grid-template-columns: 1fr;
      grid-template-rows: 1fr auto;
      padding-top: 70px;
    }
    .aparelho.ativo .aparelho-infos {
      height: 36svh;
    }
    .aparelho.ativo .aparelho-info {
      inset: 0 0 auto;
      transform: translateY(12px);
    }
    .aparelho.ativo .aparelho-info.ativa {
      transform: none;
    }
    .aparelho.ativo .aparelho-pontos {
      bottom: 0;
    }
    /* no celular o brilho é um degradê: blur(80px) numa área grande é caro de compor */
    .aparelho.ativo .aparelho-luz {
      filter: none;
      background: radial-gradient(closest-side, var(--cor), transparent);
      opacity: 0.3;
    }
  }
</style>

<script>
  import { ScrollTrigger, prioridade, remedir } from '../../lib/movimento';

  const raiz = document.querySelector<HTMLElement>('.aparelho');
  const semMovimento = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (raiz && !semMovimento) {
    const celular = matchMedia('(max-width: 760px)').matches;
    const urls: string[] = JSON.parse((celular && raiz.dataset.urlsCelular) || raiz.dataset.urls!);
    const cores: string[] = JSON.parse(raiz.dataset.cores!);
    const infos = [...raiz.querySelectorAll<HTMLElement>('.aparelho-info')];
    const pontos = [...raiz.querySelectorAll<HTMLElement>('.aparelho-pontos li')];
    const n = urls.length;

    // o notebook 3D só monta depois da intro e quando a seção chega perto da tela: assim ele não
    // disputa a abertura com a câmera 3D (a página trava menos ao abrir)
    const depoisDaIntro = new Promise<void>((ok) => {
      const html = document.documentElement;
      if (!html.classList.contains('intro-on') && !html.classList.contains('intro-saindo')) return ok();
      document.addEventListener('intro:fim', () => ok(), { once: true });
      setTimeout(ok, 15000); // segurança: a intro nunca passa disso
    });
    // e espera o navegador respirar (o mural ainda está terminando de aparecer)
    const folga = () =>
      new Promise<void>((ok) => ('requestIdleCallback' in window ? requestIdleCallback(() => ok(), { timeout: 1500 }) : setTimeout(ok, 600)));
    const perto = new Promise<void>((ok) => {
      const olho = new IntersectionObserver(
        ([e]) => {
          if (!e.isIntersecting) return;
          olho.disconnect();
          ok();
        },
        { rootMargin: '150% 0px' },
      );
      olho.observe(raiz);
    });

    Promise.all([depoisDaIntro, perto])
      .then(folga)
      .then(() => import('../../lib/aparelho3d'))
      .then(({ montarAparelho }) => {
        raiz.classList.add('ativo'); // liga o layout de palco antes de medir o canvas
        return montarAparelho(raiz.querySelector('canvas')!, urls);
      })
      .then((aparelho) => {
        const faixa = (p: number, de: number, ate: number) => Math.min(1, Math.max(0, (p - de) / (ate - de)));
        let atual = -1;
        ScrollTrigger.create({
          trigger: raiz,
          start: 'top top',
          end: `+=${(n + 1) * 90}%`,
          pin: raiz.querySelector('.aparelho-palco'),
          refreshPriority: prioridade(raiz),
          scrub: true,
          onUpdate: ({ progress: p }) => {
            const abrir = faixa(p, 0, 0.18);
            const q = faixa(p, 0.18, 1) * n;
            const i = Math.min(n - 1, Math.floor(q));
            const local = q - i;
            const ultimo = i === n - 1;
            aparelho.definir({
              abrir,
              a: i,
              b: ultimo ? i : i + 1,
              mistura: ultimo ? 0 : faixa(local, 0.82, 1),
              rolarA: faixa(local, 0.08, ultimo ? 0.95 : 0.8),
              cor: cores[i],
            });
            if (i !== atual) {
              atual = i;
              infos.forEach((el, k) => el.classList.toggle('ativa', k === i));
              pontos.forEach((el, k) => el.classList.toggle('ativa', k === i));
              raiz.style.setProperty('--cor', cores[i]);
            }
          },
        });
        remedir(); // criado depois das seções de baixo: volta para a ordem da página
      })
      .catch(() => raiz.classList.remove('ativo')); // sem WebGL: cartões normais
  }
</script>
