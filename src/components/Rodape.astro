---
import { site } from '../data/site';
import { url } from '../lib/url';

const ano = new Date().getFullYear();
const { instagram, whatsapp } = site.contato;
const cidade = site.cidade.split(',')[0];
---

<footer class="rodape">
  <div class="container">
    <div class="rodape-topo">
      <div class="assinatura">
        <p class="rotulo">{cidade} · Fotografia & código</p>
        <a class="nome-grande" href={url('/')}>{site.nome}</a>
      </div>

      <button class="topo-botao" type="button" aria-label="Voltar ao topo">
        <span class="topo-fundo" aria-hidden="true"></span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6"></path></svg>
      </button>
    </div>

    <div class="rodape-meio">
      <a class="canal" href={`https://instagram.com/${instagram}`} target="_blank" rel="noopener">
        <span class="rotulo">Instagram</span>
        <span class="canal-valor">@{instagram} <i aria-hidden="true">↗</i></span>
      </a>
      <a class="canal" href={`https://wa.me/${whatsapp}`} target="_blank" rel="noopener">
        <span class="rotulo">WhatsApp</span>
        <span class="canal-valor">Mandar mensagem <i aria-hidden="true">↗</i></span>
      </a>
      <a class="canal" href={`${url('/')}#sites`}>
        <span class="rotulo">Também faço</span>
        <span class="canal-valor">Sites de portfólio <i aria-hidden="true">→</i></span>
      </a>
    </div>

    <div class="rodape-base">
      <p>© {ano} {site.nome}. Fotos e código feitos por mim.</p>
      <p>Feito com café, luz baixa e <span class="coracao">♥</span> em {cidade}</p>
    </div>
  </div>
</footer>

<script>
  document.querySelector('.topo-botao')?.addEventListener('click', () => {
    const semMovimento = matchMedia('(prefers-reduced-motion: reduce)').matches;
    scrollTo({ top: 0, behavior: semMovimento ? 'auto' : 'smooth' });
  });
</script>

<style>
  .rodape {
    margin-top: 8rem;
    padding-block: clamp(56px, 9vh, 96px) 2rem;
    border-top: 1px solid var(--linha);
    background: radial-gradient(ellipse at 15% 100%, rgb(var(--brilho) / 0.18), transparent 55%);
  }

  .rodape-topo {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .nome-grande {
    display: inline-block;
    margin-top: 0.8rem;
    font-family: var(--fonte-titulo);
    font-style: italic;
    font-size: clamp(3rem, 10vw, 8rem);
    line-height: 0.95;
    transition: color 0.4s;
  }

  .nome-grande:hover {
    color: var(--destaque);
  }

  /* Botão de voltar ao topo (mesmo estilo das outras setas) */
  .topo-botao {
    position: relative;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    padding: 0;
    border: 1px solid rgb(236 233 242 / 0.35);
    border-radius: 50%;
    background: none;
    color: var(--texto);
    overflow: hidden;
    cursor: pointer;
  }

  .topo-fundo {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--destaque-forte);
    transform: scale(0);
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .topo-botao svg {
    position: relative;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @media (hover: hover) {
    .topo-botao:hover .topo-fundo {
      transform: scale(1);
    }

    .topo-botao:hover svg {
      translate: 0 -3px;
    }
  }

  .rodape-meio {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: clamp(40px, 7vh, 72px);
    border-top: 1px solid var(--linha);
  }

  .canal {
    display: grid;
    gap: 0.5rem;
    padding: 1.6rem 1.5rem 1.6rem 0;
    border-bottom: 1px solid var(--linha);
    transition: background-size 0.5s;
    background: linear-gradient(90deg, rgb(var(--brilho) / 0.12), transparent) no-repeat;
    background-size: 0% 100%;
  }

  .canal + .canal {
    padding-left: 1.5rem;
    border-left: 1px solid var(--linha);
  }

  .canal-valor {
    font-family: var(--fonte-titulo);
    font-style: italic;
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    transition: color 0.3s;
  }

  .canal-valor i {
    display: inline-block;
    font-family: var(--fonte-texto);
    font-style: normal;
    font-size: 0.7em;
    color: var(--destaque);
    transition: translate 0.3s;
  }

  .canal:hover {
    background-size: 100% 100%;
  }

  .canal:hover .canal-valor {
    color: var(--destaque);
  }

  .canal:hover .canal-valor i {
    translate: 3px -3px;
  }

  .rodape-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.8rem 2rem;
    padding-top: 1.8rem;
    font-size: 0.78rem;
    color: var(--texto-suave);
  }

  .rodape-base p {
    margin: 0;
  }

  .coracao {
    color: var(--destaque);
  }

  @media (max-width: 760px) {
    .rodape-meio {
      grid-template-columns: 1fr;
    }

    .canal + .canal {
      padding-left: 0;
      border-left: 0;
    }

    .topo-botao {
      width: 52px;
      height: 52px;
    }
  }
</style>
