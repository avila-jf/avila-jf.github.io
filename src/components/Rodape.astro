---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import { fotosDa } from '../lib/fotos';
import { url } from '../lib/url';

const ano = new Date().getFullYear();
const { instagram, whatsapp } = site.contato;
const cidade = site.cidade.split(',')[0];
// Paisagem de fundo do rodapé (ideia do "Scenic footer" do Inspora), pintada de azul pelo CSS
const paisagens = fotosDa('paisagem');
const fundo = paisagens[1] ?? paisagens[0];
---

<footer class="rodape">
  {
    fundo && (
      <div class="rodape-paisagem" aria-hidden="true">
        <!-- Filtro "gravura": tira a cor, reduz a poucos tons (como tinta de impressão), mexe as bordas
             de leve (traço feito à mão) e pinta de azul-marinho sobre papel creme -->
        <svg width="0" height="0" style="position:absolute">
          <filter id="gravura" color-interpolation-filters="sRGB">
            <feColorMatrix in="SourceGraphic" type="saturate" values="0" />
            <feComponentTransfer>
              <feFuncR type="discrete" tableValues="0 0.18 0.36 0.6 0.82 1" />
              <feFuncG type="discrete" tableValues="0 0.18 0.36 0.6 0.82 1" />
              <feFuncB type="discrete" tableValues="0 0.18 0.36 0.6 0.82 1" />
            </feComponentTransfer>
            <!-- escuro → azul-marinho (#0e2a5c), claro → creme (#ece4cf) -->
            <feColorMatrix
              type="matrix"
              values="0.87 0 0 0 0.055
                      0.73 0 0 0 0.165
                      0.45 0 0 0 0.36
                      0    0 0 1 0"
              result="tinta"
            />
            <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="1" seed="4" result="ruido" />
            <feDisplacementMap in="tinta" in2="ruido" scale="3" xChannelSelector="R" yChannelSelector="G" />
          </filter>
        </svg>
        <Image src={fundo.src} alt="" widths={[800, 1400, 2000]} sizes="100vw" format="webp" quality={70} loading="lazy" />
      </div>
    )
  }
  <div class="container">
    <div class="rodape-topo">
      <div class="assinatura">
        <p class="rotulo">{cidade} · Fotografia & código</p>
        <!-- Assinatura que se escreve sozinha quando aparece (componente Signature do Spell UI) -->
        <a class="nome-grande" href={url('/')} aria-label={site.nome}>
          <svg viewBox="0 0 860 190" aria-hidden="true"><text x="6" y="148">{site.nome}</text></svg>
        </a>
      </div>

      <button class="topo-botao" type="button" aria-label="Voltar ao topo">
        <span class="topo-fundo" aria-hidden="true"></span>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6"></path></svg>
      </button>
    </div>

    <div class="rodape-meio">
      <a class="canal" href={`https://instagram.com/${instagram}`} target="_blank" rel="noopener">
        <span class="rotulo">Instagram</span>
        <span class="canal-valor">@{instagram} <i aria-hidden="true">↗</i></span>
      </a>
      <a class="canal" href={`https://wa.me/${whatsapp}`} target="_blank" rel="noopener">
        <span class="rotulo">WhatsApp</span>
        <span class="canal-valor">Mandar mensagem <i aria-hidden="true">↗</i></span>
      </a>
      <a class="canal" href={`${url('/')}#sites`}>
        <span class="rotulo">Também faço</span>
        <span class="canal-valor">Sites de portfólio <i aria-hidden="true">→</i></span>
      </a>
    </div>

    <div class="rodape-base">
      <p>© {ano} {site.nome}. Fotos e código feitos por mim.</p>
      <p>Feito com café, luz baixa e <span class="coracao">♥</span> em {cidade}</p>
    </div>
  </div>
</footer>

<script>
  // Assinatura: começa a "escrever" quando o rodapé aparece
  const nome = document.querySelector('.nome-grande');
  if (nome) {
    new IntersectionObserver(
      ([e], obs) => {
        if (!e.isIntersecting) return;
        nome.classList.add('escrever');
        obs.disconnect();
      },
      { threshold: 0.6 },
    ).observe(nome);
  }

  document.querySelector('.topo-botao')?.addEventListener('click', () => {
    const semMovimento = matchMedia('(prefers-reduced-motion: reduce)').matches;
    scrollTo({ top: 0, behavior: semMovimento ? 'auto' : 'smooth' });
  });
</script>

<style>
  .rodape {
    position: relative;
    margin-top: 8rem;
    padding-block: clamp(56px, 9vh, 96px) 2rem;
    border-top: 1px solid var(--linha);
    background: radial-gradient(ellipse at 15% 100%, rgb(var(--brilho) / 0.18), transparent 55%);
    overflow: hidden;
  }

  .rodape > .container {
    position: relative;
    z-index: 1;
    text-shadow: 0 1px 12px rgb(3 5 11 / 0.7); /* texto legível por cima do creme da gravura */
  }

  /* Paisagem em duotom azul, sumindo para cima no fundo da página */
  .rodape-paisagem {
    position: absolute;
    inset: 0;
    -webkit-mask: linear-gradient(to bottom, transparent 0%, #000 40%);
    mask: linear-gradient(to bottom, transparent 0%, #000 40%);
  }

  /* Paisagem como gravura em azul e creme (ideia do "Scenic footer" do Inspora) */
  .rodape-paisagem img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 60%;
    filter: contrast(1.25) url(#gravura);
  }

  /* hachuras finas por cima, como os riscos de uma gravura em metal */
  .rodape-paisagem::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(118deg, rgb(14 42 102 / 0.32) 0 1px, transparent 1px 3.5px),
      repeating-linear-gradient(28deg, rgb(14 42 102 / 0.12) 0 1px, transparent 1px 5px);
    mix-blend-mode: multiply;
  }

  .rodape-paisagem::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(to right, rgb(3 5 11 / 0.78), rgb(3 5 11 / 0.35) 45%, transparent 75%),
      linear-gradient(to top, rgb(3 5 11 / 0.7), transparent 35%);
  }

  /* ---------- Assinatura escrita à mão ---------- */
  .nome-grande svg {
    display: block;
    width: min(100%, 760px);
    height: auto;
    overflow: visible;
  }

  .nome-grande text {
    font-family: var(--fonte-titulo);
    font-style: italic;
    font-weight: 500;
    font-size: 150px;
    fill: transparent;
    stroke: var(--texto);
    stroke-width: 1.4px;
    stroke-dasharray: 1400;
    stroke-dashoffset: 1400;
    transition: fill 0.4s;
  }

  .nome-grande.escrever text {
    animation:
      escrever 3s cubic-bezier(0.5, 0, 0.3, 1) forwards,
      preencher 0.9s 2.4s ease forwards;
  }

  .nome-grande:hover text {
    fill: var(--destaque);
    stroke: var(--destaque);
  }

  @keyframes escrever {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes preencher {
    to {
      fill: var(--texto);
      stroke-width: 0.4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nome-grande text {
      stroke-dashoffset: 0;
      fill: var(--texto);
    }

    .nome-grande.escrever text {
      animation: none;
    }
  }

  .rodape-topo {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }

  .assinatura {
    flex: 1;
    min-width: 0;
  }

  .nome-grande {
    display: block;
    margin-top: 0.8rem;
  }

  /* Botão de voltar ao topo (mesmo estilo das outras setas) */
  .topo-botao {
    position: relative;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    padding: 0;
    border: 1px solid rgb(236 233 242 / 0.35);
    border-radius: 50%;
    background: none;
    color: var(--texto);
    overflow: hidden;
    cursor: pointer;
  }

  .topo-fundo {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--destaque-forte);
    transform: scale(0);
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .topo-botao svg {
    position: relative;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: translate 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  @media (hover: hover) {
    .topo-botao:hover .topo-fundo {
      transform: scale(1);
    }

    .topo-botao:hover svg {
      translate: 0 -3px;
    }
  }

  .rodape-meio {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: clamp(40px, 7vh, 72px);
    border-top: 1px solid var(--linha);
  }

  .canal {
    display: grid;
    gap: 0.5rem;
    padding: 1.6rem 1.5rem 1.6rem 0;
    border-bottom: 1px solid var(--linha);
    transition: background-size 0.5s;
    background: linear-gradient(90deg, rgb(var(--brilho) / 0.12), transparent) no-repeat;
    background-size: 0% 100%;
  }

  .canal + .canal {
    padding-left: 1.5rem;
    border-left: 1px solid var(--linha);
  }

  .canal-valor {
    font-family: var(--fonte-titulo);
    font-style: italic;
    font-size: clamp(1.3rem, 2.2vw, 1.8rem);
    transition: color 0.3s;
  }

  .canal-valor i {
    display: inline-block;
    font-family: var(--fonte-texto);
    font-style: normal;
    font-size: 0.7em;
    color: var(--destaque);
    transition: translate 0.3s;
  }

  .canal:hover {
    background-size: 100% 100%;
  }

  .canal:hover .canal-valor {
    color: var(--destaque);
  }

  .canal:hover .canal-valor i {
    translate: 3px -3px;
  }

  .rodape-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.8rem 2rem;
    padding-top: 1.8rem;
    font-size: 0.78rem;
    color: var(--texto-suave);
  }

  .rodape-base p {
    margin: 0;
  }

  .coracao {
    color: var(--destaque);
  }

  @media (max-width: 760px) {
    .rodape-meio {
      grid-template-columns: 1fr;
    }

    .canal + .canal {
      padding-left: 0;
      border-left: 0;
    }

    .topo-botao {
      width: 52px;
      height: 52px;
    }
  }
</style>
