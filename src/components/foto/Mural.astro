---
// Mural de fotos da abertura (pegada omrimalka.art): uma parede de fotos maior que a tela.
// Todas as fotos ficam em gravura azul (duotone azul royal + creme, com hachura fina).
//  - Computador: a parede corre conforme o mouse e é curva (3D): a foto do meio fica de frente e as
//    das bordas recuam e viram. A foto sob o mouse ganha cor e chega pra frente; o nome e o ensaio
//    dela aparecem embaixo à esquerda.
//  - Celular: a parede do omrimalka no telefone, com os mesmos números do site dele. Uma lente em
//    barril (o meio maior, as bordas comprimidas), a foto que passa pelo meio cresce e troca o recorte
//    quase reto por um torto (parece que gira) e a parede é infinita. Parado em gravura até o
//    "Vamos colocar uma cor?": aí vira a tela inteira e anda pra qualquer lado (dedo ou rodinha);
//    só volta a ficar parado (e a página a rolar) no "voltar pro azul".
//    Começa em gravura azul com o cartão do título no meio; o botão brilhando "Vamos colocar uma cor?"
//    colore as fotos numa onda que sai do meio e escurece o fundo, como o dele.
//  - Clicar/tocar numa foto abre o detalhe: um painel colorido inclinado com a foto em cor, o nome,
//    o ensaio e o link para o ensaio (como o detalhe das peças no omrimalka).
// Botão "embaralhar" (o shuffle do omrimalka): as fotos trocam de lugar deslizando.
// No meio, um cartão com a frase. Quem revela o mural é a Intro (evento "mural:revelar").
import { Image, getImage } from 'astro:assets';
import type { Foto } from '../../lib/fotos';
import { categorias } from '../../data/site';
import { url } from '../../lib/url';

interface Props {
  fotos: Foto[];
  totalFotos: number;
}

const { fotos, totalFotos } = Astro.props;

// 12 x 6 casas, 4 delas são do cartão do meio: 68 fotos (repete se faltar)
const CASAS = 68;
const lista = Array.from({ length: CASAS }, (_, i) => fotos[i % fotos.length]).filter(Boolean);
const ensaioDe = (slug: string) => categorias.find((c) => c.slug === slug)?.titulo ?? slug;
const totalDe = (slug: string) => fotos.filter((f) => f.categoria === slug).length;

// versão grande (para o detalhe), uma por foto
const grandes = new Map<string, string>();
for (const f of fotos) {
  grandes.set(`${f.categoria}/${f.nome}`, (await getImage({ src: f.src, width: 1000, format: 'webp', quality: 78 })).src);
}

// cor do painel de detalhe de cada ensaio
const CORES: Record<string, string> = {
  pedras: '#c8553d',
  jaragua: '#6b4fa8',
  carneiros: '#2f8a68',
  ato: '#b3304d',
  estudio: '#1f3f99',
};
---

<section class="mural" data-trava data-lente="foto" data-tema="claro" aria-label="Photo wall">
  <div class="mural-palco">
    <div class="mural-centro">
      <div class="mural-grade">
        <div class="mural-cartao">
          <span class="rotulo">Francis Avila · Maceió</span>
          <h1 class="mural-titulo">Through my <span class="voz-foto">lens.</span></h1>
          <span class="rotulo">{categorias.length} series · {totalFotos} photos</span>
        </div>
        {
          lista.map((f, i) => (
            <figure
              class="mural-foto"
              tabindex="0"
              data-ensaio={ensaioDe(f.categoria)}
              data-slug={f.categoria}
              data-total={totalDe(f.categoria)}
              data-grande={grandes.get(`${f.categoria}/${f.nome}`)}
              data-cor={CORES[f.categoria] ?? '#1f3f99'}
            >
              <Image src={f.src} alt={f.alt} widths={[240, 400, 560]} sizes="(max-width: 760px) 46vw, 14vw" format="webp" loading={i < 24 ? 'eager' : 'lazy'} />
            </figure>
          ))
        }
      </div>
    </div>
    <!-- o selo no meio da bola de fotos, no fim da tela travada (só no computador) -->
    <div class="mural-hex" aria-hidden="true">
      <span class="rotulo">Photos</span>
      <b class="titulo-cartaz">'26</b>
      <span class="mural-hex-nome voz-codigo"></span>
    </div>
  </div>
  <p class="mural-legenda" aria-live="polite"><b></b><span class="rotulo"></span></p>
  <div class="mural-dica">
    <p class="rotulo dica-pc" aria-hidden="true">move the mouse · click a photo to open it</p>
    <button class="mural-embaralhar rotulo" type="button">shuffle ↻</button>
  </div>
  <button class="mural-cor" type="button" aria-pressed="false"><span>Shall we add some color?</span></button>

  <!-- detalhe da foto -->
  <div class="detalhe" role="dialog" aria-modal="true" aria-label="Photo" hidden>
    <div class="detalhe-fundo" data-fechar-detalhe></div>
    <button class="detalhe-fechar" type="button" aria-label="Close" data-fechar-detalhe>✕</button>
    <div class="detalhe-painel">
      <figure class="detalhe-foto"><img alt="" /></figure>
      <div class="detalhe-texto">
        <h2 class="detalhe-titulo"></h2>
        <p class="detalhe-ensaio"></p>
        <div class="detalhe-tags"><span class="tag-ensaio"></span><span class="tag-total"></span></div>
        <a class="detalhe-link" href="#">see the series →</a>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ base: url('/') }}>
  window.__baseMural = base;
</script>

<style>
  .mural {
    position: relative;
    height: 100svh;
    margin: -110px calc(var(--margem) * -1) 40px; /* sai do padding do <main>: ocupa a tela toda */
  }
  .mural-palco {
    position: relative;
    height: 100%;
    overflow: hidden;
    background: var(--fundo); /* o mesmo branco quente do site entre as fotos */
    perspective: 1100px;
  }
  /* a caixa de fora só centraliza; a grade de dentro só anda (GSAP).
     Separados porque o GSAP reescreve o transform inteiro de quem ele anima. */
  .mural-centro {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    transform-style: preserve-3d;
    pointer-events: none;
  }
  .mural-grade {
    --lado: clamp(150px, 13vw, 240px);
    transform-style: preserve-3d;
    pointer-events: none; /* as casas recuam para trás do plano da grade: o mouse tem que chegar nelas */
    display: grid;
    grid-template-columns: repeat(12, var(--lado));
    grid-auto-rows: var(--lado);
    gap: 6px;
    will-change: transform;
  }

  /* ---------- foto em gravura azul ---------- */
  .mural-foto {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: 6px;
    isolation: isolate;
    background: var(--gravura);
    cursor: pointer;
    pointer-events: auto;
    scale: var(--r, 1); /* a revelação da intro anima o --r; o transform é da curvatura 3D */
  }
  .mural-foto img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.25) brightness(1.06);
    transition:
      filter 0.6s ease,
      transform 1s cubic-bezier(0.2, 0.7, 0.2, 1);
    -webkit-user-drag: none;
    user-select: none;
  }
  /* claro vira creme (com hachura fina de gravura) e escuro vira azul royal */
  .mural-foto::before,
  .mural-foto::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: opacity 0.6s ease;
  }
  .mural-foto::before {
    background:
      repeating-linear-gradient(-35deg, rgb(12 21 48 / 0.16) 0 1px, transparent 1px 4px),
      var(--creme);
    mix-blend-mode: multiply;
  }
  .mural-foto::after {
    background: var(--gravura);
    mix-blend-mode: lighten;
  }
  /* em cor: sob o mouse (computador) ou com foco do teclado */
  @media (hover: hover) {
    .mural-foto:hover img {
      filter: none;
      transform: scale(1.06);
    }
    .mural-foto:hover::before,
    .mural-foto:hover::after {
      opacity: 0;
    }
  }
  /* rolando: a onda de cor sai do meio (o JS marca cada foto quando a onda passa por ela) */
  .mural-foto:global(.colorida) img {
    filter: none;
  }
  .mural-foto:global(.colorida)::before,
  .mural-foto:global(.colorida)::after {
    opacity: 0;
  }
  /* no anel do hexágono, a foto que passa no topo ganha uma borda */
  .mural-foto:global(.no-topo) {
    box-shadow:
      0 0 0 2px var(--creme),
      0 20px 50px -20px rgb(12 21 48 / 0.6);
  }
  .mural-foto:focus-visible img {
    filter: none;
  }

  /* ---------- o selo no meio da bola (aparece quando as fotos se juntam) ---------- */
  .mural-hex {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    width: min(15vw, 150px);
    aspect-ratio: 1;
    translate: -50% -50%;
    text-align: center;
    clip-path: circle(50%);
    background: var(--linha);
    opacity: 0;
    pointer-events: none;
  }
  .mural-hex::before {
    content: '';
    position: absolute;
    inset: 1px;
    z-index: -1;
    clip-path: inherit;
    background: var(--fundo);
  }
  .mural-hex b {
    font-size: min(4.6vw, 46px);
    line-height: 0.9;
  }
  .mural-hex-nome {
    max-width: 80%;
    font-size: 12px;
  }
  .mural-foto:focus-visible::before,
  .mural-foto:focus-visible::after {
    opacity: 0;
  }

  /* ---------- cartão do meio ---------- */
  .mural-cartao {
    grid-column: 6 / span 2;
    grid-row: 3 / span 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 12px;
    padding: clamp(16px, 1.6vw, 26px);
    border-radius: 6px;
    background: var(--creme);
    color: var(--gravura);
    pointer-events: auto;
    scale: var(--r, 1);
  }
  .mural-titulo {
    margin: 0;
    font-size: calc(var(--lado) * 0.21);
    font-weight: 700;
    font-stretch: 75%;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .mural-titulo .voz-codigo {
    font-size: 0.82em;
    font-weight: 500;
  }
  .mural-cartao .rotulo {
    color: var(--gravura);
    opacity: 0.75;
    font-size: 10px;
  }

  /* nome e ensaio da foto em destaque (como o título da peça no omrimalka) */
  .mural-legenda {
    position: absolute;
    left: var(--margem);
    bottom: 22px;
    z-index: 2;
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 10px 14px;
    border-radius: 10px;
    background: rgb(247 245 240 / 0.9);
    color: var(--gravura);
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.3s,
      transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
    pointer-events: none;
  }
  .mural-legenda.ativa {
    opacity: 1;
    transform: none;
  }
  .mural-legenda b {
    font-size: 22px;
    font-weight: 800;
    font-stretch: 75%;
    line-height: 1;
    text-transform: lowercase;
  }
  .mural-legenda .rotulo {
    color: var(--gravura);
    opacity: 0.7;
  }

  .mural-dica {
    position: absolute;
    left: 50%;
    bottom: 20px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 4px 4px 14px;
    border-radius: 999px;
    background: rgb(241 230 204 / 0.94);
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .mural-dica p {
    margin: 0;
    color: var(--gravura);
  }
  .mural-embaralhar {
    padding: 7px 12px;
    border: 0;
    border-radius: 999px;
    background: var(--gravura);
    color: var(--creme);
    cursor: pointer;
    transition: background-color 0.3s;
  }
  .mural-embaralhar:hover {
    background: var(--texto);
  }
  /* intro rodando: o mural espera escondido pelo "clique" */
  :global(html.intro-on) .mural-foto,
  :global(html.intro-on) .mural-cartao,
  :global(html.intro-on) .mural-dica {
    opacity: 0;
  }

  /* ---------- detalhe da foto: painel colorido inclinado ---------- */
  .detalhe {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: grid;
    place-items: center;
    padding: 24px;
  }
  .detalhe[hidden] {
    display: none;
  }
  .detalhe-fundo {
    position: absolute;
    inset: 0;
    background: rgb(12 21 48 / 0.5);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .detalhe-fechar {
    position: absolute;
    top: 18px;
    left: 50%;
    z-index: 3;
    width: 52px;
    height: 52px;
    margin-left: -26px;
    border: 0;
    background: none;
    color: #fff;
    font-size: 34px;
    line-height: 1;
    cursor: pointer;
    transition: transform 0.4s cubic-bezier(0.2, 0.9, 0.3, 1.4);
  }
  .detalhe-fechar:hover {
    transform: rotate(90deg) scale(1.1);
  }
  .detalhe-painel {
    --cor: var(--gravura);
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(20px, 4vw, 56px);
    width: min(1040px, 94vw);
    margin-top: 40px;
    padding: clamp(24px, 4vw, 56px);
    background: var(--cor);
    color: #fff;
    transform: rotate(-1.4deg);
    box-shadow: 0 40px 90px -40px rgb(0 0 0 / 0.6);
  }
  .detalhe-foto {
    margin: 0;
    transform: rotate(2.4deg);
    box-shadow: 0 30px 50px -25px rgb(0 0 0 / 0.6);
  }
  .detalhe-foto img {
    display: block;
    width: 100%;
    max-height: 62svh;
    object-fit: cover;
    border-radius: 4px;
  }
  .detalhe-texto {
    display: grid;
    gap: 12px;
  }
  .detalhe-titulo {
    margin: 0;
    font-size: clamp(32px, 4vw, 60px);
    font-weight: 800;
    font-stretch: 75%;
    line-height: 0.95;
    text-transform: lowercase;
  }
  .detalhe-ensaio {
    margin: 0;
    font-size: 15px;
    opacity: 0.85;
  }
  .detalhe-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .detalhe-tags span {
    padding: 5px 10px;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.88);
    color: #111;
    font: 700 11px/1 var(--fonte);
  }
  .detalhe-link {
    justify-self: start;
    margin-top: 8px;
    padding-bottom: 3px;
    border-bottom: 2px solid currentColor;
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }

  /* botão "Vamos colocar uma cor?": só no celular (no computador o mouse já colore) */
  .mural-cor {
    display: none;
  }

  /* ---------- celular: a parede do omrimalka ---------- */
  @media (max-width: 760px), (hover: none) {
    .mural-palco {
      perspective: none;
      touch-action: pan-y; /* parado: a página rola normal */
      transition: background-color 0.9s ease;
    }
    .mural-centro,
    .mural-grade {
      transform-style: flat;
    }
    .mural-grade {
      --lado: 26vw;
      grid-template-columns: repeat(8, var(--lado));
      gap: 6px;
      will-change: auto;
    }
    .mural-foto,
    .mural-cartao {
      transform-origin: 50% 50%;
      will-change: transform;
      transition: clip-path 0.46s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    /* chegando no meio: o recorte entorta com mola (o "girar" do omrimalka) */
    .mural-foto.perto {
      transition: clip-path 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .mural-cartao {
      grid-column: 4 / span 2;
      grid-row: 4 / span 2;
      padding: 12px;
      gap: 6px;
    }
    .mural-titulo {
      font-size: calc(var(--lado) * 0.17);
    }
    .mural-cartao .rotulo {
      font-size: 8px;
    }

    /* em cor: o mural vira a tela inteira, solto pra qualquer lado, e o fundo escurece;
       a onda de cor sai do meio (cada foto espera --atraso) */
    .mural.em-cor .mural-palco {
      position: fixed;
      inset: 0;
      z-index: 45; /* abaixo da barra */
      background: #0b0f1e;
      touch-action: none;
      transform: none !important;
      border-radius: 0 !important;
    }
    .mural.em-cor .mural-legenda,
    .mural.em-cor .mural-dica,
    .mural.em-cor .mural-cor {
      position: fixed;
      z-index: 46;
    }
    :global(html.mural-em-cor) {
      overflow: hidden;
      overscroll-behavior: none;
    }
    .mural-foto img,
    .mural-foto::before,
    .mural-foto::after {
      transition-delay: var(--atraso, 0ms);
    }
    .mural.em-cor .mural-foto img {
      filter: none;
    }
    .mural.em-cor .mural-foto::before,
    .mural.em-cor .mural-foto::after {
      opacity: 0;
    }

    /* legenda e embaralhar no canto de baixo, como no omrimalka */
    .mural-legenda {
      left: 12px;
      right: auto;
      bottom: calc(max(16px, env(safe-area-inset-bottom)) + 162px);
    }
    .mural-legenda b {
      font-size: 19px;
    }
    .mural-dica {
      left: 12px;
      bottom: calc(max(16px, env(safe-area-inset-bottom)) + 124px);
      padding: 0;
      background: none;
      transform: none;
    }
    .dica-pc {
      display: none;
    }
    .mural-embaralhar {
      border-radius: 4px;
      background: #fff;
      color: #111;
      box-shadow: 0 6px 16px -8px rgb(0 0 0 / 0.5);
    }

    /* "Vamos colocar uma cor?" brilhando embaixo */
    .mural-cor {
      position: absolute;
      left: 50%;
      bottom: calc(max(16px, env(safe-area-inset-bottom)) + 74px);
      z-index: 3;
      display: block;
      padding: 11px 18px;
      border: 0;
      border-radius: 999px;
      background: var(--gravura);
      transform: translateX(-50%);
      white-space: nowrap;
      cursor: pointer;
      animation: brilho-botao 2.4s ease-in-out infinite;
    }
    .mural-cor span {
      font: 700 14px/1 var(--fonte);
      background: linear-gradient(100deg, var(--creme) 30%, #fff 50%, var(--creme) 70%);
      background-size: 250% 100%;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      animation: brilho-texto 2.4s linear infinite;
    }
    .mural.em-cor .mural-cor {
      background: rgb(255 255 255 / 0.92);
      animation: none;
    }
    .mural.em-cor .mural-cor span {
      background: none;
      color: #111;
      animation: none;
    }
    @keyframes brilho-texto {
      from {
        background-position: 120% 0;
      }
      to {
        background-position: -120% 0;
      }
    }
    @keyframes brilho-botao {
      0%,
      100% {
        box-shadow: 0 0 0 0 rgb(31 63 153 / 0.45), 0 10px 24px -10px rgb(31 63 153 / 0.7);
      }
      50% {
        box-shadow: 0 0 0 7px rgb(31 63 153 / 0), 0 10px 30px -8px rgb(106 169 236 / 0.9);
      }
    }
    :global(html.intro-on) .mural-cor {
      opacity: 0;
    }
    .detalhe {
      padding: 0;
      align-items: start;
    }
    .detalhe-fechar {
      top: 8px;
    }
    .detalhe-painel {
      grid-template-columns: 1fr;
      width: 92vw;
      max-height: calc(100svh - 80px);
      margin-top: 64px;
      padding: 22px 20px 26px;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: none;
      gap: 18px;
    }
    .detalhe-foto img {
      max-height: 48svh;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { Flip } from 'gsap/Flip';
  import { prioridade } from '../../lib/movimento';

  gsap.registerPlugin(ScrollTrigger, Flip);

  const mural = document.querySelector<HTMLElement>('.mural');
  if (mural) {
    const raiz = document.documentElement;
    const palco = mural.querySelector<HTMLElement>('.mural-palco')!;
    const grade = mural.querySelector<HTMLElement>('.mural-grade')!;
    const fotos = [...mural.querySelectorAll<HTMLElement>('.mural-foto')];
    const casas = [mural.querySelector<HTMLElement>('.mural-cartao')!, ...fotos];
    const legenda = mural.querySelector<HTMLElement>('.mural-legenda')!;
    const semMovimento = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const comMouse = matchMedia('(hover: hover) and (pointer: fine) and (min-width: 761px)').matches;
    const lenis = () => (window as unknown as { lenis?: { stop(): void; start(): void } }).lenis;

    // centro de cada casa em relação ao meio da grade (a grade só anda por transform, então isso
    // não muda enquanto ela anda; mede de novo no resize e depois de embaralhar)
    let centros: { x: number; y: number }[] = [];
    const medir = () => {
      const meioX = grade.offsetWidth / 2;
      const meioY = grade.offsetHeight / 2;
      centros = casas.map((c) => ({ x: c.offsetLeft + c.offsetWidth / 2 - meioX, y: c.offsetTop + c.offsetHeight / 2 - meioY }));
    };
    medir();
    addEventListener('resize', medir);

    // tamanho do palco guardado (ler a cada quadro obrigava o navegador a recalcular a página)
    let palcoL = palco.clientWidth;
    let palcoA = palco.clientHeight;
    new ResizeObserver(() => {
      palcoL = palco.clientWidth;
      palcoA = palco.clientHeight;
    }).observe(palco);

    let visivel = true;
    new IntersectionObserver(([e]) => (visivel = e.isIntersecting)).observe(palco);

    const mostrarLegenda = (f: HTMLElement | null) => {
      if (!f) return legenda.classList.remove('ativa');
      legenda.querySelector('b')!.textContent = f.querySelector('img')?.alt ?? '';
      legenda.querySelector('span')!.textContent = `${f.dataset.ensaio} · ${f.dataset.total} photos`;
      legenda.classList.add('ativa');
    };

    // estado da BOLA (a tela travada escreve aqui; o relógio da parede lê)
    const hex = {
      m: 0, // 0 = parede, 1 = as fotos juntas numa bola
      escala: 1, // o palco encolhendo
      giro: 0, // a bola girando
      boom: 0, // 0..1: a bola explode pra fora
      raio: 0, // raio da bola, em px da tela
      tamanho: 0, // lado de cada foto na bola, em px da tela
      vagas: 44,
      ladoCasa: 1, // lado de uma casa do mural, em px de dentro
      vaga: new Map<number, number>(), // índice da casa → face do anel
    };

    let pausar = false; // o Flip do embaralhar também mexe no transform das casas
    const poses: string[] = []; // a última pose escrita em cada casa (computador)

    if (comMouse) {
      // ---------- computador: a parede corre com o mouse ----------
      const irX = gsap.quickTo(grade, 'x', { duration: semMovimento ? 0 : 1.4, ease: 'power3.out' });
      const irY = gsap.quickTo(grade, 'y', { duration: semMovimento ? 0 : 1.4, ease: 'power3.out' });
      palco.addEventListener('pointermove', (e) => {
        const caixa = palco.getBoundingClientRect();
        const sobraX = Math.max(0, grade.offsetWidth - caixa.width + 80);
        const sobraY = Math.max(0, grade.offsetHeight - caixa.height + 80);
        irX((0.5 - (e.clientX - caixa.left) / caixa.width) * sobraX);
        irY((0.5 - (e.clientY - caixa.top) / caixa.height) * sobraY);
      });

      // ---------- computador: parede curva (3D) ----------
      // Cada casa vira e recua conforme a distância até o meio da tela: o meio fica de frente e
      // perto, as bordas viram para fora. A casa sob o mouse chega mais perto.
      let sob: HTMLElement | null = null;
      const perto = new Map<HTMLElement, number>();
      fotos.forEach((f) => {
        f.addEventListener('pointerenter', () => {
          sob = f;
          mostrarLegenda(f);
        });
        f.addEventListener('pointerleave', () => {
          if (sob === f) sob = null;
          mostrarLegenda(null);
        });
      });
      if (!semMovimento) {
        const limite = (v: number) => Math.max(-1.6, Math.min(1.6, v));
        gsap.ticker.add(() => {
          if (pausar || !visivel) return;
          const gx = Number(gsap.getProperty(grade, 'x'));
          const gy = Number(gsap.getProperty(grade, 'y'));
          const meiaL = palcoL / 2;
          const meiaA = palcoA / 2;
          const m = hex.m; // 0 = parede, 1 = hexágono
          const escala = hex.escala; // quanto o palco já encolheu (as contas do anel são no tamanho de dentro)
          casas.forEach((c, i) => {
            const nx = limite((centros[i].x + gx) / meiaL);
            const ny = limite((centros[i].y + gy) / meiaA);
            const alvo = c === sob ? 1 : 0;
            let p = perto.get(c) ?? 0;
            p += (alvo - p) * 0.12;
            if (Math.abs(alvo - p) < 0.001) p = alvo;
            perto.set(c, p);
            const z = -(nx * nx + ny * ny) * 170 + p * 70;
            let tf = `translateZ(${z.toFixed(1)}px) rotateY(${(nx * 16).toFixed(2)}deg) rotateX(${(-ny * 14).toFixed(2)}deg)`;
            const k = hex.vaga.get(i);
            if (m > 0 && k !== undefined) {
              // a foto vai da casa dela até o ponto k de uma esfera (distribuição de Fibonacci),
              // a esfera gira e, no fim, explode: cada foto voa pra fora na direção dela
              const N = hex.vagas;
              const sy = 1 - (2 * (k + 0.5)) / N;
              const sr = Math.sqrt(1 - sy * sy);
              const fi = k * 2.39996 + hex.giro;
              const inc = 0.35; // a bola inclinada, pra girar "de lado"
              let sx = Math.cos(fi) * sr, sz = Math.sin(fi) * sr;
              const y2 = sy * Math.cos(inc) - sz * Math.sin(inc);
              sz = sy * Math.sin(inc) + sz * Math.cos(inc);
              const voa = 1 + hex.boom * hex.boom * 7;
              const raio = (hex.raio / escala) * voa;
              const dx = sx * raio - (centros[i].x + gx);
              const dy = y2 * raio - (centros[i].y + gy);
              const dz = sz * raio;
              const tamanho = 1 + (hex.tamanho / (hex.ladoCasa * escala) * (1 + hex.boom * 1.5) - 1) * m;
              tf = `translate3d(${(dx * m).toFixed(1)}px, ${(dy * m).toFixed(1)}px, ${(z * (1 - m) + dz * m + p * 40).toFixed(1)}px) rotateY(${(nx * 16 * (1 - m)).toFixed(2)}deg) rotateX(${(-ny * 14 * (1 - m)).toFixed(2)}deg) scale(${tamanho.toFixed(3)})`;
            }
            if (tf !== poses[i]) c.style.transform = poses[i] = tf;
            // quem não entra na bola (e o cartão) some depressa; na explosão, todas somem
            const op = m > 0 && k === undefined ? String(Math.max(0, 1 - m * 4)) : hex.boom > 0 ? String(Math.max(0, 1 - hex.boom * 1.3)) : '';
            if (c.style.opacity !== op) c.style.opacity = op;
          });
        });
      }
      fotos.forEach((f) => f.addEventListener('click', () => abrirDetalhe(f)));
    } else {
      // ---------- celular: a parede do omrimalka (mesmos números do site dele) ----------
      const Gt = 0.24; // força da lente em barril
      const Xi = 0.07; // o meio um pouco maior
      const Ui = 0.05; // some na borda da lente
      const Zi = (1 / (3 * Gt)) * 0.94;
      const GANHO = 0.26; // quanto a foto do foco cresce
      const suave = (a: number, b: number, x: number) => {
        const k = Math.max(0, Math.min(1, (x - a) / (b - a)));
        return k * k * (3 - 2 * k);
      };
      // recortes tortos com semente fixa por casa: quase reto parado, bem torto no meio
      const semente = (s: string) => {
        let h = 2166136261;
        for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);
        let e = h >>> 0;
        return () => ((e = (Math.imul(e, 1664525) + 1013904223) >>> 0), e / 4294967296);
      };
      const poligono = (chave: string, q: number) => {
        const r = semente(chave);
        const v = () => (q * (0.3 + r() * 0.7)).toFixed(2);
        return `polygon(${v()}% ${v()}%, ${100 - +v()}% ${v()}%, ${100 - +v()}% ${100 - +v()}%, ${v()}% ${100 - +v()}%)`;
      };
      casas.forEach((c, i) => {
        c.dataset.repouso = poligono(`casa${i}`, 3.2);
        c.dataset.quente = poligono(`casa${i}:quente`, 10);
        c.style.clipPath = c.dataset.repouso;
      });

      // câmera: começa com o cartão do título no meio. A parede só anda depois do
      // "Vamos colocar uma cor?" (antes o mural fica parado e a página rola normal).
      const cam = { x: centros[0].x, y: centros[0].y, vx: 0, vy: 0 };
      let emCor = false;
      const estado = casas.map(() => ({ escala: 1, perto: false, tf: '', op: '', z: '' }));
      let largura = 0;
      let altura = 0;
      const medirParede = () => {
        largura = grade.offsetWidth + 6;
        altura = grade.offsetHeight + 6;
      };
      medirParede();
      addEventListener('resize', medirParede);
      const envolver = (v: number, t: number) => ((((v + t / 2) % t) + t) % t) - t / 2;

      // em cor: arrasta com o dedo pra qualquer lado (sem cor, só o toque que abre a foto)
      let arrastando = false;
      let moveu = 0;
      let desceu = 0;
      let ultimo = { x: 0, y: 0 };
      let alvoToque: HTMLElement | null = null;
      palco.addEventListener('pointerdown', (e) => {
        arrastando = true;
        moveu = 0;
        desceu = performance.now();
        ultimo = { x: e.clientX, y: e.clientY };
        alvoToque = (e.target as HTMLElement).closest('.mural-foto');
        cam.vx = cam.vy = 0;
      });
      palco.addEventListener('pointermove', (e) => {
        if (!arrastando) return;
        const dx = e.clientX - ultimo.x;
        const dy = e.clientY - ultimo.y;
        ultimo = { x: e.clientX, y: e.clientY };
        moveu += Math.hypot(dx, dy);
        if (!emCor) return;
        cam.x -= dx;
        cam.y -= dy;
        cam.vx = cam.vx * 0.4 - dx * 0.6;
        cam.vy = cam.vy * 0.4 - dy * 0.6;
      });
      palco.addEventListener('pointerup', () => {
        if (!arrastando) return;
        arrastando = false;
        if (moveu < 7 && performance.now() - desceu < 320 && alvoToque) {
          cam.vx = cam.vy = 0;
          abrirDetalhe(alvoToque);
        }
      });
      palco.addEventListener('pointercancel', () => (arrastando = false)); // virou rolagem da página
      // em cor, a rodinha/trackpad também anda a parede, pros dois lados (como o omrimalka)
      palco.addEventListener(
        'wheel',
        (e) => {
          if (!emCor) return;
          e.preventDefault();
          cam.vx = Math.max(-44, Math.min(44, cam.vx + e.deltaX * 0.062));
          cam.vy = Math.max(-44, Math.min(44, cam.vy + e.deltaY * 0.062));
        },
        { passive: false },
      );

      // a intro revela o mural pela opacidade: só depois dela a lente mexe na opacidade
      let mexerOpacidade = !raiz.classList.contains('intro-on');
      document.addEventListener('mural:revelar', () => setTimeout(() => (mexerOpacidade = true), 1700));

      let focoAtual: HTMLElement | null = null;
      gsap.ticker.add((_t, dt) => {
        if (pausar || !visivel) return;
        if (!arrastando && (Math.abs(cam.vx) > 0.01 || Math.abs(cam.vy) > 0.01)) {
          cam.x += cam.vx;
          cam.y += cam.vy;
          const atrito = Math.pow(0.935, dt / 16.67);
          cam.vx *= atrito;
          cam.vy *= atrito;
        }
        const vw = palcoL;
        const vh = palcoA;
        const n = Math.hypot(vw / 2, vh / 2) || 1;
        const raio = Math.max(330, vh * 0.45);
        const resto = emCor ? 0.62 : 1; // em cor, o que está longe do meio apaga um pouco
        const passo = semMovimento ? 1 : Math.min(1, dt * 0.014);
        let foco: HTMLElement | null = null;
        let maior = 0;
        casas.forEach((c, i) => {
          const e = estado[i];
          const sx = envolver(centros[i].x - cam.x, largura);
          const sy = envolver(centros[i].y - cam.y, altura);
          // a lente (a mesma conta do omrimalka)
          const l = Math.min((sx * sx + sy * sy) / (n * n), Zi);
          const v = (1 - Gt * l) / (1 - Gt);
          const m = (1 - 3 * Gt * l) / (1 - Gt);
          const u = 1 + Xi * Math.max(0, 1 - l);
          const px = sx * v;
          const py = sy * v;
          const st = Math.max(1e-4, v) * u;
          const sr = Math.max(Math.max(1e-4, v) * 0.62, m) * u;
          const sumir = suave(0, Ui, m);
          const peso = 1 - suave(0, raio, Math.hypot(px, py));
          const cartao = i === 0;
          e.escala += ((cartao ? 1 : 1 + peso * GANHO) - e.escala) * passo;
          const k = Math.sqrt(st * sr) * e.escala;
          const tf = `translate(${(px - centros[i].x).toFixed(1)}px, ${(py - centros[i].y).toFixed(1)}px) scale(${k.toFixed(3)})`;
          if (tf !== e.tf) c.style.transform = e.tf = tf;
          const z = String(Math.max(0, Math.round((k - 1) * 24)));
          if (z !== e.z) c.style.zIndex = e.z = z;
          if (mexerOpacidade) {
            const op = (resto + (1 - resto) * peso) * sumir;
            const o = op > 0.999 ? '' : op.toFixed(2);
            if (o !== e.op) c.style.opacity = e.op = o;
          }
          if (cartao) return;
          const perto = peso > (e.perto ? 0.2 : 0.38);
          if (perto !== e.perto) {
            e.perto = perto;
            c.classList.toggle('perto', perto);
            c.style.clipPath = (perto ? c.dataset.quente : c.dataset.repouso) ?? '';
          }
          if (peso > maior) {
            maior = peso;
            foco = c;
          }
        });
        const novo = maior > 0.5 ? foco : null;
        if (novo !== focoAtual) {
          focoAtual = novo;
          mostrarLegenda(novo);
        }
      });

      // "Vamos colocar uma cor?": as fotos ganham cor numa onda que sai do meio da tela e o mural
      // vira a tela inteira, solto pra qualquer lado. Só fica parado de novo no "voltar pro azul"
      // (ou num link do menu), e aí a página volta a rolar normal.
      const botaoCor = mural.querySelector<HTMLButtonElement>('.mural-cor')!;
      const colorir = (ligar: boolean) => {
        if (ligar === emCor) return;
        emCor = ligar;
        if (ligar) {
          (window as unknown as { lenis?: { scrollTo(y: number, o?: object): void } }).lenis?.scrollTo(0, { immediate: true });
          scrollTo(0, 0);
        }
        fotos.forEach((f) => {
          const r = f.getBoundingClientRect();
          const d = Math.hypot(r.left + r.width / 2 - innerWidth / 2, r.top + r.height / 2 - innerHeight / 2);
          f.style.setProperty('--atraso', `${Math.round(Math.min(d, 900) * 0.9)}ms`);
        });
        mural.classList.toggle('em-cor', ligar);
        raiz.classList.toggle('mural-em-cor', ligar);
        if (ligar) lenis()?.stop();
        else {
          lenis()?.start();
          // volta com o cartão do título pro meio
          cam.vx = cam.vy = 0;
          gsap.to(cam, { x: centros[0].x, y: centros[0].y, duration: semMovimento ? 0 : 1.1, ease: 'power3.inOut' });
        }
        botaoCor.setAttribute('aria-pressed', String(ligar));
        botaoCor.querySelector('span')!.textContent = ligar ? 'back to blue' : 'Shall we add some color?';
      };
      botaoCor.addEventListener('click', () => colorir(!emCor));
      document.querySelectorAll('a[href^="#"]').forEach((a) => a.addEventListener('click', () => colorir(false)));
    }
    // ---------- detalhe da foto ----------
    const detalhe = mural.querySelector<HTMLElement>('.detalhe')!;
    const painel = detalhe.querySelector<HTMLElement>('.detalhe-painel')!;
    const base = ((window as unknown as { __baseMural?: string }).__baseMural ?? '/').replace(/\/$/, '');
    let quemAbriu: HTMLElement | null = null;

    function abrirDetalhe(f: HTMLElement) {
      quemAbriu = f;
      const img = detalhe.querySelector<HTMLImageElement>('.detalhe-foto img')!;
      img.src = f.dataset.grande ?? f.querySelector('img')!.currentSrc;
      img.alt = f.querySelector('img')?.alt ?? '';
      detalhe.querySelector('.detalhe-titulo')!.textContent = img.alt;
      detalhe.querySelector('.detalhe-ensaio')!.textContent = `From the ${f.dataset.ensaio} series.`;
      detalhe.querySelector('.tag-ensaio')!.textContent = f.dataset.ensaio ?? '';
      detalhe.querySelector('.tag-total')!.textContent = `${f.dataset.total} photos`;
      detalhe.querySelector<HTMLAnchorElement>('.detalhe-link')!.href = `${base}/${f.dataset.slug}`;
      painel.style.setProperty('--cor', f.dataset.cor ?? '#1f3f99');
      detalhe.hidden = false;
      raiz.style.overflow = 'hidden';
      lenis()?.stop();
      detalhe.querySelector<HTMLElement>('.detalhe-fechar')!.focus({ preventScroll: true });
      if (semMovimento) return;
      gsap
        .timeline()
        .fromTo('.detalhe-fundo', { opacity: 0 }, { opacity: 1, duration: 0.35 })
        .fromTo('.detalhe-fechar', { scale: 0, rotate: -180 }, { scale: 1, rotate: 0, duration: 0.6, ease: 'back.out(2)' }, 0.1)
        .fromTo(painel, { yPercent: 50, rotate: 8, opacity: 0 }, { yPercent: 0, rotate: -1.4, opacity: 1, duration: 0.8, ease: 'expo.out' }, 0)
        .fromTo('.detalhe-foto', { scale: 0.7, rotate: -12 }, { scale: 1, rotate: 2.4, duration: 0.9, ease: 'back.out(1.6)' }, 0.15)
        .fromTo('.detalhe-texto > *', { y: 18, opacity: 0 }, { y: 0, opacity: 1, duration: 0.5, stagger: 0.07, ease: 'power3.out' }, 0.3);
    }
    function fecharDetalhe() {
      if (detalhe.hidden) return;
      const terminar = () => {
        detalhe.hidden = true;
        raiz.style.overflow = '';
        lenis()?.start();
        quemAbriu?.focus({ preventScroll: true });
      };
      if (semMovimento) return terminar();
      gsap
        .timeline({ onComplete: terminar })
        .to(painel, { yPercent: 60, rotate: -9, opacity: 0, duration: 0.45, ease: 'power3.in' })
        .to('.detalhe-fundo', { opacity: 0, duration: 0.3 }, 0.15)
        .to('.detalhe-fechar', { scale: 0, duration: 0.25 }, 0);
    }
    detalhe.querySelectorAll('[data-fechar-detalhe]').forEach((b) => b.addEventListener('click', fecharDetalhe));
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape') fecharDetalhe();
      if (e.key === 'Enter' && (document.activeElement as HTMLElement)?.classList.contains('mural-foto')) abrirDetalhe(document.activeElement as HTMLElement);
    });

    // ---------- embaralhar: as fotos trocam de lugar deslizando (o cartão fica no meio) ----------
    mural.querySelector('.mural-embaralhar')!.addEventListener('click', () => {
      pausar = true;
      const estado = Flip.getState(fotos);
      const sorteio = [...fotos].sort(() => Math.random() - 0.5);
      sorteio.forEach((f) => grade.append(f));
      Flip.from(estado, {
        duration: semMovimento ? 0 : 1.1,
        ease: 'power3.inOut',
        stagger: { amount: 0.35, from: 'random' },
        absolute: true,
        onComplete: () => {
          medir();
          poses.length = 0; // o Flip mexeu nas casas: escreve as poses de novo
          pausar = false;
        },
      });
    });

    // ---------- "BUM": a intro dispara e o mural aparece do centro para fora ----------
    document.addEventListener('mural:revelar', () => {
      if (semMovimento) return;
      gsap.fromTo(
        casas,
        { opacity: 0, '--r': 0.4 },
        {
          opacity: 1,
          '--r': 1,
          duration: 0.9,
          ease: 'expo.out',
          stagger: { grid: 'auto', from: 'center', amount: 0.7 },
          clearProps: 'opacity,--r',
        },
      );
      gsap.from(mural.querySelector('.mural-dica'), { opacity: 0, y: 10, delay: 1.2, duration: 0.6 });
    });

    // ---------- rolando (computador), com a tela travada ----------
    //  0 → 0,42: o mural encolhe até virar um quadro e as fotos ganham cor numa onda do meio pra fora
    //  0,46 → 0,7: as 44 fotos mais perto do meio se juntam numa BOLA (esfera de fotos)
    //  0,6 → 0,86: a bola gira
    //  0,86 → 1: a bola EXPLODE: as fotos voam pra fora e somem, e a página segue pros lugares
    if (!semMovimento && comMouse) {
      const faixa = (t: number, de: number, ate: number) => gsap.utils.clamp(0, 1, (t - de) / (ate - de));
      const suave = gsap.parseEase('power2.inOut');
      const hexagono = mural.querySelector<HTMLElement>('.mural-hex')!;
      const hexNome = mural.querySelector<HTMLElement>('.mural-hex-nome')!;
      const dica = mural.querySelector<HTMLElement>('.mural-dica')!;

      // quem entra na bola: as fotos mais perto do meio
      const escolher = () => {
        hex.vaga.clear();
        const perto = fotos
          .map((f) => casas.indexOf(f))
          .map((i) => ({ i, d: Math.hypot(centros[i].x, centros[i].y), a: Math.atan2(centros[i].x, -centros[i].y) }))
          .sort((p, q) => p.d - q.d)
          .slice(0, hex.vagas)
          .sort((p, q) => ((p.a + Math.PI * 2) % (Math.PI * 2)) - ((q.a + Math.PI * 2) % (Math.PI * 2)));
        perto.forEach((p, k) => hex.vaga.set(p.i, k));
      };
      // a onda de cor: cada foto acende quando a onda passa pela distância dela até o meio
      let distMax = 1;
      const medirHex = () => {
        escolher();
        distMax = Math.max(...centros.map((c) => Math.hypot(c.x, c.y)));
        hex.raio = Math.min(innerHeight * 0.26, 230);
        hex.tamanho = Math.min(innerHeight * 0.085, 74);
        hex.ladoCasa = fotos[0]?.offsetWidth || 1;
      };
      medirHex();
      addEventListener('resize', medirHex);

      let topo = -1;
      ScrollTrigger.create({
        trigger: mural,
        start: 'top top',
        end: '+=320%',
        pin: true,
        scrub: 0.8,
        refreshPriority: prioridade(mural),
        onUpdate: ({ progress: t }) => {
          const encolher = suave(faixa(t, 0, 0.42));
          hex.escala = 1 - encolher * 0.38;
          gsap.set(palco, { scale: hex.escala, borderRadius: 28 * encolher });
          const onda = faixa(t, 0.04, 0.42);
          casas.forEach((c, i) => c.classList.toggle('colorida', Math.hypot(centros[i].x, centros[i].y) / distMax < onda));

          hex.m = suave(faixa(t, 0.46, 0.7));
          hex.giro = faixa(t, 0.6, 0.86) * Math.PI * 1.6;
          hex.boom = gsap.parseEase('power2.in')(faixa(t, 0.86, 1));
          hexagono.style.opacity = String(hex.m * (1 - Math.min(1, hex.boom * 3)));
          dica.style.opacity = String(1 - hex.m); // a dica do mouse some quando as fotos viram a bola
          hexagono.style.scale = String(0.7 + 0.3 * hex.m + hex.boom * 0.6);
          // o anel é maior que o quadro: quando as fotos de fora já sumiram, o quadro solta a borda
          palco.style.overflow = hex.m > 0.25 ? 'visible' : '';
          palco.style.background = hex.m > 0 ? `rgb(247 245 240 / ${(1 - hex.m).toFixed(2)})` : '';

          // (na bola não tem "foto do topo": o nome no meio some)
          let qual = -1;
          if (false) {
            let menor = Infinity;
            hex.vaga.forEach((k, i) => {
              const a = k * (360 / hex.vagas) + hex.giro;
              const longe = Math.abs(((((a % 360) + 540) % 360) - 180));
              if (longe < menor) {
                menor = longe;
                qual = i;
              }
            });
          }
          if (qual !== topo) {
            if (topo >= 0) casas[topo].classList.remove('no-topo');
            topo = qual;
            if (topo >= 0) {
              casas[topo].classList.add('no-topo');
              hexNome.textContent = `${casas[topo].querySelector('img')?.alt ?? ''} · ${casas[topo].dataset.ensaio ?? ''}`;
            } else hexNome.textContent = '';
          }
        },
      });
    }
  }
</script>
