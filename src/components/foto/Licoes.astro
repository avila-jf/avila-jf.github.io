---
// "The eye" (a estrutura da 1ª versão): as três perguntas de uma foto passando de lado, cada uma
// com uma foto minha que mostra a pergunta. Vem depois dos lugares.
import { Image } from 'astro:assets';
import FaixaLateral from '../comum/FaixaLateral.astro';
import type { Foto } from '../../lib/fotos';

interface Props {
  licoes: { titulo: string; texto: string; foto?: Foto }[];
}

const { licoes } = Astro.props;
---

<FaixaLateral id="olhar" rotulo="02 · The eye" letreiro="Framing · Light · Rhythm" tema="tinta" lente="foto">
  <article class="lc-abre">
    <h2 class="titulo-cartaz">The<br />eye</h2>
    <p class="voz-foto">Every photo goes through the same three questions.</p>
    <span class="rotulo">scroll sideways →</span>
  </article>
  {
    licoes.map((l, i) => (
      <article class="lc-licao">
        {l.foto && (
          <figure class="lc-foto">
            <Image src={l.foto.src} alt={l.foto.alt} widths={[480, 800, 1200]} sizes="(max-width: 760px) 80vw, 30vw" format="webp" loading="lazy" />
            <figcaption class="rotulo">{l.foto.alt}</figcaption>
          </figure>
        )}
        <div class="lc-texto">
          <span class="rotulo">
            0{i + 1} / 0{licoes.length}
          </span>
          <b class="titulo-cartaz">{l.titulo}</b>
          <p>{l.texto}</p>
        </div>
      </article>
    ))
  }
</FaixaLateral>

<style>
  .lc-abre {
    flex: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
    width: min(32vw, 440px);
    padding-left: var(--margem);
  }
  .lc-abre h2 {
    margin: 0;
    font-size: clamp(64px, 9vw, 150px);
    line-height: 0.86;
  }
  .lc-abre p {
    margin: 0;
    max-width: 28ch;
    font-size: clamp(16px, 1.3vw, 20px);
    color: var(--texto-suave);
  }
  .lc-licao {
    flex: none;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: end;
    gap: clamp(18px, 2.4vw, 36px);
    width: min(58vw, 920px);
  }
  .lc-foto {
    position: relative;
    margin: 0;
    width: min(28vw, 420px);
    aspect-ratio: 4 / 5;
    max-height: 64svh;
    overflow: hidden;
    border-radius: 18px;
    background: var(--fundo-2);
  }
  .lc-foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .lc-foto figcaption {
    position: absolute;
    left: 14px;
    bottom: 12px;
    color: #fff;
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.5);
  }
  .lc-texto {
    display: grid;
    gap: 12px;
    padding-bottom: 8px;
  }
  .lc-texto b {
    font-size: clamp(48px, 6vw, 104px);
    line-height: 0.88;
  }
  .lc-texto p {
    margin: 0;
    max-width: 32ch;
    font-size: clamp(16px, 1.3vw, 20px);
    color: var(--texto-suave);
  }
  @media (max-width: 760px) {
    .lc-abre {
      width: 78vw;
    }
    .lc-licao {
      grid-template-columns: 1fr;
      width: 80vw;
    }
    .lc-foto {
      width: 80vw;
      max-height: 46svh;
    }
  }
</style>
