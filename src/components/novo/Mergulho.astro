---
// Mergulho no card (pegada do "About me" do portfólio do @echo_builds): um cartão pequeno com a
// minha foto, parado no meio de uma paisagem em gravura. Ao rolar, a tela trava e o cartão cresce
// até ocupar a tela inteira, como se a gente entrasse nele; a paisagem do fundo chega mais perto e,
// no fim, sobe o texto. Sem JS ou com "reduzir movimento": vira um bloco normal, cartão e texto.
// Precisa do Gravura.astro na página (o filtro da paisagem).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Foto } from '../../lib/fotos';
import { site } from '../../data/site';

interface Props {
  fundo?: Foto;
}

const { fundo } = Astro.props;
const eu = Object.values(import.meta.glob<{ default: ImageMetadata }>('/src/assets/eu.{jpg,jpeg,png,webp}', { eager: true }))[0]?.default;
---

<section class="mergulho" data-lente="foto" data-tema="tinta" aria-label="Sobre mim">
  <div class="m-palco">
    {
      fundo && (
        <div class="m-fundo" aria-hidden="true">
          <Image src={fundo.src} alt="" widths={[800, 1400, 2000]} sizes="100vw" format="webp" quality={70} loading="lazy" />
        </div>
      )
    }

    <div class="m-card">
      {eu && <Image class="m-foto" src={eu} alt={`${site.nome}, no espelho`} widths={[480, 900, 1600]} sizes="100vw" format="webp" />}
      <span class="m-veu" aria-hidden="true"></span>
    </div>

    <b class="m-titulo titulo-cartaz" aria-hidden="true">Sobre<br />mim</b>

    <div class="m-texto">
      <p class="rotulo">Por trás das lentes</p>
      <h2 class="titulo-cartaz">{site.nome}</h2>
      <p class="voz-foto">{site.bio[0]}</p>
      <button class="m-mais rotulo" type="button" data-abrir-sobre>Ler mais ↗</button>
    </div>
  </div>
</section>

<style>
  .mergulho {
    margin: 0 calc(var(--margem) * -1) 120px;
  }
  .m-palco {
    position: relative;
    display: grid;
    gap: 24px;
    padding: 0 var(--margem);
    color: var(--creme);
  }
  .m-fundo {
    display: none;
  }
  .m-card {
    position: relative;
    overflow: hidden;
    border-radius: 18px;
    aspect-ratio: 4 / 5;
    max-width: 420px;
  }
  .m-foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .m-titulo {
    display: none;
  }
  .m-texto h2 {
    margin: 8px 0 14px;
    font-size: clamp(48px, 8vw, 120px);
  }
  .m-texto p {
    max-width: 44ch;
    margin: 0 0 18px;
    font-size: clamp(18px, 1.6vw, 24px);
    line-height: 1.35;
  }
  .m-texto .rotulo {
    margin: 0;
    color: inherit;
    opacity: 0.8;
  }
  .m-mais {
    padding: 12px 22px;
    border: 1px solid rgb(241 230 204 / 0.5);
    border-radius: 999px;
    background: none;
    color: var(--creme);
    cursor: pointer;
    transition: background-color 0.3s;
  }
  .m-mais:hover {
    background: rgb(241 230 204 / 0.12);
  }

  /* ---------- Com JS: palco em tela cheia, cartão no meio da paisagem ---------- */
  .mergulho.ativo .m-palco {
    display: block;
    height: 100svh;
    padding: 0;
    overflow: hidden;
    background: var(--gravura);
  }
  .mergulho.ativo .m-fundo {
    display: block;
    position: absolute;
    inset: 0;
    contain: paint; /* o filtro de gravura é pesado: desenha uma vez e só escala a camada */
    will-change: transform;
  }
  .m-fundo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.25) url(#gravura-novo);
  }
  /* hachuras de gravura em metal por cima da paisagem */
  .m-fundo::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(118deg, rgb(20 45 120 / 0.3) 0 1px, transparent 1px 3.5px),
      repeating-linear-gradient(28deg, rgb(20 45 120 / 0.12) 0 1px, transparent 1px 5px);
    mix-blend-mode: multiply;
  }
  .mergulho.ativo .m-card {
    position: absolute;
    inset: 0;
    max-width: none;
    aspect-ratio: auto;
    border-radius: 0;
    will-change: clip-path;
    box-shadow: 0 40px 120px -40px rgb(0 0 0 / 0.6);
  }
  .mergulho.ativo .m-foto {
    will-change: transform;
  }
  /* escurece a foto no fim, pro texto ler bem */
  .m-veu {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(12 21 48 / 0.85), rgb(12 21 48 / 0.25) 70%);
    opacity: 0;
  }
  .mergulho.ativo .m-titulo {
    display: block;
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    margin: 0;
    font-size: clamp(54px, 9vw, 130px);
    text-align: center;
    color: #fff;
    text-shadow: 0 6px 40px rgb(0 0 0 / 0.5);
    pointer-events: none;
    will-change: transform, opacity;
  }
  .mergulho.ativo .m-texto {
    position: absolute;
    left: var(--margem);
    bottom: clamp(40px, 10svh, 110px);
    max-width: 680px;
    opacity: 0;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const raiz = document.querySelector<HTMLElement>('.mergulho');
  if (raiz && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    raiz.classList.add('ativo');
    const card = raiz.querySelector<HTMLElement>('.m-card')!;

    // o cartão começa pequeno no meio da tela (recortado com clip-path) e abre até as bordas
    const recorteInicial = () => {
      const w = Math.min(innerWidth * 0.46, 300);
      const h = Math.min(w * 1.3, innerHeight * 0.6);
      const x = (innerWidth - w) / 2;
      const y = (innerHeight - h) / 2;
      return `inset(${y}px ${x}px ${y}px ${x}px round 18px)`;
    };

    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: {
        trigger: raiz,
        start: 'top top',
        end: '+=200%',
        pin: raiz.querySelector('.m-palco'),
        scrub: 0.6,
        invalidateOnRefresh: true,
        refreshPriority: -1, // logo depois dos sites (o notebook trava antes)
      },
    });

    tl.fromTo(card, { clipPath: recorteInicial }, { clipPath: 'inset(0px 0px 0px 0px round 0px)', ease: 'power2.inOut', duration: 1 }, 0)
      .fromTo('.m-foto', { scale: 1.15 }, { scale: 1, ease: 'power2.inOut', duration: 1 }, 0)
      .fromTo('.m-fundo', { scale: 1 }, { scale: 1.35, ease: 'power1.in', duration: 1 }, 0)
      .fromTo('.m-titulo', { scale: 1, opacity: 1 }, { scale: 3, opacity: 0, ease: 'power2.in', duration: 0.55 }, 0.1)
      .to('.m-veu', { opacity: 1, duration: 0.3 }, 0.8)
      .fromTo('.m-texto', { opacity: 0, y: 40 }, { opacity: 1, y: 0, ease: 'power2.out', duration: 0.3 }, 0.85)
      .to({}, { duration: 0.25 }); // um respiro com o texto parado antes de soltar a tela
  }
</script>
