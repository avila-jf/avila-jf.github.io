---
// Abertura do site (pegada do portfólio do @echo_builds):
//  1. loader: "FRANCIS." brilhando dentro de um anel de tinta que ondula, por ~1,5 s;
//  2. uma paisagem em gravura azul (o "Noite Estrelada" dele, na nossa tinta) com o título gigante
//     "Explore meu olhar" atrás e um cartão com a foto da luz do estúdio no meio;
//  3. ao rolar, a tela trava e o cartão cresce até a tela inteira, como se a gente entrasse nele.
//     No fim o mural "explode" do meio (o mesmo "BUM" que a intro da câmera fazia).
// Sem JS ou com "reduzir movimento": paisagem com o título e o cartão parados.
// Precisa do Gravura.astro na página (o filtro da paisagem). Quem liga o loader é o script inline
// do <head> do index.astro (classe "carregando" no <html>).
import { Image } from 'astro:assets';
import type { Foto } from '../../lib/fotos';
import { site } from '../../data/site';

interface Props {
  fundo?: Foto;
  foto?: Foto;
}

const { fundo, foto } = Astro.props;
const [primeiro] = site.nome.split(' ');
---

<div class="m-loader" aria-hidden="true">
  <svg class="m-anel" viewBox="0 0 200 200">
    <filter id="tinta-anel">
      <feTurbulence type="fractalNoise" baseFrequency="0.02" numOctaves="2" seed="7">
        <animate attributeName="baseFrequency" dur="6s" values="0.02;0.035;0.02" repeatCount="indefinite" />
      </feTurbulence>
      <feDisplacementMap in="SourceGraphic" scale="14" />
    </filter>
    <circle cx="100" cy="100" r="78" filter="url(#tinta-anel)" />
    <circle cx="100" cy="100" r="70" filter="url(#tinta-anel)" />
  </svg>
  <b class="m-loader-nome titulo-cartaz">{primeiro}<i>.</i></b>
</div>

<section class="mergulho" data-lente="foto" data-tema="azul" aria-label="Abertura">
  <div class="m-palco">
    {
      fundo && (
        <div class="m-fundo" aria-hidden="true">
          <Image src={fundo.src} alt="" widths={[800, 1400, 2000]} sizes="100vw" format="webp" quality={70} loading="eager" />
        </div>
      )
    }

    <p class="m-hero titulo-cartaz" aria-hidden="true"><span>Explore</span><span>meu olhar</span></p>

    <div class="m-card">
      {foto && <Image class="m-foto" src={foto.src} alt={foto.alt} widths={[480, 900, 1600, 2200]} sizes="100vw" format="webp" loading="eager" />}
      <span class="m-veu" aria-hidden="true"></span>
    </div>

    <span class="m-dica rotulo" aria-hidden="true">role para entrar ↓</span>

    <div class="m-texto">
      <p class="rotulo">{site.nome} · {site.cidade.split(',')[0]}</p>
      <p class="m-frase voz-foto">Cada site começa como uma foto: <b>luz, enquadramento e ritmo.</b></p>
    </div>
  </div>
</section>

<style>
  /* ---------- Loader ---------- */
  .m-loader {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: none;
    place-items: center;
    background: var(--gravura);
    color: var(--creme);
    transition: opacity 0.7s ease;
  }
  :global(html.carregando) .m-loader {
    display: grid;
  }
  :global(html.carregando.saindo) .m-loader {
    opacity: 0;
  }
  .m-anel {
    position: absolute;
    width: min(70vw, 420px);
    fill: none;
    stroke: rgb(241 230 204 / 0.35);
    stroke-width: 1;
    animation: anel-girar 9s linear infinite;
  }
  .m-anel circle + circle {
    stroke: rgb(241 230 204 / 0.18);
  }
  @keyframes anel-girar {
    to {
      rotate: 360deg;
    }
  }
  .m-loader-nome {
    font-size: clamp(48px, 9vw, 110px);
    letter-spacing: 0.08em;
    text-shadow:
      0 0 18px rgb(255 244 220 / 0.7),
      0 0 60px rgb(255 244 220 / 0.35);
    animation: acender 1.2s ease-out both;
  }
  .m-loader-nome i {
    font-style: normal;
    color: var(--azul-claro);
  }
  @keyframes acender {
    from {
      opacity: 0;
      filter: blur(12px);
      letter-spacing: 0.4em;
    }
  }

  /* ---------- Abertura (sem JS: paisagem com título e cartão parados) ---------- */
  .mergulho {
    margin: -110px calc(var(--margem) * -1) 0; /* encosta no topo, por baixo da barra */
  }
  /* o mural vinha primeiro e sobe 110px por baixo da barra; agora quem faz isso é a abertura */
  .mergulho + :global(.mural) {
    margin-top: 0;
  }
  .m-palco {
    position: relative;
    height: 100svh;
    overflow: hidden;
    background: var(--gravura);
    color: var(--creme);
  }
  .m-fundo {
    position: absolute;
    inset: 0;
    contain: paint; /* o filtro de gravura é pesado: desenha uma vez e só escala a camada */
    will-change: transform;
  }
  .m-fundo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.25) url(#gravura-novo);
  }
  /* hachuras de gravura em metal por cima da paisagem */
  .m-fundo::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(118deg, rgb(20 45 120 / 0.3) 0 1px, transparent 1px 3.5px),
      repeating-linear-gradient(28deg, rgb(20 45 120 / 0.12) 0 1px, transparent 1px 5px),
      radial-gradient(ellipse at center, transparent 30%, rgb(12 21 48 / 0.55));
    mix-blend-mode: multiply;
  }

  /* título gigante atrás do cartão */
  .m-hero {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    margin: 0;
    font-size: clamp(64px, min(17vw, 26svh), 300px);
    line-height: 0.82;
    color: var(--creme);
    text-shadow: 0 10px 60px rgb(12 21 48 / 0.5);
    pointer-events: none;
    will-change: transform, opacity;
  }
  .m-hero span:last-child {
    color: transparent;
    -webkit-text-stroke: 2px var(--creme);
  }

  /* o cartão: a tela inteira recortada (clip-path) no tamanho de um cartão */
  .m-card {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #0c1530;
    clip-path: inset(calc(50% - min(23vw, 150px) * 1.3) calc(50% - min(23vw, 150px)) round 18px);
    will-change: clip-path;
  }
  .m-foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
  }
  .m-veu {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(12 21 48 / 0.8), transparent 55%);
    opacity: 0;
  }

  .m-dica {
    position: absolute;
    left: 50%;
    bottom: 28px;
    translate: -50% 0;
    color: var(--creme);
    opacity: 0.8;
    animation: dica 1.8s ease-in-out infinite;
  }
  @keyframes dica {
    50% {
      translate: -50% 6px;
    }
  }

  .m-texto {
    position: absolute;
    left: var(--margem);
    right: var(--margem);
    bottom: clamp(40px, 10svh, 110px);
    opacity: 0;
  }
  .m-texto .rotulo {
    margin: 0 0 10px;
    color: var(--creme);
    opacity: 0.8;
  }
  .m-frase {
    max-width: 22ch;
    margin: 0;
    font-size: clamp(28px, 4.4vw, 64px);
    line-height: 1.05;
  }
  .m-frase b {
    font-weight: 600;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // loader: some depois que a página carregou (no mínimo 1,4 s, no máximo 4 s)
  const html = document.documentElement;
  if (html.classList.contains('carregando')) {
    const inicio = performance.now();
    const sair = () => {
      if (!html.classList.contains('carregando')) return;
      html.classList.add('saindo');
      setTimeout(() => html.classList.remove('carregando', 'saindo'), 700);
    };
    const quandoCarregar = () => setTimeout(sair, Math.max(0, 1400 - (performance.now() - inicio)));
    if (document.readyState === 'complete') quandoCarregar();
    else addEventListener('load', quandoCarregar, { once: true });
    setTimeout(sair, 4000);
  }

  const raiz = document.querySelector<HTMLElement>('.mergulho');
  if (raiz && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const card = raiz.querySelector<HTMLElement>('.m-card')!;

    // o cartão começa pequeno no meio da tela e abre até as bordas
    const tamanhoCard = () => {
      const w = Math.min(innerWidth * 0.46, 300);
      return { w, h: Math.min(w * 1.3, innerHeight * 0.6) };
    };
    const recorteInicial = () => {
      const { w, h } = tamanhoCard();
      const x = (innerWidth - w) / 2;
      const y = (innerHeight - h) / 2;
      return `inset(${y}px ${x}px ${y}px ${x}px round 18px)`;
    };
    // a foto começa encolhida até a cena inteira caber no cartão (e não só um pedaço do meio dela)
    const escalaInicial = () => {
      const { w, h } = tamanhoCard();
      return Math.max(w / innerWidth, h / innerHeight);
    };

    let revelou = false;
    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: {
        trigger: raiz,
        start: 'top top',
        end: '+=160%',
        pin: raiz.querySelector('.m-palco'),
        scrub: 0.6,
        invalidateOnRefresh: true,
        refreshPriority: 1, // a primeira seção que trava a tela
        onLeave: () => {
          // saindo da abertura: o mural "explode" do meio, como no clique da antiga intro
          if (revelou) return;
          revelou = true;
          document.dispatchEvent(new Event('mural:revelar'));
        },
      },
    });

    tl.fromTo(card, { clipPath: recorteInicial }, { clipPath: 'inset(0px 0px 0px 0px round 0px)', ease: 'power2.inOut', duration: 1 }, 0)
      .fromTo('.m-foto', { scale: escalaInicial }, { scale: 1, ease: 'power2.inOut', duration: 1 }, 0)
      .fromTo('.m-fundo', { scale: 1 }, { scale: 1.35, ease: 'power1.in', duration: 1 }, 0)
      .fromTo('.m-hero', { scale: 1, opacity: 1 }, { scale: 1.6, opacity: 0, ease: 'power2.in', duration: 0.6 }, 0)
      .to('.m-dica', { opacity: 0, duration: 0.15 }, 0)
      .to('.m-veu', { opacity: 1, duration: 0.3 }, 0.75)
      .fromTo('.m-texto', { opacity: 0, y: 40 }, { opacity: 1, y: 0, ease: 'power2.out', duration: 0.3 }, 0.8)
      .to({}, { duration: 0.2 }); // um respiro com o texto parado antes de soltar a tela
  }
</script>
