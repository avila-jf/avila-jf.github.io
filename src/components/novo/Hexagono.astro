---
// Hexágono de trabalhos (pegada do "WORKS '26" do portfólio do @echo_builds): todos os projetos
// formam um anel em volta de um hexágono, cada cartão deitado na face dele. Ao rolar, a tela trava
// e o anel gira; o projeto que chega no topo acende e o nome dele aparece no meio.
// No celular (ou sem JS / "reduzir movimento") fica a lista enxuta de antes.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  itens: {
    nome: string;
    tipo: string;
    tecnologias: string[];
    link?: string;
    print?: ImageMetadata;
    cor?: string;
  }[];
}

const { itens } = Astro.props;
---

<div class="hexa" style={`--n:${itens.length}`}>
  <div class="hx-anel">
    <div class="hx-centro" aria-hidden="true">
      <span class="rotulo">Projetos</span>
      <b class="titulo-cartaz">'26</b>
      <span class="hx-nome voz-codigo">{itens[0]?.nome}</span>
      <span class="hx-tipo rotulo">{itens[0]?.tipo}</span>
    </div>
    {
      itens.map((p, i) => (
        <a
          class="hx-item"
          href={p.link}
          target="_blank"
          rel="noopener"
          style={`--i:${i};--cor:${p.cor ?? 'var(--azul)'}`}
          data-nome={p.nome}
          data-tipo={p.tipo}
          aria-label={`${p.nome} — ${p.tipo}`}
        >
          {p.print ? (
            <Image src={p.print} alt="" widths={[360, 640]} sizes="240px" format="webp" />
          ) : (
            <span class="hx-codigo">
              <b class="titulo-cartaz">{p.nome}</b>
              <span class="voz-codigo">{p.tecnologias.join(' · ')}</span>
            </span>
          )}
        </a>
      ))
    }
  </div>
</div>

<style>
  .hexa {
    display: none;
  }

  /* Com JS no computador: a tela trava e o anel aparece */
  :global(.hexa-ativo) .hexa {
    display: grid;
    place-items: center;
    height: 100svh;
  }
  :global(.hexa-ativo) .hexa ~ :global(.outros) {
    display: none;
  }

  .hx-anel {
    --lado: min(86vw, 78svh, 820px);
    --raio: calc(var(--lado) * 0.36);
    position: relative;
    width: var(--lado);
    height: var(--lado);
  }

  /* hexágono do meio: borda fina (duas camadas recortadas) e o nome do projeto da vez */
  .hx-centro {
    position: absolute;
    left: 50%;
    top: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    width: calc(var(--lado) * 0.4);
    aspect-ratio: 1 / 0.866;
    translate: -50% -50%;
    text-align: center;
    clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%);
    background: var(--linha);
  }
  .hx-centro::before {
    content: '';
    position: absolute;
    inset: 1px;
    z-index: -1;
    clip-path: inherit;
    background: var(--fundo);
  }
  .hx-centro b {
    font-size: calc(var(--lado) * 0.12);
    line-height: 0.9;
  }
  .hx-nome {
    font-size: clamp(12px, 1.1vw, 15px);
    color: var(--texto);
  }

  .hx-item {
    --largura: calc(var(--lado) * 0.3);
    position: absolute;
    left: calc(50% - var(--largura) / 2);
    top: calc(50% - var(--largura) * 0.3125);
    width: var(--largura);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 12px;
    background: var(--fundo-2);
    box-shadow: 0 0 0 1px var(--linha);
    color: var(--texto);
    text-decoration: none;
    filter: saturate(0.4) brightness(0.92);
    transition:
      filter 0.5s,
      box-shadow 0.5s;
    will-change: transform;
  }
  .hx-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  .hx-item.ativa,
  .hx-item:hover {
    filter: none;
    box-shadow:
      0 0 0 1px var(--cor),
      0 24px 60px -24px var(--cor);
  }
  /* projeto sem print: cartão de código, com o nome em cartaz */
  .hx-codigo {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 6px;
    height: 100%;
    padding: 12px 14px;
    background:
      radial-gradient(circle at 80% 10%, rgb(35 70 168 / 0.18), transparent 60%),
      var(--fundo-2);
  }
  .hx-codigo b {
    font-size: calc(var(--lado) * 0.034);
  }
  .hx-codigo .voz-codigo {
    font-size: 10px;
    color: var(--texto-suave);
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const raiz = document.querySelector<HTMLElement>('.hexa');
  const secao = raiz?.closest<HTMLElement>('.ato');
  const computador = matchMedia('(min-width: 761px)').matches;
  if (raiz && secao && computador && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    secao.classList.add('hexa-ativo');
    const itens = [...raiz.querySelectorAll<HTMLElement>('.hx-item')];
    const nome = raiz.querySelector<HTMLElement>('.hx-nome')!;
    const tipo = raiz.querySelector<HTMLElement>('.hx-tipo')!;
    const n = itens.length;
    const passo = 360 / n;
    let ativo = -1;

    // cada cartão fica na face do hexágono: gira junto com o anel e deita na direção dela.
    // A inclinação é a da face, dobrada para -90°..90°: os de baixo não ficam de cabeça para baixo.
    const girar = (giro: number) => {
      let maisPerto = 0;
      let menor = Infinity;
      itens.forEach((el, i) => {
        const a = i * passo + giro;
        const inclinacao = ((((a + 90) % 180) + 180) % 180) - 90;
        el.style.transform = `rotate(${a}deg) translateY(calc(var(--raio) * -1)) rotate(${-a + inclinacao}deg)`;
        const doTopo = Math.abs(((((a % 360) + 540) % 360) - 180));
        if (doTopo < menor) {
          menor = doTopo;
          maisPerto = i;
        }
      });
      if (maisPerto !== ativo) {
        ativo = maisPerto;
        itens.forEach((el, i) => el.classList.toggle('ativa', i === ativo));
        nome.textContent = itens[ativo].dataset.nome ?? '';
        tipo.textContent = itens[ativo].dataset.tipo ?? '';
      }
    };

    const estado = { giro: 0 };
    girar(0);
    gsap.to(estado, {
      giro: -(360 - passo), // cada projeto passa pelo topo uma vez
      ease: 'none',
      onUpdate: () => girar(estado.giro),
      scrollTrigger: {
        trigger: raiz,
        start: 'top top',
        end: '+=220%',
        pin: raiz,
        scrub: 0.8,
        refreshPriority: -5, // depois das seções de cima que travam a tela
      },
    });
  }
</script>
