---
// Filtro "gravura" do site novo (coloque uma vez na página). Não é para as fotos dos ensaios
// (essas ficam com as cores delas): é para decorar o fundo, como cenário. Quem usa é o Cenario.astro.
// O efeito é o da capa do site antigo, refinado: a foto perde a cor, ganha um pontilhado fino nas
// passagens de tom, é reduzida a poucos tons de tinta e tem as bordas levemente "borradas de tinta".
// Cores: azul royal (#1f3f99) no escuro e creme (#f1e6cc) no claro, como o rodapé "sequel".
---

<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <filter id="gravura-novo" color-interpolation-filters="sRGB" x="0" y="0" width="100%" height="100%">
    <feColorMatrix in="SourceGraphic" type="saturate" values="0" result="cinza" />
    <!-- granulado fino misturado antes de reduzir os tons: as passagens viram pontilhado, não manchas -->
    <feTurbulence type="fractalNoise" baseFrequency="1.3" numOctaves="1" seed="3" />
    <feColorMatrix type="saturate" values="0" result="granulado" />
    <feComposite in="cinza" in2="granulado" operator="arithmetic" k1="0" k2="1" k3="0.22" k4="-0.11" />
    <feComponentTransfer>
      <feFuncR type="discrete" tableValues="0 0.14 0.28 0.44 0.6 0.76 0.9 1" />
      <feFuncG type="discrete" tableValues="0 0.14 0.28 0.44 0.6 0.76 0.9 1" />
      <feFuncB type="discrete" tableValues="0 0.14 0.28 0.44 0.6 0.76 0.9 1" />
    </feComponentTransfer>
    <!-- escuro → azul royal (#1f3f99), claro → creme (#f1e6cc) -->
    <feColorMatrix
      type="matrix"
      values="0.824 0 0 0 0.122
              0.655 0 0 0 0.247
              0.2   0 0 0 0.6
              0     0 0 1 0"
      result="tinta"
    />
    <!-- tinta que "escorre" um tiquinho nas bordas, como impressão de verdade -->
    <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="1" seed="4" result="ruido" />
    <feDisplacementMap in="tinta" in2="ruido" scale="2.5" xChannelSelector="R" yChannelSelector="G" />
  </filter>
</svg>
