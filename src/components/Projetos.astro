---
// Lista de projetos de programação (dados em src/data/site.ts → projetos).
//  - destaques: cartão grande com o print do site dentro de uma "janela de navegador"
//  - demais (se "todos" for true): lista simples com nome, tipo e tecnologias
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { projetos } from '../data/site';

interface Props {
  todos?: boolean;
}

const { todos = false } = Astro.props;

const prints = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projetos/*.{jpg,png,webp}', {
  eager: true,
});
const printDe = (nome?: string) =>
  nome ? Object.entries(prints).find(([caminho]) => caminho.includes(`/${nome}.`))?.[1].default : undefined;

const destaques = projetos.filter((p) => p.destaque);
const outros = projetos.filter((p) => !p.destaque);
const dominio = (link?: string) => link?.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<div class="projetos">
  {
    destaques.map((projeto, i) => {
      const print = printDe(projeto.imagem);
      return (
        <article class="projeto revelar">
          <a
            class="janela"
            href={projeto.site ?? projeto.codigo}
            target="_blank"
            rel="noopener"
            data-tilt
            aria-label={`Abrir ${projeto.nome}`}
          >
            <div class="janela-barra" aria-hidden="true">
              <i />
              <i />
              <i />
              <span>{dominio(projeto.site ?? projeto.codigo)}</span>
            </div>
            <div class="janela-tela">
              {print && (
                <Image
                  src={print}
                  alt={`Print do site ${projeto.nome}`}
                  widths={[600, 900, 1300]}
                  sizes="(max-width: 860px) 100vw, 55vw"
                  format="webp"
                  quality={80}
                />
              )}
            </div>
          </a>

          <div class="projeto-texto">
            <p class="rotulo">
              <span class="projeto-num">0{i + 1}</span> {projeto.tipo}
            </p>
            <h3>{projeto.nome}</h3>
            <p class="projeto-descricao">{projeto.descricao}</p>
            <ul class="tecnologias">
              {projeto.tecnologias.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
            <div class="projeto-links">
              {projeto.site && (
                <a class="link-seta" href={projeto.site} target="_blank" rel="noopener">
                  Ver site <span aria-hidden="true">↗</span>
                </a>
              )}
              <a class="link-seta" href={projeto.codigo} target="_blank" rel="noopener">
                Código <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </article>
      );
    })
  }
</div>

{
  todos && outros.length > 0 && (
    <div class="estudos">
      <p class="rotulo">Estudos e faculdade</p>
      <ul>
        {outros.map((projeto) => (
          <li class="revelar">
            <a class="estudo" href={projeto.codigo} target="_blank" rel="noopener">
              <span class="estudo-nome">{projeto.nome}</span>
              <span class="estudo-descricao">{projeto.descricao}</span>
              <span class="estudo-tec">{projeto.tecnologias.join(' · ')}</span>
              <span class="estudo-seta" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .projetos {
    display: grid;
    gap: clamp(56px, 10vh, 120px);
  }

  .projeto {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    align-items: center;
    gap: clamp(28px, 5vw, 80px);
  }

  /* Um sim, um não: o print troca de lado */
  .projeto:nth-child(even) .janela {
    order: 2;
  }

  .janela {
    display: block;
    border: 1px solid var(--linha);
    border-radius: 10px;
    overflow: hidden;
    background: var(--fundo-2);
  }

  .janela-barra {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--linha);
  }

  .janela-barra i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--linha);
  }

  .janela-barra i:first-child {
    background: var(--destaque-forte);
  }

  .janela-barra span {
    margin-left: 12px;
    padding: 2px 12px;
    border-radius: 99px;
    background: var(--fundo);
    font-size: 0.7rem;
    color: var(--texto-suave);
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .janela-tela {
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .janela-tela img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .janela:hover .janela-tela img {
    transform: scale(1.04);
  }

  .projeto-num {
    color: var(--destaque);
    margin-right: 0.6rem;
  }

  .projeto h3 {
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    font-style: italic;
    margin: 0.6rem 0 1rem;
  }

  .projeto-descricao {
    color: var(--texto-suave);
    max-width: 44ch;
    margin: 0;
  }

  .tecnologias {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 1.4rem 0 1.8rem;
  }

  .tecnologias li {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--linha);
    border-radius: 99px;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    color: var(--texto-suave);
  }

  .projeto-links {
    display: flex;
    gap: 2rem;
  }

  .link-seta {
    font-size: 0.78rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    transition: color 0.3s;
  }

  .link-seta span {
    display: inline-block;
    color: var(--destaque);
    transition: translate 0.3s;
  }

  .link-seta:hover {
    color: var(--destaque);
  }

  .link-seta:hover span {
    translate: 3px -3px;
  }

  /* ---------- Estudos ---------- */
  .estudos {
    margin-top: clamp(80px, 14vh, 150px);
  }

  .estudos ul {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    border-top: 1px solid var(--linha);
  }

  .estudo {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr auto;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--linha);
    background: linear-gradient(90deg, rgb(var(--brilho) / 0.12), transparent 70%) no-repeat;
    background-size: 0% 100%;
    transition:
      background-size 0.5s,
      padding 0.4s;
  }

  .estudo:hover {
    background-size: 100% 100%;
    padding-left: 1rem;
  }

  .estudo-nome {
    font-family: var(--fonte-titulo);
    font-style: italic;
    font-size: 1.6rem;
  }

  .estudo-descricao {
    font-size: 0.9rem;
    color: var(--texto-suave);
  }

  .estudo-tec {
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  .estudo-seta {
    color: var(--destaque);
    transition: translate 0.3s;
  }

  .estudo:hover .estudo-seta {
    translate: 3px -3px;
  }

  @media (max-width: 860px) {
    .projeto {
      grid-template-columns: 1fr;
    }

    .projeto:nth-child(even) .janela {
      order: 0;
    }

    .estudo {
      grid-template-columns: 1fr auto;
      gap: 0.4rem 1rem;
    }

    .estudo-descricao,
    .estudo-tec {
      grid-column: 1;
    }

    .estudo-seta {
      grid-row: 1;
      grid-column: 2;
    }
  }
</style>
