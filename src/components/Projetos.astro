---
// Lista de projetos de programação (dados em src/data/site.ts → projetos).
//  - destaques: cartão grande com o print do site dentro de uma "janela de navegador"
//  - demais (se "todos" for true): lista simples com nome, tipo e tecnologias
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { projetos } from '../data/site';

interface Props {
  todos?: boolean;
}

const { todos = false } = Astro.props;

const prints = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projetos/*.{jpg,png,webp}', {
  eager: true,
});
const printDe = (nome?: string) =>
  nome ? Object.entries(prints).find(([caminho]) => caminho.includes(`/${nome}.`))?.[1].default : undefined;

const destaques = projetos.filter((p) => p.destaque);
const outros = projetos.filter((p) => !p.destaque);
const dominio = (link?: string) => link?.replace(/^https?:\/\//, '').replace(/\/$/, '');
---

<div class="projetos">
  {
    destaques.map((projeto, i) => {
      const print = printDe(projeto.imagem);
      return (
        <article class="projeto revelar">
          <a
            class="janela"
            href={projeto.site ?? projeto.codigo}
            target="_blank"
            rel="noopener"
            data-tilt
            aria-label={`Abrir ${projeto.nome}`}
          >
            <div class="janela-barra" aria-hidden="true">
              <span class="bolinhas">
                <i />
                <i />
                <i />
              </span>
              <span class="navegacao">
                <svg viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6" /></svg>
                <svg viewBox="0 0 24 24"><path d="M9 6l6 6-6 6" /></svg>
              </span>
              <span class="endereco">
                <svg class="cadeado" viewBox="0 0 24 24">
                  <rect x="5" y="11" width="14" height="10" rx="2" />
                  <path d="M8 11V8a4 4 0 0 1 8 0v3" />
                </svg>
                <span class="url" data-url={dominio(projeto.site ?? projeto.codigo)}>
                  {dominio(projeto.site ?? projeto.codigo)}
                </span>
                <span class="caret" />
              </span>
              <svg class="abrir" viewBox="0 0 24 24"><path d="M7 17L17 7M9 7h8v8" /></svg>
              <span class="carregando" />
            </div>
            <div class="janela-tela">
              {print && (
                <Image
                  src={print}
                  alt={`Print do site ${projeto.nome}`}
                  widths={[700, 1200]}
                  sizes="(max-width: 860px) 100vw, 55vw"
                  format="webp"
                  quality={78}
                />
              )}
              <span class="tela-dica">passe o mouse para rolar o site</span>
            </div>
          </a>

          <div class="projeto-texto">
            <p class="rotulo">
              <span class="projeto-num">0{i + 1}</span> {projeto.tipo}
            </p>
            <h3>{projeto.nome}</h3>
            <p class="projeto-descricao">{projeto.descricao}</p>
            <ul class="tecnologias">
              {projeto.tecnologias.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
            <div class="projeto-links">
              {projeto.site && (
                <a class="link-seta" href={projeto.site} target="_blank" rel="noopener">
                  Ver site <span aria-hidden="true">↗</span>
                </a>
              )}
              <a class="link-seta" href={projeto.codigo} target="_blank" rel="noopener">
                Código <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </article>
      );
    })
  }
</div>

{
  todos && outros.length > 0 && (
    <div class="estudos">
      <p class="rotulo">Estudos e faculdade</p>
      <ul>
        {outros.map((projeto) => (
          <li class="revelar">
            <a class="estudo" href={projeto.codigo} target="_blank" rel="noopener">
              <span class="estudo-nome">{projeto.nome}</span>
              <span class="estudo-descricao">{projeto.descricao}</span>
              <span class="estudo-tec">{projeto.tecnologias.join(' · ')}</span>
              <span class="estudo-seta" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}

<script>
  // Digita o endereço letra por letra quando a barra do navegador entra na tela
  const semMovimento = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!semMovimento) {
    const digitar = (el: HTMLElement) => {
      const texto = el.dataset.url ?? '';
      let i = 0;
      const passo = () => {
        el.textContent = texto.slice(0, ++i);
        if (i < texto.length) setTimeout(passo, 28 + Math.random() * 40);
      };
      setTimeout(passo, 300);
    };

    const observador = new IntersectionObserver(
      (entradas) =>
        entradas.forEach((entrada) => {
          if (!entrada.isIntersecting) return;
          observador.unobserve(entrada.target);
          const url = entrada.target.querySelector<HTMLElement>('.url');
          if (url) digitar(url);
        }),
      { threshold: 0.6 },
    );

    document.querySelectorAll<HTMLElement>('.janela .endereco').forEach((endereco) => {
      const url = endereco.querySelector<HTMLElement>('.url');
      if (url) url.textContent = '';
      observador.observe(endereco);
    });
  }
</script>

<style>
  .projetos {
    display: grid;
    gap: clamp(56px, 10vh, 120px);
  }

  .projeto {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    align-items: center;
    gap: clamp(28px, 5vw, 80px);
  }

  /* Um sim, um não: o print troca de lado */
  .projeto:nth-child(even) .janela {
    order: 2;
  }

  .janela {
    display: block;
    border: 1px solid var(--linha);
    border-radius: 10px;
    overflow: hidden;
    background: var(--fundo-2);
  }

  /* ---------- Barra de navegador ---------- */
  .janela-barra {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--linha);
    background: linear-gradient(to bottom, rgb(255 255 255 / 0.03), transparent);
  }

  .janela-barra svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .bolinhas {
    display: flex;
    gap: 6px;
  }

  .bolinhas i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--linha);
    transition: background 0.3s, transform 0.3s;
  }

  .bolinhas i:first-child {
    background: var(--destaque-forte);
  }

  .janela:hover .bolinhas i {
    background: var(--destaque);
  }

  .janela:hover .bolinhas i:nth-child(2) {
    transition-delay: 0.05s;
  }

  .janela:hover .bolinhas i:nth-child(3) {
    transition-delay: 0.1s;
  }

  .navegacao {
    display: flex;
    gap: 4px;
    color: var(--texto-suave);
  }

  .navegacao svg {
    width: 15px;
    height: 15px;
  }

  .navegacao svg:last-child {
    opacity: 0.4;
  }

  .endereco {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    border: 1px solid var(--linha);
    border-radius: 99px;
    background: var(--fundo);
    font-size: 0.72rem;
    color: var(--texto-suave);
    transition: border-color 0.4s, box-shadow 0.4s;
  }

  .janela:hover .endereco {
    border-color: var(--destaque-forte);
    box-shadow: 0 0 0 3px rgb(var(--brilho) / 0.25);
  }

  .cadeado {
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    color: var(--destaque);
  }

  .url {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--texto);
  }

  /* Cursor de texto piscando depois da URL */
  .caret {
    flex-shrink: 0;
    width: 1px;
    height: 12px;
    background: var(--destaque);
    animation: piscar 1s steps(1) infinite;
  }

  .abrir {
    flex-shrink: 0;
    width: 16px;
    height: 16px;
    color: var(--texto-suave);
    transition: color 0.3s, translate 0.3s;
  }

  .janela:hover .abrir {
    color: var(--destaque);
    translate: 2px -2px;
  }

  /* Linha de "carregando a página" que corre no hover */
  .carregando {
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 2px;
    width: 100%;
    background: linear-gradient(90deg, transparent, var(--destaque), transparent);
    transform: scaleX(0);
    transform-origin: left;
    opacity: 0;
  }

  .janela:hover .carregando {
    animation: carregar 1.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  /* ---------- Tela: o site rola sozinho no hover ---------- */
  .janela-tela {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .janela-tela img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0%;
    transition: object-position 1.2s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .janela:hover .janela-tela img {
    object-position: 50% 100%;
    transition-duration: 7s;
  }

  .tela-dica {
    position: absolute;
    right: 12px;
    bottom: 12px;
    padding: 6px 12px;
    border-radius: 99px;
    background: rgb(0 0 0 / 0.65);
    backdrop-filter: blur(6px);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: #fff;
    transition: opacity 0.4s, translate 0.4s;
  }

  .janela:hover .tela-dica {
    opacity: 0;
    translate: 0 8px;
  }

  @media (hover: none) {
    .tela-dica {
      display: none;
    }
  }

  @keyframes piscar {
    50% {
      opacity: 0;
    }
  }

  @keyframes carregar {
    0% {
      opacity: 1;
      transform: scaleX(0);
    }
    80% {
      opacity: 1;
      transform: scaleX(1);
    }
    100% {
      opacity: 0;
      transform: scaleX(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .janela-tela img,
    .janela:hover .janela-tela img {
      transition: none;
      object-position: 50% 0%;
    }

    .caret,
    .janela:hover .carregando {
      animation: none;
    }
  }

  .projeto-num {
    color: var(--destaque);
    margin-right: 0.6rem;
  }

  .projeto h3 {
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    font-style: italic;
    margin: 0.6rem 0 1rem;
  }

  .projeto-descricao {
    color: var(--texto-suave);
    max-width: 44ch;
    margin: 0;
  }

  .tecnologias {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 1.4rem 0 1.8rem;
  }

  .tecnologias li {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--linha);
    border-radius: 99px;
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    color: var(--texto-suave);
  }

  .projeto-links {
    display: flex;
    gap: 2rem;
  }

  .link-seta {
    font-size: 0.78rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    transition: color 0.3s;
  }

  .link-seta span {
    display: inline-block;
    color: var(--destaque);
    transition: translate 0.3s;
  }

  .link-seta:hover {
    color: var(--destaque);
  }

  .link-seta:hover span {
    translate: 3px -3px;
  }

  /* ---------- Estudos ---------- */
  .estudos {
    margin-top: clamp(80px, 14vh, 150px);
  }

  .estudos ul {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    border-top: 1px solid var(--linha);
  }

  .estudo {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr auto;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.6rem 0;
    border-bottom: 1px solid var(--linha);
    background: linear-gradient(90deg, rgb(var(--brilho) / 0.12), transparent 70%) no-repeat;
    background-size: 0% 100%;
    transition:
      background-size 0.5s,
      padding 0.4s;
  }

  .estudo:hover {
    background-size: 100% 100%;
    padding-left: 1rem;
  }

  .estudo-nome {
    font-family: var(--fonte-titulo);
    font-style: italic;
    font-size: 1.6rem;
  }

  .estudo-descricao {
    font-size: 0.9rem;
    color: var(--texto-suave);
  }

  .estudo-tec {
    font-size: 0.72rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  .estudo-seta {
    color: var(--destaque);
    transition: translate 0.3s;
  }

  .estudo:hover .estudo-seta {
    translate: 3px -3px;
  }

  @media (max-width: 860px) {
    .projeto {
      grid-template-columns: 1fr;
    }

    .projeto:nth-child(even) .janela {
      order: 0;
    }

    .estudo {
      grid-template-columns: 1fr auto;
      gap: 0.4rem 1rem;
    }

    .estudo-descricao,
    .estudo-tec {
      grid-column: 1;
    }

    .estudo-seta {
      grid-row: 1;
      grid-column: 2;
    }
  }
</style>
