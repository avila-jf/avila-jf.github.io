---
// Mergulho no cartão (a técnica do "About me" do portfólio do @echo_builds, reescrita aqui), usado
// nas duas páginas. Tela travada:
//  - fundo: a paisagem em gravura (o "Noite Estrelada" dele, na nossa tinta), ou qualquer coisa no
//    slot "fundo" (no Sobre mim: a página de mangá, comum/PaginaManga), que vai se apagando até o
//    azul-tinta;
//  - um cartão de 300 × 400 com borda fina, no meio, com a foto DESFOCADA (uma cópia borrada por
//    cima que some: a foto "entra em foco" sem refazer o filtro a cada quadro);
//  - o título em duas partes em cima do cartão: a 1ª palavra sai para a esquerda e o resto para a
//    direita, sumindo; o rótulo e o "scroll to open" saem junto;
//  - o cartão cresce até um painel largo (no formato da foto, 94% da largura ou 86% da altura);
//  - no fim, o conteúdo aparece NAS BORDAS do painel (slot "topo" em cima, o slot normal embaixo),
//    com o meio livre para a foto.
// Sem JS ou com "reduzir movimento": o painel aberto, parado. Precisa do Gravura.astro na página.
import { Image } from 'astro:assets';
import type { Foto } from '../../lib/fotos';

interface Props {
  fundo?: Foto; // a paisagem em gravura
  foto?: Foto; // a foto do cartão / painel
  titulo: [string, string]; // ["Sobre", "mim"]: a 1ª parte sai para a esquerda, a 2ª para a direita
  rotulo?: string; // em cima do título ("Por trás das lentes")
  id?: string;
  lente?: 'foto' | 'codigo' | 'ambos';
}

const { fundo, foto, titulo, rotulo, id, lente = 'ambos' } = Astro.props;
const proporcao = foto ? foto.src.width / foto.src.height : 16 / 9;
---

<section class="mergulho" id={id} data-trava data-lente={lente} data-tema="tinta" data-proporcao={Math.max(1.5, proporcao).toFixed(3)} aria-label={titulo.join(' ')}>
  <div class="m-palco">
    {
      Astro.slots.has('fundo') ? (
        <div class="m-fundo m-fundo-livre" aria-hidden="true">
          <slot name="fundo" />
        </div>
      ) : (
        fundo && (
          <div class="m-fundo" aria-hidden="true">
            <Image src={fundo.src} alt="" widths={[800, 1400, 2000]} sizes="100vw" format="webp" quality={70} loading="lazy" />
          </div>
        )
      )
    }

    <div class="m-card">
      {
        foto && (
          <>
            <Image class="m-foto" src={foto.src} alt={foto.alt} widths={[480, 900, 1600, 2200]} sizes="94vw" format="webp" loading="lazy" />
            <Image class="m-foto m-borrada" src={foto.src} alt="" widths={[480]} sizes="300px" format="webp" loading="lazy" aria-hidden="true" />
          </>
        )
      }
      <span class="m-veu" aria-hidden="true"></span>
      <div class="m-conteudo">
        <div class="m-borda-topo"><slot name="topo" /></div>
        <div class="m-borda-baixo"><slot /></div>
      </div>
    </div>

    {
      Astro.slots.has('cartao') && (
        <div class="m-cartao">
          <slot name="cartao" />
        </div>
      )
    }

    <div class="m-titulo" aria-hidden="true" data-com-cartao={Astro.slots.has('cartao') ? '' : undefined}>
      {rotulo && <p class="m-rotulo rotulo">{rotulo}</p>}
      <b class="m-parte m-parte-1 titulo-cartaz">{titulo[0]}</b>
      <b class="m-parte m-parte-2 titulo-cartaz">{titulo[1]}</b>
      <p class="m-role rotulo">scroll to open</p>
    </div>
  </div>
</section>

<style>
  .mergulho {
    margin: 0 calc(var(--margem) * -1) 120px;
  }
  .m-palco {
    position: relative;
    height: 100svh;
    overflow: hidden;
    background: #0c1530;
    color: var(--creme);
  }
  .m-fundo {
    position: absolute;
    inset: 0;
    contain: paint; /* o filtro de gravura é pesado: desenha uma vez e só some a camada */
    will-change: opacity;
  }
  .m-fundo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.25) url(#gravura-novo);
  }
  @media (max-width: 760px), (pointer: coarse) {
    .m-fundo img {
      filter: grayscale(1) contrast(1.4) sepia(0.25) hue-rotate(180deg);
    }
  }
  .m-fundo:not(.m-fundo-livre)::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(118deg, rgb(20 45 120 / 0.3) 0 1px, transparent 1px 3.5px),
      repeating-linear-gradient(28deg, rgb(20 45 120 / 0.12) 0 1px, transparent 1px 5px),
      rgb(12 21 48 / 0.25);
    mix-blend-mode: multiply;
  }

  /* o cartão (sem JS: já aberto, no formato largo) */
  .m-card {
    position: absolute;
    left: 50%;
    top: 50%;
    width: min(94vw, 86svh * 1.875);
    aspect-ratio: 1.875;
    max-height: 86svh;
    overflow: hidden;
    border: 1px solid rgb(241 230 204 / 0.12);
    border-radius: 18px;
    background: #07090e;
    box-shadow: 0 25px 60px -15px rgb(0 0 0 / 0.9);
    translate: -50% -50%;
  }
  .m-foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .m-borrada {
    filter: blur(18px);
    scale: 1.08;
    opacity: 0;
    will-change: opacity;
  }
  /* protege o texto em cima e embaixo e deixa o meio limpo */
  .m-veu {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(7 9 14 / 0.75), transparent 35%, transparent 55%, rgb(7 9 14 / 0.88));
  }
  .m-conteudo {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(18px, 2.6vw, 36px);
  }
  .m-borda-topo {
    padding-bottom: 12px;
    border-bottom: 1px solid rgb(241 230 204 / 0.12);
  }
  .m-borda-baixo {
    padding-top: 14px;
    border-top: 1px solid rgb(241 230 204 / 0.12);
  }

  /* o título em duas partes, em cima do cartão fechado */
  /* o cartão fechado próprio (slot "cartao"): no tamanho do cartão inicial, por cima dele */
  .m-cartao {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 3;
    width: 300px;
    height: 400px;
    translate: -50% -50%;
    will-change: transform, opacity;
  }
  /* com o cartão próprio, o título gigante não aparece (o cartão já tem o nome) */
  .m-titulo[data-com-cartao] .m-parte,
  .m-titulo[data-com-cartao] .m-rotulo,
  .m-titulo[data-com-cartao] .m-role {
    display: none;
  }
  @media (max-width: 760px) {
    .m-cartao {
      width: 270px;
      height: 360px;
    }
  }
  .m-titulo {
    position: absolute;
    inset: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    text-align: center;
    pointer-events: none;
  }
  :global(.mergulho.ativo) .m-titulo {
    display: flex;
  }
  .m-parte {
    font-size: clamp(56px, 8vw, 120px);
    color: #fff;
    text-shadow: 0 10px 40px rgb(0 0 0 / 0.55);
    will-change: transform, opacity;
  }
  .m-rotulo,
  .m-role {
    margin: 0;
    color: rgb(241 230 204 / 0.85);
    will-change: transform, opacity;
  }
  .m-rotulo {
    font-size: 13px;
  }
</style>

<script>
  import { gsap, semMovimento, celular, prioridade } from '../../lib/movimento';

  document.querySelectorAll<HTMLElement>('.mergulho').forEach((raiz) => {
    if (semMovimento) return;
    raiz.classList.add('ativo');
    const $ = (s: string) => raiz.querySelector<HTMLElement>(s);
    const card = $('.m-card')!;
    const fundo = $('.m-fundo');
    const borrada = $('.m-borrada');
    const conteudo = $('.m-conteudo')!;
    const parte1 = $('.m-parte-1')!;
    const parte2 = $('.m-parte-2')!;
    const extras = [$('.m-rotulo'), $('.m-role')].filter(Boolean) as HTMLElement[];
    const cartao = $('.m-cartao');
    const proporcao = Number(raiz.dataset.proporcao) || 1.875;

    // o cartão não muda de tamanho (layout): fica sempre no tamanho aberto e o clip-path recorta;
    // a borda é desenhada por um contorno que acompanha o recorte
    card.style.width = '100vw';
    card.style.height = '100svh';
    card.style.maxHeight = 'none';
    card.style.aspectRatio = 'auto';
    card.style.border = '0';
    card.style.borderRadius = '0';
    card.style.boxShadow = 'none';
    const contorno = document.createElement('span');
    contorno.setAttribute('aria-hidden', 'true');
    Object.assign(contorno.style, {
      position: 'absolute',
      left: '50%',
      top: '50%',
      borderRadius: '18px',
      border: '1px solid rgba(241,230,204,.35)',
      boxShadow: '0 25px 60px -15px rgba(0,0,0,.9)',
      pointerEvents: 'none',
      willChange: 'transform',
    });
    card.after(contorno);

    const quadro = (p: number) => {
      const L = innerWidth;
      const A = innerHeight;
      const w0 = celular ? 280 : 300;
      const h0 = celular ? 360 : 400;
      // no celular o painel abre em pé (a foto largo deixava ~245px de altura e o texto e os botões
      // não cabiam); no computador, no formato da foto
      const w1 = celular ? L * 0.92 : Math.min(L * 0.94, A * 0.86 * proporcao);
      const h1 = celular ? Math.min(A * 0.76, 640) : w1 / proporcao;
      const w = w0 + (w1 - w0) * p;
      const h = h0 + (h1 - h0) * p;
      const x = (L - w) / 2;
      const y = (A - h) / 2;
      card.style.clipPath = `inset(${y.toFixed(1)}px ${x.toFixed(1)}px ${y.toFixed(1)}px ${x.toFixed(1)}px round 18px)`;
      // o conteúdo fica dentro do retângulo visível
      conteudo.style.inset = `${y.toFixed(1)}px ${x.toFixed(1)}px`;
      contorno.style.width = `${w.toFixed(1)}px`;
      contorno.style.height = `${h.toFixed(1)}px`;
      contorno.style.transform = 'translate(-50%, -50%)';
      contorno.style.borderColor = `rgba(241,230,204,${(0.1 + (1 - p) * 0.25).toFixed(2)})`;

      if (fundo) fundo.style.opacity = Math.max(0, 1 - p * 1.3).toFixed(3);
      if (borrada) borrada.style.opacity = Math.max(0, 1 - p * 2.3).toFixed(3);

      // o título se divide: a 1ª parte para a esquerda, a 2ª para a direita
      const sai = (p * (celular ? 180 : 150)).toFixed(1);
      const opTitulo = Math.max(0, 1 - p * 1.6).toFixed(3);
      parte1.style.transform = `translateX(-${sai}vw)`;
      parte2.style.transform = `translateX(${sai}vw)`;
      parte1.style.opacity = parte2.style.opacity = opTitulo;
      // o cartão próprio sai da frente logo no começo: sobe, cresce um pouco e some
      if (cartao) {
        const c0 = gsap.utils.clamp(0, 1, p / 0.32);
        cartao.style.opacity = (1 - c0).toFixed(3);
        cartao.style.transform = `translateY(${(-c0 * 18).toFixed(1)}vh) scale(${(1 + c0 * 0.15).toFixed(3)})`;
        cartao.style.visibility = c0 >= 1 ? 'hidden' : 'visible';
      }
      const opExtra = Math.max(0, 1 - p * 2.8).toFixed(3);
      extras.forEach((el, i) => {
        el.style.transform = `translateX(${i === 0 ? '-' : ''}${sai}vw)`;
        el.style.opacity = opExtra;
      });

      // o conteúdo aparece quando o painel termina de abrir
      const c = gsap.utils.clamp(0, 1, (p - 0.85) / 0.15);
      conteudo.style.opacity = c.toFixed(3);
      conteudo.style.transform = `translateY(${((1 - c) * 12).toFixed(1)}px)`;
      conteudo.style.pointerEvents = c > 0.5 ? 'auto' : 'none';
    };

    const estado = { p: 0 };
    quadro(0);
    gsap.to(estado, {
      p: 1,
      ease: 'none',
      onUpdate: () => quadro(estado.p),
      scrollTrigger: {
        trigger: raiz,
        start: 'top top',
        end: '+=110%',
        pin: $('.m-palco'),
        scrub: 0.5,
        refreshPriority: prioridade(raiz),
        onRefresh: () => quadro(estado.p),
      },
    });
  });
</script>
