---
// Faixa curva (pegada do "Featured project / Landing pages" do @echo_builds), usada nas duas
// páginas: a tela trava e os cartões passam de lado como numa tela de cinema curva. O do meio fica
// reto, de frente; os das pontas DOBRAM vindo na nossa direção, como papel. O nome do cartão do
// meio aparece embaixo. Correndo, a curva fica mais funda.
//
// Como dobra: cada cartão vira FATIAS tiras finas, cada uma com uma cópia do cartão inteiro
// deslocada. A borda esquerda de cada tira fica em cima da curva e ela gira até a borda direita
// cair na curva também: as vizinhas se encostam em 3D, sem fresta. As posições são calculadas
// (sem medir a página a cada quadro). No celular: sem dobra, só a faixa passando de lado.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id?: string;
  rotulo: string;
  tema?: 'claro' | 'tinta' | 'azul';
  lente?: 'foto' | 'codigo' | 'ambos';
  formato?: 'tela' | 'retrato'; // tela = print 16:10 (sites); retrato = foto 4:5 (ensaios)
  fecha?: boolean; // no fim, a faixa gira e encolhe pro centro: a ponte pro hexágono que vem depois
  itens: { titulo: string; subtitulo: string; href?: string; fora?: boolean; imagem?: ImageMetadata; posicao?: string }[];
}

const { id, rotulo, tema = 'claro', lente = 'ambos', formato = 'tela', fecha = false, itens } = Astro.props;
---

<section class="ato faixa-curva" id={id} data-trava data-lente={lente} data-tema={tema} data-formato={formato} data-fecha={fecha ? '' : undefined}>
  <div class="fc-palco">
    <p class="ato-id rotulo">{rotulo}</p>
    <div class="fc-trilho">
      {
        itens.map((it) => (
          <a
            class="fc-card"
            href={it.href}
            target={it.fora ? '_blank' : undefined}
            rel={it.fora ? 'noopener' : undefined}
            data-titulo={it.titulo}
            data-subtitulo={it.subtitulo}
          >
            {it.imagem && (
              <Image
                src={it.imagem}
                alt={it.titulo}
                widths={[480, 900, 1400]}
                sizes="(max-width: 760px) 80vw, 56vw"
                format="webp"
                style={it.posicao ? `object-position:${it.posicao}` : undefined}
              />
            )}
          </a>
        ))
      }
    </div>
    <p class="fc-legenda" aria-live="polite">
      <b class="titulo-cartaz">{itens[0]?.titulo}</b>
      <span class="rotulo">{itens[0]?.subtitulo}</span>
    </p>
  </div>
</section>

<style>
  /* a faixa que vira a grade de projetos: sem espaço até a seção de baixo */
  .faixa-curva[data-fecha] {
    margin-bottom: 0;
  }
  .faixa-curva {
    margin-left: calc(var(--margem) * -1);
    margin-right: calc(var(--margem) * -1);
  }
  .fc-palco {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 22px;
    min-height: 100svh;
    padding: 96px 0 34px;
    overflow: hidden;
    perspective: 1400px;
  }
  .fc-palco > .ato-id {
    margin: 0;
    padding: 0 var(--margem);
  }
  .fc-trilho {
    display: flex;
    gap: clamp(16px, 2.4vw, 40px);
    /* o primeiro e o último cartão conseguem chegar ao meio da tela */
    padding: 0 calc(50vw - var(--largura) / 2);
    overflow-x: auto; /* sem JS: arrasta com o dedo */
    scrollbar-width: none;
    transform-style: preserve-3d;
    will-change: transform;
    --largura: min(50vw, 100svh, 820px); /* o cartão 16:10 cabe na altura da tela com a legenda */
  }
  [data-formato='retrato'] .fc-trilho {
    --largura: min(36vw, 520px);
  }
  .fc-trilho::-webkit-scrollbar {
    display: none;
  }
  .fc-card {
    position: relative;
    flex: none;
    display: block;
    width: var(--largura);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 18px;
    background: var(--fundo-2);
    transform-style: preserve-3d;
  }
  [data-formato='retrato'] .fc-card {
    aspect-ratio: 4 / 5;
    max-height: 62svh;
    width: auto;
    height: min(62svh, calc(var(--largura) * 1.25));
  }
  .fc-card img,
  .fc-card :global(.fc-fatia-conteudo img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }
  [data-formato='retrato'] .fc-card img,
  [data-formato='retrato'] .fc-card :global(.fc-fatia-conteudo img) {
    object-position: center;
  }
  /* com a dobra ligada o cartão some como caixa e quem aparece são as tiras */
  .fc-card:global(.dobravel) {
    overflow: visible;
    border-radius: 0;
    background: none;
  }
  .fc-card :global(.fc-fatia) {
    position: absolute;
    top: 0;
    bottom: 0;
    overflow: hidden;
    transform-origin: 0 50%;
    backface-visibility: hidden;
    will-change: transform;
  }
  .fc-card :global(.fc-fatia:first-child) {
    border-radius: 18px 0 0 18px;
  }
  .fc-card :global(.fc-fatia:last-child) {
    border-radius: 0 18px 18px 0;
  }
  .fc-card :global(.fc-fatia-conteudo) {
    position: absolute;
    top: 0;
    bottom: 0;
  }

  /* com WebGL, quem desenha os cartões é o canvas; os links continuam no lugar, invisíveis */
  .fc-palco:global(.com-gl) .fc-card {
    opacity: 0;
  }
  .fc-palco :global(.faixa-gl) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .fc-legenda {
    display: grid;
    justify-items: center;
    gap: 6px;
    margin: 0;
    text-align: center;
  }
  .fc-legenda b {
    font-size: clamp(28px, 3vw, 48px);
  }
  @media (max-width: 760px) {
    .fc-trilho {
      --largura: 80vw;
    }
    [data-formato='retrato'] .fc-trilho {
      --largura: 64vw;
    }
    .fc-legenda {
      padding: 0 var(--margem);
    }
  }
</style>

<script>
  import { gsap, semMovimento, celular, prioridade, remedir } from '../../lib/movimento';
  import { faixaQueCurva } from '../../lib/lenteGL';

  const FATIAS = 16;

  document.querySelectorAll<HTMLElement>('.faixa-curva').forEach(async (secao) => {
    if (semMovimento) return;
    const palco = secao.querySelector<HTMLElement>('.fc-palco')!;
    const trilho = secao.querySelector<HTMLElement>('.fc-trilho')!;
    const cards = [...trilho.querySelectorAll<HTMLElement>('.fc-card')];
    const legenda = secao.querySelector<HTMLElement>('.fc-legenda')!;
    const fecha = secao.hasAttribute('data-fecha');
    trilho.style.overflow = 'visible';
    const distancia = () => Math.max(0, trilho.scrollWidth - trilho.clientWidth);

    // 1º tenta a curva em WebGL (a imagem curva de verdade); sem WebGL, volta pras tiras em CSS
    const gl = await faixaQueCurva(palco, cards, celular);

    // corta cada cartão em tiras (só no computador e só sem WebGL)
    const fatiasDe = celular || gl
      ? []
      : cards.map((c) => {
          const conteudo = c.innerHTML;
          c.setAttribute('aria-label', c.dataset.titulo ?? '');
          c.classList.add('dobravel');
          c.innerHTML = '';
          return Array.from({ length: FATIAS }, (_, k) => {
            const f = document.createElement('span');
            f.className = 'fc-fatia';
            f.setAttribute('aria-hidden', 'true');
            f.style.left = `${(k / FATIAS) * 100}%`;
            f.style.width = `calc(${100 / FATIAS}% + 2px)`; // 2px a mais: sem fresta entre as tiras
            f.innerHTML = `<span class="fc-fatia-conteudo" style="left:${-k * 100}%;width:${FATIAS * 100}%">${conteudo}</span>`;
            c.append(f);
            return f;
          });
        });

    let medidas: { esquerda: number; largura: number }[] = [];
    const medir = () => (medidas = cards.map((c) => ({ esquerda: c.offsetLeft, largura: c.offsetWidth })));
    medir();

    // a curva: reta no meio (20% da tela) e subindo para a frente nas pontas, como tela de cinema
    let fundura = 0;
    let atual = -1;
    const fechando = { v: 0 };
    const curvar = (velocidade: number) => {
      const x = gsap.getProperty(trilho, 'x') as number;
      gl?.atualizar(x, velocidade, fechando.v);
      if (gl && fecha) legenda.style.opacity = String(1 - Math.min(1, fechando.v * 2));
      const meio = innerWidth / 2;
      fundura += (gsap.utils.clamp(0, 160, Math.abs(velocidade) / 16) - fundura) * 0.15;
      const A = 460 + fundura;
      const z = (px: number) => {
        const d = Math.max(0, Math.abs(px / meio) - 0.2);
        return A * d * d;
      };

      let maisPerto = 0;
      let menor = Infinity;
      cards.forEach((_, i) => {
        const { esquerda, largura } = medidas[i];
        const centro = esquerda + x + largura / 2 - meio;
        if (Math.abs(centro) < menor) {
          menor = Math.abs(centro);
          maisPerto = i;
        }
        const fatias = fatiasDe[i];
        if (!fatias) return;
        const lf = largura / FATIAS;
        fatias.forEach((f, j) => {
          const x0 = esquerda + x + j * lf - meio;
          const z0 = z(x0);
          const dz = z(x0 + lf) - z0;
          const ang = (Math.atan2(dz, lf) * 180) / Math.PI;
          f.style.transform = `translateZ(${z0.toFixed(1)}px) rotateY(${(-ang).toFixed(2)}deg) scaleX(${(Math.hypot(lf, dz) / lf).toFixed(3)})`;
        });
      });

      if (maisPerto !== atual) {
        atual = maisPerto;
        legenda.querySelector('b')!.textContent = cards[atual].dataset.titulo ?? '';
        legenda.querySelector('span')!.textContent = cards[atual].dataset.subtitulo ?? '';
      }
    };

    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: {
        trigger: secao,
        start: 'top top',
        end: () => `+=${distancia() * (gl && fecha ? 1.35 : 1)}`,
        pin: secao.querySelector('.fc-palco'),
        scrub: 0.6,
        invalidateOnRefresh: true,
        refreshPriority: prioridade(secao),
        onRefresh: () => { medir(); gl?.medir(); },
      },
      onUpdate: () => curvar(tl.scrollTrigger?.getVelocity() ?? 0),
    });
    tl.to(trilho, { x: () => -distancia(), duration: 1 });
    // a ponte pro hexágono: a faixa gira e encolhe pro centro (só com WebGL)
    if (gl && fecha) tl.to(fechando, { v: 1, duration: 0.35 });
    curvar(0);
    remedir(); // a trava foi criada depois de carregar as fotos: reordena as medidas da página
  });
</script>
