---
// Barra do topo do site novo (inspirada no foldfolio: mínima, com controle em pílula).
//  - Esquerda: nome em tipografia cartaz
//  - Centro: Sites | Fotos, as duas páginas (home = sites, /fotografia = fotos). A pílula marca a
//    lente da seção na tela (lê data-lente do <html>, que o Fundo.astro atualiza). Ir para a outra
//    página passa pelo flash da câmera (data-flash, lib/flash.ts). No celular esse controle desce
//    para o rodapé da tela.
//  - Direita: "Sobre" (abre o Sobre.astro), "Agenda aberta" e o botão principal, que é o de pedir site (o foco do negócio)
// Ao rolar, a barra encolhe numa cápsula de vidro.
import { site, criacaoDeSites } from '../../data/site';
import { url } from '../../lib/url';

const linkSite = `https://wa.me/${site.contato.whatsapp}?text=${encodeURIComponent(criacaoDeSites.mensagemWhatsApp)}`;
---

<header class="barra">
  <div class="barra-ilha">
    <a class="barra-logo" href="#topo" aria-label={`${site.nome}, início`}>
      <span class="titulo-cartaz">{site.nome}</span><sup>®</sup>
    </a>

    <nav class="barra-lentes" aria-label="Seções">
      <span class="barra-pilula" aria-hidden="true"></span>
      <a href={url('/')} class="lente-sites voz-codigo" data-flash>Sites</a>
      <a href={url('/fotografia')} class="lente-fotos voz-foto" data-flash>Fotos</a>
    </nav>

    <div class="barra-direita">
      <button class="barra-sobre" type="button" data-abrir-sobre>Sobre</button>
      <span class="barra-status rotulo"><i aria-hidden="true"></i>Agenda aberta</span>
      <a class="barra-cta" href={linkSite} target="_blank" rel="noopener">
        Quero meu site <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</header>

<style>
  .barra {
    /* a barra é sempre clara: não herda os tons escuros das seções */
    --texto: #0c1530;
    --texto-suave: #5d6479;
    --linha: rgb(12 21 48 / 0.1);
    --azul: #2346a8;
    --vidro: rgb(247 245 240 / 0.86);
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: flex;
    justify-content: center;
    padding: 14px var(--margem);
    pointer-events: none;
  }
  .barra-ilha {
    pointer-events: auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    width: 100%;
    max-width: 100%;
    padding: 8px 8px 8px 18px;
    border: 1px solid var(--linha);
    border-radius: 999px;
    /* já começa em vidro: fica por cima do mural de fotos azul */
    background: rgb(247 245 240 / 0.86);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    transition:
      max-width 0.7s cubic-bezier(0.7, 0, 0.2, 1),
      background-color 0.5s,
      border-color 0.5s;
  }
  /* depois de rolar: vira cápsula de vidro */
  :global(html.rolou) .barra-ilha {
    max-width: 920px;
    background: var(--vidro);
    box-shadow: 0 10px 40px -18px rgb(12 21 48 / 0.25);
    border-color: var(--linha);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
  }

  .barra-logo {
    justify-self: start;
    display: flex;
    align-items: flex-start;
    color: var(--texto);
    text-decoration: none;
    white-space: nowrap;
  }
  .barra-logo .titulo-cartaz {
    font-size: 22px;
    line-height: 1;
  }
  .barra-logo sup {
    font-size: 10px;
    margin-left: 2px;
  }

  /* Controle Sites | Fotos */
  .barra-lentes {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 4px;
    border: 1px solid var(--linha);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.5);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }
  .barra-lentes a {
    position: relative;
    z-index: 1;
    padding: 7px 20px;
    border-radius: 999px;
    color: var(--texto-suave);
    text-align: center;
    text-decoration: none;
    font-size: 15px;
    transition: color 0.4s;
  }
  .barra-lentes .voz-codigo {
    font-size: 13px;
  }
  .barra-lentes a:hover {
    color: var(--texto);
  }
  .barra-pilula {
    position: absolute;
    inset: 4px auto 4px 4px;
    width: calc(50% - 4px);
    border-radius: 999px;
    background: var(--texto);
    transition: transform 0.6s cubic-bezier(0.7, 0, 0.2, 1);
  }
  :global(html[data-lente='foto']) .barra-pilula {
    transform: translateX(100%);
  }
  :global(html:not([data-lente='foto'])) .lente-sites,
  :global(html[data-lente='foto']) .lente-fotos {
    color: var(--fundo);
  }

  .barra-direita {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .barra-sobre {
    padding: 8px 4px;
    border: 0;
    background: none;
    color: var(--texto);
    font: 600 14px/1 var(--fonte);
    cursor: pointer;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0 1.5px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .barra-sobre:hover {
    background-size: 100% 1.5px;
  }
  .barra-status {
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }
  .barra-status i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--azul);
    box-shadow: 0 0 0 0 rgb(35 70 168 / 0.5);
    animation: pulso 2.2s infinite;
  }
  @keyframes pulso {
    70% { box-shadow: 0 0 0 8px rgb(35 70 168 / 0); }
    100% { box-shadow: 0 0 0 0 rgb(35 70 168 / 0); }
  }
  .barra-cta {
    display: inline-flex;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--texto);
    color: var(--fundo);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.3s;
  }
  .barra-cta:hover {
    background: var(--azul);
  }
  .barra-cta span {
    transition: transform 0.3s;
  }
  .barra-cta:hover span {
    transform: translate(2px, -2px);
  }

  @media (max-width: 900px) {
    .barra-status {
      display: none;
    }
  }
  /* Celular: o controle Sites | Fotos vira uma pílula flutuante embaixo, perto do polegar */
  @media (max-width: 640px) {
    .barra-ilha {
      grid-template-columns: 1fr auto;
      padding-left: 14px;
      background: rgb(247 245 240 / 0.92);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    /* sem backdrop-filter aqui: ele prenderia a pílula fixa de baixo dentro da barra */
    :global(html.rolou) .barra-ilha {
      background: rgb(247 245 240 / 0.92);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    .barra-logo .titulo-cartaz {
      font-size: 19px;
    }
    .barra-cta {
      padding: 9px 14px;
      font-size: 13px;
    }
    .barra-lentes {
      position: fixed;
      left: 50%;
      bottom: max(16px, env(safe-area-inset-bottom));
      transform: translateX(-50%);
      background: rgb(255 255 255 / 0.8);
    }
  }
</style>

<script>
  // Encolhe a barra depois de rolar um pouco
  const raiz = document.documentElement;
  const marcar = () => raiz.classList.toggle('rolou', scrollY > 40);
  addEventListener('scroll', marcar, { passive: true });
  marcar();
</script>
